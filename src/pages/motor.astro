  margin-top: 4px;

  color: var(--m-white);

  font-family: var(--font-display);
  font-size: .72rem;
  font-weight: 900;

}

.owned-finance {

  display: flex;

  align-items: flex-end;
  justify-content: space-between;

  gap: 12px;

  margin-top: 14px;

  padding-top: 12px;

  border-top: 1px solid var(--m-line);

}

.owned-finance > div {

  display: flex;
  flex-direction: column;

  gap: 4px;

}

.owned-finance span {

  color: var(--m-dim);

  font-family: var(--font-display);
  font-size: .39rem;
  font-weight: 900;

}

.owned-finance strong {

  color: var(--m-white);

  font-family: var(--font-display);
  font-size: .9rem;
  font-weight: 900;

}

.owned-score {

  text-align: right;

}

.owned-score strong {

  color: var(--m-accent);

  font-size: 1.05rem;

}

.owned-actions {

  display: grid;

  grid-template-columns:
    1fr
    1fr;

  gap: 6px;

  padding: 0 10px 10px;

}

.owned-action {

  min-height: 38px;

  display: grid;

  grid-template-columns:
    18px
    1fr
    14px;

  align-items: center;

  gap: 7px;

  padding: 0 9px;

  border: 2px solid var(--m-line);

  color: var(--m-muted);

  background: var(--m-black-2);

  font-family: var(--font-display);
  font-size: .4rem;
  font-weight: 900;

  text-decoration: none;

}

.owned-action:hover {

  color: var(--m-accent);

  border-color: var(--m-accent-dark);

}

.owned-action--primary {

  color: var(--m-accent);

  border-color: var(--m-accent-dark);

}

.action-icon {

  color: currentColor;

}


/* =============================================================
   EMPTY SLOT
   ============================================================= */

.empty-slot-card {

  min-width: 0;

  min-height: 500px;

  display: flex;
  flex-direction: column;

  overflow: hidden;

  border: 2px dashed var(--m-line-light);

  background: var(--m-panel);

}

.empty-slot-top {

  min-height: 32px;

  display: flex;
  align-items: center;
  justify-content: space-between;

  padding: 0 10px;

  color: var(--m-dim);

  background: var(--m-black-2);

  border-bottom: 2px solid var(--m-line);

  font-family: var(--font-display);
  font-size: .4rem;
  font-weight: 900;

}

.empty-slot-top > div {

  display: flex;
  align-items: center;

  gap: 7px;

}

.empty-slot-index {

  color: var(--m-accent);

}

.empty-slot-art {

  min-height: 255px;

  position: relative;

  display: grid;

  place-items: center;

  overflow: hidden;

  background: #141614;

}

.empty-slot-grid {

  position: absolute;

  inset: 0;

  opacity: .45;

  background-image:
    linear-gradient(
      rgba(255,255,255,.03) 1px,
      transparent 1px
    ),
    linear-gradient(
      90deg,
      rgba(255,255,255,.03) 1px,
      transparent 1px
    );

  background-size: 22px 22px;

}

.empty-slot-frame {

  width: 130px;
  height: 130px;

  position: relative;

  display: grid;
  place-items: center;

  border: 1px dashed var(--m-line-light);

}

.empty-corner {

  position: absolute;

  width: 16px;
  height: 16px;

}

.empty-corner--tl {

  left: -1px;
  top: -1px;

  border-top: 2px solid var(--m-accent-dark);
  border-left: 2px solid var(--m-accent-dark);

}

.empty-corner--tr {

  right: -1px;
  top: -1px;

  border-top: 2px solid var(--m-accent-dark);
  border-right: 2px solid var(--m-accent-dark);

}

.empty-corner--bl {

  left: -1px;
  bottom: -1px;

  border-bottom: 2px solid var(--m-accent-dark);
  border-left: 2px solid var(--m-accent-dark);

}

.empty-corner--br {

  right: -1px;
  bottom: -1px;

  border-right: 2px solid var(--m-accent-dark);
  border-bottom: 2px solid var(--m-accent-dark);

}

.empty-slot-cross {

  position: absolute;

  inset: 22px;

  border: 1px solid rgba(241,241,235,.08);

}

.empty-slot-cross::before,
.empty-slot-cross::after {

  content: "";

  position: absolute;

  background: var(--m-line-light);

}

.empty-slot-cross::before {

  left: 50%;
  top: 17px;
  bottom: 17px;

  width: 2px;

}

.empty-slot-cross::after {

  top: 50%;
  left: 17px;
  right: 17px;

  height: 2px;

}

.empty-slot-icon {

  position: relative;

  z-index: 2;

  color: var(--m-dim);

}

.empty-slot-art-label {

  position: absolute;

  left: 10px;
  bottom: 9px;

  color: var(--m-dim);

  font-family: var(--font-display);
  font-size: .36rem;
  font-weight: 900;

}

.empty-slot-content {

  padding: 16px;

}

.empty-slot-content h3 {

  margin-top: 5px;

  color: var(--m-white);

  font-family: var(--font-display);
  font-size: 1.1rem;
  font-weight: 900;

  line-height: .95;

}

.empty-slot-content p {

  max-width: 360px;

  margin-top: 9px;

  color: var(--m-muted);

  font-size: .67rem;

  line-height: 1.55;

}

.retro-action {

  min-height: 38px;

  display: grid;

  grid-template-columns:
    18px
    1fr
    15px;

  align-items: center;

  gap: 7px;

  margin: 0 10px 10px;

  padding: 0 9px;

  border: 2px solid var(--m-line-light);

  color: var(--m-white);

  background: var(--m-panel-2);

  font-family: var(--font-display);
  font-size: .41rem;
  font-weight: 900;

  text-decoration: none;

  text-transform: uppercase;

}

.retro-action:hover {

  color: var(--m-accent);

  border-color: var(--m-accent-dark);

}

.retro-action--accent {

  color: var(--m-accent);

  border-color: var(--m-accent-dark);

}


/* =============================================================
   SUMMARY
   ============================================================= */

.summary-grid {

  display: grid;

  grid-template-columns:
    repeat(2,minmax(0,1fr));

  gap: 10px;

}

.summary-card {

  min-width: 0;

  overflow: hidden;

  border: 2px solid var(--m-line);

  background: var(--m-panel);

  box-shadow:
    5px 5px 0 var(--m-black);

}

.summary-card-top {

  min-height: 59px;

  display: flex;
  align-items: center;
  justify-content: space-between;

  gap: 10px;

  padding: 9px 12px;

  border-bottom: 2px solid var(--m-line);

  background: var(--m-black-2);

}

.summary-card-title {

  display: flex;
  align-items: center;

  gap: 8px;

}

.summary-card-icon {

  width: 31px;
  height: 31px;

  display: grid;
  place-items: center;

  color: var(--m-accent);

  border: 1px solid var(--m-accent-dark);

}

.summary-card-top > span {

  color: var(--m-dim);

  font-family: var(--font-display);
  font-size: .39rem;
  font-weight: 900;

}

.summary-card-title h3 {

  margin-top: 3px;

  color: var(--m-white);

  font-family: var(--font-display);
  font-size: .73rem;
  font-weight: 900;

}

.summary-list {

  padding: 0 12px;

}

.summary-row {

  min-height: 47px;

  display: flex;
  align-items: center;
  justify-content: space-between;

  gap: 10px;

  border-bottom: 1px solid var(--m-line);

}

.summary-row-left {

  display: flex;
  align-items: center;

  gap: 8px;

  color: var(--m-muted);

  font-family: var(--font-display);
  font-size: .42rem;
  font-weight: 900;

}

.summary-row-icon {

  width: 22px;
  height: 22px;

  display: grid;
  place-items: center;

  border: 1px solid var(--m-line-light);

  color: var(--m-soft);

}

.summary-row strong {

  color: var(--m-white);

  font-family: var(--font-display);
  font-size: .74rem;
  font-weight: 900;

}

.summary-row .summary-good {

  color: var(--m-accent);

}

.summary-card-footer {

  min-height: 54px;

  display: flex;
  align-items: center;
  justify-content: space-between;

  gap: 10px;

  padding: 10px 12px;

}

.summary-card-footer > span {

  color: var(--m-dim);

  font-family: var(--font-display);
  font-size: .38rem;
  font-weight: 900;

}

.summary-link {

  color: var(--m-accent);

  font-family: var(--font-display);
  font-size: .42rem;
  font-weight: 900;

  text-decoration: none;

}

.next-move {

  display: grid;

  grid-template-columns:
    135px
    minmax(0,1fr);

  gap: 14px;

  padding: 14px 12px;

}

.next-move-visual {

  min-height: 150px;

  position: relative;

  display: grid;
  place-items: center;

  overflow: hidden;

  border: 1px dashed var(--m-line-light);

  background:
    repeating-linear-gradient(
      135deg,
      #171917 0 8px,
      #131513 8px 16px
    );

}

.next-move-cross {

  position: absolute;

  width: 92px;
  height: 92px;

  border: 1px solid rgba(241,241,235,.08);

}

.next-move-cross::before,
.next-move-cross::after {

  content: "";

  position: absolute;

  background: var(--m-line-light);

}

.next-move-cross::before {

  left: 50%;
  top: 13px;
  bottom: 13px;

  width: 2px;

}

.next-move-cross::after {

  top: 50%;
  left: 13px;
  right: 13px;

  height: 2px;

}

.next-move-icon {

  position: relative;

  z-index: 2;

  color: var(--m-accent);

}

.next-move-visual > span {

  position: absolute;

  left: 8px;
  bottom: 7px;

  color: var(--m-dim);

  font-family: var(--font-display);
  font-size: .36rem;
  font-weight: 900;

}

.next-move-copy {

  min-width: 0;

  display: flex;
  flex-direction: column;

  justify-content: center;

  align-items: flex-start;

}

.next-move-copy > strong {

  margin-top: 5px;

  color: var(--m-white);

  font-family: var(--font-display);
  font-size: 1.15rem;
  font-weight: 900;

  line-height: 1;

}

.next-move-copy p {

  margin-top: 9px;

  color: var(--m-muted);

  font-size: .67rem;

  line-height: 1.55;

}


/* =============================================================
   HISTORY
   ============================================================= */

.history-panel {

  overflow: hidden;

  border: 2px solid var(--m-line);

  background: var(--m-panel);

  box-shadow:
    5px 5px 0 var(--m-black);

}

.history-panel-head {

  min-height: 60px;

  display: flex;
  align-items: center;
  justify-content: space-between;

  gap: 15px;

  padding: 9px 12px;

  border-bottom: 2px solid var(--m-line);

  background: var(--m-black-2);

}

.history-head-title {

  display: flex;
  align-items: center;

  gap: 8px;

}

.history-head-icon {

  width: 32px;
  height: 32px;

  display: grid;
  place-items: center;

  color: var(--m-accent);

  border: 1px solid var(--m-accent-dark);

}

.history-head-title > div {

  display: flex;
  flex-direction: column;

  gap: 3px;

}

.history-head-title strong {

  color: var(--m-white);

  font-family: var(--font-display);
  font-size: .7rem;
  font-weight: 900;

}

.history-panel-head > span {

  color: var(--m-dim);

  font-family: var(--font-display);
  font-size: .38rem;
  font-weight: 900;

}

.history-row {

  min-height: 72px;

  display: grid;

  grid-template-columns:
    35px
    35px
    minmax(0,1fr)
    90px
    100px;

  align-items: center;

  gap: 10px;

  padding: 9px 12px;

  border-bottom: 1px solid var(--m-line);

}

.history-row:last-child {

  border-bottom: 0;

}

.history-row:hover {

  background: var(--m-panel-2);

}

.history-number {

  color: var(--m-dim);

  font-family: var(--font-display);
  font-size: .43rem;
  font-weight: 900;

}

.history-icon {

  width: 31px;
  height: 31px;

  display: grid;
  place-items: center;

  color: var(--m-soft);

  border: 1px solid var(--m-line-light);

}

.history-main {

  min-width: 0;

  display: flex;
  flex-direction: column;

  gap: 4px;

}

.history-main strong {

  overflow: hidden;

  color: var(--m-white);

  font-family: var(--font-display);
  font-size: .61rem;
  font-weight: 900;

  text-overflow: ellipsis;
  white-space: nowrap;

}

.history-main span {

  color: var(--m-muted);

  font-size: .47rem;

}

.history-log-id {

  color: var(--m-dim);

  font-family: var(--font-display);
  font-size: .38rem;
  font-weight: 900;

}

.history-value {

  color: var(--m-white);

  font-family: var(--font-display);
  font-size: .46rem;
  font-weight: 900;

  text-align: right;

}


/* =============================================================
   MOTOR HUNT
   ============================================================= */

.motor-hunt {

  min-height: 260px;

  display: grid;

  grid-template-columns:
    250px
    minmax(0,1fr)
    90px;

  overflow: hidden;

  border: 2px solid var(--m-line-light);

  background: var(--m-panel);

  box-shadow:
    7px 7px 0 var(--m-black);

}

.hunt-art {

  position: relative;

  display: grid;
  place-items: center;

  overflow: hidden;

  border-right: 2px solid var(--m-line);

  background:
    linear-gradient(
      90deg,
      transparent 49%,
      rgba(255,255,255,.03) 50%,
      transparent 51%
    ),
    linear-gradient(
      transparent 49%,
      rgba(255,255,255,.03) 50%,
      transparent 51%
    ),
    #151715;

  background-size: 20px 20px;

}

.hunt-cross {

  width: 125px;
  height: 125px;

  position: absolute;

  border: 1px dashed rgba(183,216,60,.15);

}

.hunt-cross::before,
.hunt-cross::after {

  content: "";

  position: absolute;

  background: rgba(183,216,60,.1);

}

.hunt-cross::before {

  left: 50%;
  top: -16px;
  bottom: -16px;

  width: 1px;

}

.hunt-cross::after {

  left: -16px;
  right: -16px;
  top: 50%;

  height: 1px;

}

.hunt-icon {

  position: relative;
  z-index: 2;

  width: 56px;
  height: 56px;

  display: grid;
  place-items: center;

  color: var(--m-accent);

  border: 2px solid var(--m-accent-dark);

  background: var(--m-black-2);

  box-shadow:
    5px 5px 0 var(--m-black);

}

.hunt-code {

  position: absolute;

  left: 11px;
  bottom: 10px;

  color: var(--m-dim);

  font-family: var(--font-display);
  font-size: .38rem;
  font-weight: 900;

}

.hunt-art-corner {

  width: 16px;
  height: 16px;

  position: absolute;

  z-index: 4;

}

.hunt-art-corner--tl {

  top: 9px;
  left: 9px;

  border-top: 2px solid var(--m-accent);
  border-left: 2px solid var(--m-accent);

}

.hunt-art-corner--tr {

  top: 9px;
  right: 9px;

  border-top: 2px solid var(--m-accent);
  border-right: 2px solid var(--m-accent);

}

.hunt-art-corner--bl {

  left: 9px;
  bottom: 9px;

  border-left: 2px solid var(--m-accent);
  border-bottom: 2px solid var(--m-accent);

}

.hunt-art-corner--br {

  right: 9px;
  bottom: 9px;

  border-right: 2px solid var(--m-accent);
  border-bottom: 2px solid var(--m-accent);

}

.hunt-copy {

  min-width: 0;

  padding: 24px;

}

.hunt-copy h2 {

  margin-top: 5px;

  color: var(--m-white);

  font-family: var(--font-display);
  font-size: clamp(1.6rem,3.5vw,2.7rem);
  font-weight: 900;

  line-height: .9;

  text-transform: uppercase;

}

.hunt-copy p {

  max-width: 650px;

  margin-top: 11px;

  color: var(--m-muted);

  font-size: .71rem;

  line-height: 1.6;

}

.hunt-actions {

  display: flex;

  gap: 7px;

  margin-top: 17px;

}

.hunt-side {

  display: flex;

  align-items: center;
  justify-content: center;

  flex-direction: column;

  gap: 3px;

  border-left: 2px solid var(--m-line);

  background: var(--m-black-2);

  font-family: var(--font-display);

  text-align: center;

}

.hunt-side span {

  color: var(--m-dim);

  font-size: .38rem;
  font-weight: 900;

}

.hunt-side strong {

  color: var(--m-accent);

  font-size: 2.5rem;
  font-weight: 900;

  line-height: .8;

}

.hunt-side small {

  color: var(--m-muted);

  font-size: .36rem;
  font-weight: 900;

}


/* =============================================================
   PIXEL MOTOR
   ============================================================= */

.pixel-motor {

  width: 190px;
  height: 108px;

  position: relative;

  color: var(--m-white);

}

.pixel-motor span {

  position: absolute;

  display: block;

}

.pixel-motor__wheel {

  width: 42px;
  height: 42px;

  bottom: 6px;

  border: 6px solid var(--m-black);

  background: transparent;

  box-shadow:
    inset 0 0 0 4px var(--m-soft);

}

.pixel-motor__wheel::after {

  content: "";

  position: absolute;

  left: 12px;
  top: 12px;

  width: 6px;
  height: 6px;

  background: var(--m-black);

}

.pixel-motor__wheel--rear {

  left: 17px;

}

.pixel-motor__wheel--front {

  right: 17px;

}

.pixel-motor__body {

  left: 41px;
  top: 43px;

  width: 94px;
  height: 19px;

  background: var(--m-accent);

  clip-path:
    polygon(
      0 30%,
      18% 30%,
      28% 0,
      55% 0,
      67% 30%,
      100% 30%,
      100% 100%,
      0 100%
    );

}

.pixel-motor__tank {

  left: 73px;
  top: 27px;

  width: 38px;
  height: 18px;

  background: var(--m-white);

  clip-path:
    polygon(
      0 0,
      76% 0,
      100% 36%,
      82% 100%,
      18% 100%
    );

}

.pixel-motor__seat {

  left: 51px;
  top: 24px;

  width: 31px;
  height: 9px;

  background: var(--m-black);

}

.pixel-motor__frame {

  left: 66px;
  top: 44px;

  width: 44px;
  height: 33px;

  border-left: 5px solid var(--m-black);
  border-bottom: 5px solid var(--m-black);

  transform: skew(-17deg);

}

.pixel-motor__engine {

  left: 76px;
  top: 49px;

  width: 29px;
  height: 22px;

  background: var(--m-line-light);

  border: 3px solid var(--m-black);

}

.pixel-motor__engine::after {

  content: "";

  position: absolute;

  left: 6px;
  top: 6px;

  width: 10px;
  height: 4px;

  background: var(--m-soft);

  box-shadow:
    0 6px 0 var(--m-soft);

}

.pixel-motor__pipe {

  left: 103px;
  top: 68px;

  width: 38px;
  height: 5px;

  border-bottom: 4px solid var(--m-soft);

  transform: rotate(-5deg);

}

.pixel-motor__front {

  right: 38px;
  top: 41px;

  width: 6px;
  height: 34px;

  background: var(--m-black);

  transform: rotate(-8deg);

}

.pixel-motor__rear {

  left: 44px;
  top: 47px;

  width: 5px;
  height: 26px;

  background: var(--m-black);

}

.pixel-motor__handle {

  right: 23px;
  top: 27px;

  width: 26px;
  height: 5px;

  background: var(--m-black);

  transform: rotate(-20deg);

}

.pixel-motor__handle::after {

  content: "";

  position: absolute;

  right: 2px;
  top: -6px;

  width: 5px;
  height: 14px;

  background: var(--m-black);

}


/* =============================================================
   FOOTER
   ============================================================= */

.motor-footer {

  margin-top: 48px;

  padding: 10px 0 8px;

  color: var(--m-muted);

  font-family: var(--font-display);
  font-size: .4rem;
  font-weight: 900;

  text-transform: uppercase;

}

.footer-line {

  height: 2px;

  margin-bottom: 12px;

  background: var(--m-line-light);

}

.footer-row {

  display: grid;

  grid-template-columns:
    1fr
    auto
    1fr;

  align-items: center;

  gap: 15px;

}

.footer-brand {

  display: flex;
  align-items: center;

  gap: 8px;

}

.footer-icon {

  width: 29px;
  height: 29px;

  display: grid;
  place-items: center;

  border: 1px solid var(--m-line-light);

  color: var(--m-accent);

}

.footer-brand > div {

  display: flex;
  flex-direction: column;

  gap: 3px;

}

.footer-brand strong {

  color: var(--m-white);

  font-size: .56rem;

}

.footer-online {

  display: flex;
  align-items: center;
  justify-content: flex-end;

  gap: 6px;

  color: var(--m-accent);

}

.footer-online i {

  width: 5px;
  height: 5px;

  background: var(--m-accent);

}


/* =============================================================
   TABLET
   ============================================================= */

@media (max-width: 1100px) {

  .motor-header-body {

    grid-template-columns:
      minmax(0,1fr)
      215px;

  }

  .collection-status-grid {

    grid-template-columns:
      repeat(2,1fr);

  }

  .filter-list {

    grid-template-columns:
      repeat(2,1fr);

  }

  .filter-button:nth-child(2) {

    border-right: 0;

  }

  .motor-collection-grid,
  .summary-grid {

    grid-template-columns: 1fr;

  }

  .empty-slot-card {

    min-height: 430px;

  }

  .motor-hunt {

