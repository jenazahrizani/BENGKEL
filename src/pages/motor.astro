}

.owned-art-label span {

  color: var(--m-muted);

  font-size: .39rem;
  font-weight: 900;

}

.owned-art-label strong {

  color: var(--m-white);

  font-size: .72rem;
  font-weight: 900;

}

.owned-art-type {

  position: absolute;

  right: 12px;
  bottom: 13px;

