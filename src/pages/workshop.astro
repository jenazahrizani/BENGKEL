.job-bike-cross::after {

  content: "";

  position: absolute;

  background: rgba(183,216,60,.1);

}

.job-bike-cross::before {

  left: 50%;
  top: -15px;
  bottom: -15px;

  width: 1px;

}

.job-bike-cross::after {

  top: 50%;
  left: -15px;
  right: -15px;

  height: 1px;

}

.job-bike-name {

  position: absolute;

  left: 11px;
  bottom: 12px;

  display: flex;
  align-items: baseline;

  gap: 5px;

  z-index: 4;

  font-family: var(--font-display);

}

.job-bike-name span {

  color: var(--w-muted);

  font-size: .39rem;
  font-weight: 900;

}

.job-bike-name strong {

  color: var(--w-white);

  font-size: .77rem;
  font-weight: 900;

}

.job-bike-floor {

  position: absolute;

  left: 12%;
  right: 12%;
  bottom: 27px;

  height: 4px;

  z-index: 4;

  background: var(--w-accent);

  box-shadow:
    0 5px 0 var(--w-black);

}

.active-job-content {

  min-width: 0;

  padding: 21px;

}

.active-job-heading {

  display: flex;

  justify-content: space-between;

  align-items: flex-start;

  gap: 15px;

  padding-bottom: 13px;

  border-bottom: 1px solid var(--w-line);

}

.active-job-heading h3 {

  margin-top: 5px;

  color: var(--w-white);

  font-family: var(--font-display);
  font-size: 2rem;
  font-weight: 900;

  line-height: .9;

}

.customer-job-type {

  display: flex;
  flex-direction: column;

  gap: 4px;

  text-align: right;

}

.customer-job-type span {

  color: var(--w-dim);

  font-family: var(--font-display);
  font-size: .37rem;
  font-weight: 900;

}

.customer-job-type strong {

  color: var(--w-accent);

  font-family: var(--font-display);
  font-size: .6rem;
  font-weight: 900;

}

.active-job-description {

  max-width: 710px;

  margin-top: 14px;

  color: var(--w-muted);

  font-size: .71rem;

  line-height: 1.6;

}

.job-step-list {

  display: grid;

  grid-template-columns:
    repeat(3,1fr);

  gap: 6px;

  margin-top: 17px;

}

.job-step {

  min-height: 70px;

  display: flex;
  align-items: center;

  gap: 8px;

  padding: 8px;

  border: 1px solid var(--w-line);

  background: var(--w-black-2);

}

.job-step--done {

  border-color: var(--w-accent-dark);

}

.job-step-box {

  width: 23px;
  height: 23px;

  flex: 0 0 auto;

  display: grid;
  place-items: center;

  border: 2px solid var(--w-line-light);

  color: var(--w-dim);

  font-family: var(--font-display);
  font-size: .53rem;
  font-weight: 900;

}

.job-step--done .job-step-box {

  border-color: var(--w-accent);

  background: var(--w-accent);

  color: var(--w-black);

}

.job-step > div {

  min-width: 0;

  display: flex;
  flex-direction: column;

  gap: 3px;

}

.job-step > div span {

  color: var(--w-dim);

  font-family: var(--font-display);
  font-size: .34rem;
  font-weight: 900;

}

.job-step > div strong {

  color: var(--w-white);

  font-family: var(--font-display);
  font-size: .43rem;
  font-weight: 900;

}

.job-step > div small {

  color: var(--w-muted);

  font-size: .37rem;

}

.job-progress {

  margin-top: 18px;

}

.job-progress-head {

  display: flex;
  align-items: center;
  justify-content: space-between;

  color: var(--w-dim);

  font-family: var(--font-display);
  font-size: .39rem;
  font-weight: 900;

}

.job-progress-head strong {

  color: var(--w-accent);

}

.job-progress-track {

  height: 8px;

  margin-top: 7px;

  border: 1px solid var(--w-line);

  background: var(--w-black-2);

}

.job-progress-track i {

  height: 100%;

  display: block;

  background: var(--w-accent);

}

.active-job-footer {

  display: grid;

  grid-template-columns:
    minmax(140px,1fr)
    90px
    165px;

  align-items: end;

  gap: 15px;

  margin-top: 18px;

  padding-top: 13px;

  border-top: 2px solid var(--w-line);

}

.active-job-footer > div {

  display: flex;
  flex-direction: column;

  gap: 4px;

}

.active-job-footer span {

  color: var(--w-dim);

  font-family: var(--font-display);
  font-size: .38rem;
  font-weight: 900;

}

.active-job-footer strong {

  color: var(--w-white);

  font-family: var(--font-display);
  font-size: .89rem;
  font-weight: 900;

}

.job-action {

  min-height: 38px;

  display: flex;
  align-items: center;
  justify-content: space-between;

  padding: 0 10px;

  border: 2px solid var(--w-accent-dark);

  color: var(--w-accent);

  background: var(--w-black-2);

  font-family: var(--font-display);
  font-size: .42rem;
  font-weight: 900;

  text-decoration: none;

}

.job-action:hover {

  color: var(--w-black);

  background: var(--w-accent);

}


/* =============================================================
   WORK TYPES
   ============================================================= */

.work-types-grid {

  display: grid;

  grid-template-columns:
    repeat(3,minmax(0,1fr));

  gap: 10px;

}

.work-type-card {

  min-height: 235px;

  position: relative;

  display: flex;
  flex-direction: column;

  overflow: hidden;

  background: var(--w-panel);

  border: 2px solid var(--w-line);

  box-shadow:
    4px 4px 0 var(--w-black);

  transition:
    transform 80ms steps(1),
    border-color 80ms steps(1);

}

.work-type-card:hover {

  transform: translate(-2px,-2px);

  border-color: var(--w-line-light);

}

.work-type-card--featured {

  border-color: var(--w-accent-dark);

}

.work-type-top {

  min-height: 31px;

  display: flex;
  align-items: center;
  justify-content: space-between;

  padding: 0 9px;

  border-bottom: 2px solid var(--w-line);

  background: var(--w-black-2);

}

.work-type-number,
.work-type-status {

  color: var(--w-dim);

  font-family: var(--font-display);
  font-size: .39rem;
  font-weight: 900;

}

.work-type-card--featured .work-type-status {

  color: var(--w-accent);

}

.work-type-icon {

  width: 62px;
  height: 62px;

  display: grid;
  place-items: center;

  margin: 15px 15px 8px;

  border: 2px solid var(--w-line-light);

  color: var(--w-soft);

  background: var(--w-black-2);

  box-shadow:
    4px 4px 0 var(--w-black);

}

.work-type-card--featured .work-type-icon {

  color: var(--w-accent);

  border-color: var(--w-accent-dark);

}

.work-type-content {

  padding: 0 15px;

}

.work-type-content h3 {

  margin-top: 5px;

  color: var(--w-white);

  font-family: var(--font-display);
  font-size: 1rem;
  font-weight: 900;

  line-height: .95;

}

.work-type-content p {

  margin-top: 7px;

  color: var(--w-muted);

  font-size: .62rem;

  line-height: 1.52;

}

.work-type-footer {

  min-height: 35px;

  display: flex;
  align-items: center;
  justify-content: space-between;

  margin-top: auto;

  padding: 0 12px;

  border-top: 1px solid var(--w-line);

  color: var(--w-dim);

  font-family: var(--font-display);
  font-size: .38rem;
  font-weight: 900;

}

.work-type-footer span:last-child {

  color: var(--w-accent);

}


/* =============================================================
   PROJECT
   ============================================================= */

.project-layout {

  display: grid;

  grid-template-columns:
    310px
    minmax(0,1fr);

  gap: 10px;

}

.project-motor-card {

  min-width: 0;

  overflow: hidden;

  background: var(--w-panel);

  border: 2px solid var(--w-line-light);

  box-shadow:
    6px 6px 0 var(--w-black);

}

.project-motor-top {

  min-height: 31px;

  display: flex;
  align-items: center;
  justify-content: space-between;

  padding: 0 10px;

  background: var(--w-black-2);

  border-bottom: 2px solid var(--w-line);

  font-family: var(--font-display);
  font-size: .38rem;
  font-weight: 900;

}

.project-motor-top > div {

  display: flex;
  align-items: center;

  gap: 7px;

}

.project-motor-top > div span {

  color: var(--w-dim);

}

.project-motor-top > div strong {

  color: var(--w-accent);

}

.project-motor-top > span {

  color: var(--w-dim);

}

.project-motor-art {

  min-height: 245px;

  position: relative;

  display: grid;
  place-items: center;

  overflow: hidden;

  background:
    linear-gradient(
      90deg,
      transparent 49%,
      rgba(255,255,255,.03) 50%,
      transparent 51%
    ),
    linear-gradient(
      transparent 49%,
      rgba(255,255,255,.03) 50%,
      transparent 51%
    ),
    #171917;

  background-size: 20px 20px;

}

.project-motor-grid {

  position: absolute;

  inset: 0;

  opacity: .3;

  background-image:
    linear-gradient(
      rgba(255,255,255,.03) 1px,
      transparent 1px
    ),
    linear-gradient(
      90deg,
      rgba(255,255,255,.03) 1px,
      transparent 1px
    );

  background-size: 18px 18px;

}

.project-motor-frame {

  width: 160px;
  height: 160px;

  position: absolute;

  border: 1px dashed rgba(183,216,60,.12);

}

.pixel-motor {

  width: 190px;
  height: 108px;

  position: relative;

  color: var(--w-white);

}

.pixel-motor span {

  position: absolute;

  display: block;

}

.pixel-motor__wheel {

  width: 42px;
  height: 42px;

  bottom: 6px;

  border: 6px solid var(--w-black);

  background: transparent;

  box-shadow:
    inset 0 0 0 4px var(--w-soft);

}

.pixel-motor__wheel::after {

  content: "";

  position: absolute;

  left: 12px;
  top: 12px;

  width: 6px;
  height: 6px;

  background: var(--w-black);

}

.pixel-motor__wheel--rear {

  left: 17px;

}

.pixel-motor__wheel--front {

  right: 17px;

}

.pixel-motor__body {

  left: 41px;
  top: 43px;

  width: 94px;
  height: 19px;

  background: var(--w-accent);

  clip-path:
    polygon(
      0 30%,
      18% 30%,
      28% 0,
      55% 0,
      67% 30%,
      100% 30%,
      100% 100%,
      0 100%
    );

}

.pixel-motor__tank {

  left: 73px;
  top: 27px;

  width: 38px;
  height: 18px;

  background: var(--w-white);

  clip-path:
    polygon(
      0 0,
      76% 0,
      100% 36%,
      82% 100%,
      18% 100%
    );

}

.pixel-motor__seat {

  left: 51px;
  top: 24px;

  width: 31px;
  height: 9px;

  background: var(--w-black);

}

.pixel-motor__frame {

  left: 66px;
  top: 44px;

  width: 44px;
  height: 33px;

  border-left: 5px solid var(--w-black);
  border-bottom: 5px solid var(--w-black);

  transform: skew(-17deg);

}

.pixel-motor__engine {

  left: 76px;
  top: 49px;

  width: 29px;
  height: 22px;

  background: var(--w-line-light);

  border: 3px solid var(--w-black);

}

.pixel-motor__engine::after {

  content: "";

  position: absolute;

  left: 6px;
  top: 6px;

  width: 10px;
  height: 4px;

  background: var(--w-soft);

  box-shadow:
    0 6px 0 var(--w-soft);

}

.pixel-motor__pipe {

  left: 103px;
  top: 68px;

  width: 38px;
  height: 5px;

  border-bottom: 4px solid var(--w-soft);

  transform: rotate(-5deg);

}

.pixel-motor__front {

  right: 38px;
  top: 41px;

  width: 6px;
  height: 34px;

  background: var(--w-black);

  transform: rotate(-8deg);

}

.pixel-motor__rear {

  left: 44px;
  top: 47px;

  width: 5px;
  height: 26px;

  background: var(--w-black);

}

.pixel-motor__handle {

  right: 23px;
  top: 27px;

  width: 26px;
  height: 5px;

  background: var(--w-black);

  transform: rotate(-20deg);

}

.pixel-motor__handle::after {

  content: "";

  position: absolute;

  right: 2px;
  top: -6px;

  width: 5px;
  height: 14px;

  background: var(--w-black);

}

.pixel-motor--job {

  position: relative;

  z-index: 3;

  transform: scale(1.08);

  filter:
    drop-shadow(5px 5px 0 var(--w-black));

}

.pixel-motor--project {

  position: relative;

  z-index: 3;

  transform: scale(1.12);

  filter:
    drop-shadow(5px 5px 0 var(--w-black));

}

.project-motor-floor {

  position: absolute;

  left: 14%;
  right: 14%;
  bottom: 25px;

  height: 4px;

  background: var(--w-line-light);

  box-shadow:
    0 5px 0 var(--w-black);

}

.project-motor-name {

  position: absolute;

  left: 10px;
  bottom: 9px;

  display: flex;
  align-items: baseline;

  gap: 4px;

  z-index: 5;

  font-family: var(--font-display);

}

.project-motor-name span {

  position: static;

  color: var(--w-muted);

  font-size: .36rem;
  font-weight: 900;

}

.project-motor-name strong {

  position: static;

  color: var(--w-white);

  font-size: .65rem;
  font-weight: 900;

}

.project-motor-tag {

  position: absolute;

  right: 10px;
  top: 10px;

  padding: 4px 6px;

  border: 1px solid var(--w-accent-dark);

  background: var(--w-black-2);

  color: var(--w-accent);

  font-family: var(--font-display);
  font-size: .36rem;
  font-weight: 900;

  z-index: 5;

}

.project-motor-info {

  padding: 13px;

}

.project-motor-info h3 {

  margin-top: 5px;

  color: var(--w-white);

  font-family: var(--font-display);
  font-size: 1.28rem;
  font-weight: 900;

  line-height: .9;

}

.project-motor-info > span:last-child {

  display: block;

  margin-top: 5px;

  color: var(--w-dim);

  font-family: var(--font-display);
  font-size: .39rem;
  font-weight: 900;

}

.project-motor-actions {

  display: grid;

  grid-template-columns: 1fr 1fr;

  gap: 6px;

  padding: 0 10px 10px;

}

.retro-action {

  min-height: 37px;

  display: grid;

  grid-template-columns:
    17px
    1fr
    14px;

  align-items: center;

  gap: 6px;

  padding: 0 8px;

  border: 2px solid var(--w-line);

  color: var(--w-muted);

  background: var(--w-black-2);

  font-family: var(--font-display);
  font-size: .4rem;
  font-weight: 900;

  text-decoration: none;

}

.retro-action:hover {

  color: var(--w-accent);

  border-color: var(--w-accent-dark);

}

.retro-action--accent {

  color: var(--w-accent);

  border-color: var(--w-accent-dark);

}

.project-target {

  min-width: 0;

  overflow: hidden;

  padding: 18px;

  border: 2px solid var(--w-line);

  background: var(--w-panel);

  box-shadow:
    5px 5px 0 var(--w-black);

}

.project-target-head {

  display: flex;

  align-items: flex-start;

  justify-content: space-between;

  gap: 12px;

  padding-bottom: 14px;

  border-bottom: 1px solid var(--w-line);

}

.project-target-heading {

  display: flex;
  align-items: center;

  gap: 8px;

}

.target-icon {

  width: 32px;
  height: 32px;

  display: grid;
  place-items: center;

  color: var(--w-accent);

  border: 1px solid var(--w-accent-dark);

  background: var(--w-black-2);

}

.project-target-head h3 {

  margin-top: 4px;

  color: var(--w-white);

  font-family: var(--font-display);
  font-size: 1.24rem;
  font-weight: 900;

  line-height: .95;

}

.target-badge {

  padding: 5px 7px;

  border: 1px solid var(--w-accent-dark);

  color: var(--w-accent);

  font-family: var(--font-display);
  font-size: .39rem;
  font-weight: 900;

}

.target-main-score {

  margin-top: 16px;

}

.target-score-label {

  display: flex;
  justify-content: space-between;

  color: var(--w-dim);

  font-family: var(--font-display);
  font-size: .4rem;
  font-weight: 900;

}

.target-score-label strong {

  color: var(--w-white);

  font-size: .72rem;

}

.target-track {

  height: 8px;

  margin-top: 7px;

  border: 1px solid var(--w-line);

  background: var(--w-black-2);

}

.target-track i {

  height: 100%;

  display: block;

  background: var(--w-accent);

}

.target-foot {

  display: flex;

  align-items: center;
  justify-content: space-between;

  margin-top: 5px;

  color: var(--w-dim);

  font-family: var(--font-display);
  font-size: .37rem;
  font-weight: 900;

}

.target-foot strong {

  color: var(--w-accent);

}

.project-checklist {

  display: grid;

  gap: 0;

  margin-top: 15px;

}

.project-check {

  min-height: 60px;

  display: grid;

  grid-template-columns:
    30px
    minmax(0,1fr);

  align-items: center;

  gap: 9px;

  padding: 8px 0;

  border-bottom: 1px solid var(--w-line);

}

.project-check-icon {

  width: 27px;
  height: 27px;

  display: grid;
  place-items: center;

  border: 2px solid var(--w-line-light);

  color: var(--w-muted);

}

.project-check--done .project-check-icon {

  border-color: var(--w-accent);

  color: var(--w-black);

  background: var(--w-accent);

}

.project-check > div {

  display: flex;
  flex-direction: column;

  gap: 3px;

}

.project-check > div span {

  color: var(--w-dim);

  font-family: var(--font-display);
  font-size: .35rem;
  font-weight: 900;

}

.project-check > div strong {

  color: var(--w-white);

  font-family: var(--font-display);
  font-size: .49rem;
  font-weight: 900;

}

.project-check > div small {

  color: var(--w-muted);

  font-size: .39rem;

}

.project-target-actions {

  display: grid;

  grid-template-columns: 1fr 1fr;

  gap: 7px;

  margin-top: 16px;

}


/* =============================================================
   PARTS
   ============================================================= */

.workshop-parts-grid {

  display: grid;

  grid-template-columns:
    repeat(4,minmax(0,1fr));

  gap: 10px;

}

.workshop-part-card {

  min-width: 0;

  display: flex;
  flex-direction: column;

  overflow: hidden;

  background: var(--w-panel);

  border: 2px solid var(--w-line);

  box-shadow:
    4px 4px 0 var(--w-black);

  transition:
    transform 80ms steps(1),
    border-color 80ms steps(1);

}

.workshop-part-card:hover {

  transform: translate(-2px,-2px);

  border-color: var(--w-line-light);

}

.workshop-part-top {

  min-height: 31px;

  display: flex;
  align-items: center;
  justify-content: space-between;

  padding: 0 9px;

  border-bottom: 2px solid var(--w-line);

  background: var(--w-black-2);

  color: var(--w-dim);

  font-family: var(--font-display);
  font-size: .37rem;
  font-weight: 900;

}

.workshop-part-top span:last-child {

  color: var(--w-accent);

}

.workshop-part-art {

  min-height: 150px;

  position: relative;

  display: grid;
  place-items: center;

  overflow: hidden;

  background:
    repeating-linear-gradient(
      45deg,
      #181a18 0 8px,
      #141614 8px 16px
    );

  border-bottom: 1px solid var(--w-line);

}

.part-art-label {

  position: absolute;

  left: 9px;
  top: 8px;

  color: var(--w-dim);

  font-family: var(--font-display);
  font-size: .34rem;
  font-weight: 900;

}

.part-art-index {

  position: absolute;

  right: 9px;
  bottom: 7px;

  color: rgba(241,241,235,.25);

  font-family: var(--font-display);
  font-size: .35rem;
  font-weight: 900;

}

.part-pixel-object {

  width: 88px;
  height: 72px;

  position: relative;

  image-rendering: pixelated;

}

.part-pixel-main,
.part-pixel-shadow,
.part-pixel-detail {

  position: absolute;

  display: block;

}

.part-pixel-shadow {

  left: 16px;
  bottom: 7px;

  width: 56px;
  height: 7px;

  background: var(--w-black);

  opacity: .65;

}


/* CARBURETOR */

.part-pixel-object--carburetor .part-pixel-main {

  left: 28px;
  top: 14px;

  width: 30px;
  height: 38px;

  border: 4px solid var(--w-soft);

  background: #242424;

}

.part-pixel-object--carburetor .part-pixel-detail--1 {

  left: 13px;
  top: 24px;

  width: 17px;
  height: 10px;

