      </main>

    </div>

  </div>
</Layout>


<style>

/* =============================================================
   TOKENS
   ============================================================= */

.workshop-page {

  --w-black: #050505;
  --w-black-2: #090909;

  --w-panel: #101010;
  --w-panel-2: #151515;
  --w-panel-3: #1c1c1c;

  --w-line: #292929;
  --w-line-light: #3d3d3d;

  --w-white: #f1f1eb;
  --w-soft: #d0d0ca;

  --w-muted: #989892;
  --w-dim: #62625d;

  --w-accent: #b7d83c;
  --w-accent-dark: #687d27;

}


/* =============================================================
   BASE
   ============================================================= */

.workshop-main {
  min-width: 0;
}

.workshop-section {
  margin-top: 42px;
}

.section-header {

  min-height: 55px;

  display: flex;
  align-items: center;
  justify-content: space-between;

  gap: 15px;

  margin-bottom: 10px;

  border-bottom: 2px solid var(--w-line);

}

.section-heading {

  display: flex;
  align-items: center;

  gap: 11px;

}

.section-marker {

  width: 8px;
  height: 8px;

  flex: 0 0 auto;

  background: var(--w-white);

  box-shadow:
    4px 4px 0 var(--w-line-light);

}

.section-marker--accent {

  background: var(--w-accent);

  box-shadow:
    4px 4px 0 var(--w-accent-dark);

}

.section-kicker {

  display: block;

  color: var(--w-dim);

  font-family: var(--font-display);
  font-size: .51rem;
  font-weight: 900;

  letter-spacing: .1em;

  text-transform: uppercase;

}

.section-header h2 {

  margin-top: 4px;

  color: var(--w-white);

  font-family: var(--font-display);
  font-size: clamp(1.35rem,3vw,2rem);
  font-weight: 900;

  line-height: .9;

  letter-spacing: -.04em;

  text-transform: uppercase;

}

.section-code,
.section-link {

  color: var(--w-dim);

  font-family: var(--font-display);
  font-size: .45rem;
  font-weight: 900;

  letter-spacing: .08em;

  text-transform: uppercase;

}

.section-link {

  color: var(--w-accent);

  text-decoration: none;

}

.section-link:hover {

  color: var(--w-white);

}

.accent-text {

  color: var(--w-accent) !important;

}


/* =============================================================
   PIXEL ICON SYSTEM
   ============================================================= */

.pixel-icon {

  position: relative;

  display: block;

  width: 18px;
  height: 18px;

  color: currentColor;

  image-rendering: pixelated;

}

.pixel-icon::before,
.pixel-icon::after {

  content: "";

  position: absolute;

  display: block;

}

.pixel-icon--tiny {

  width: 10px;
  height: 10px;

}

.pixel-icon--small {

  width: 18px;
  height: 18px;

}

.pixel-icon--medium {

  width: 30px;
  height: 30px;

}


/* MOTOR */

.pixel-icon--motorcycle::before {

  left: 1px;
  bottom: 1px;

  width: 5px;
  height: 5px;

  border: 2px solid currentColor;

  box-shadow:
    10px 0 0 -1px var(--w-panel),
    10px 0 0 currentColor;

}

.pixel-icon--motorcycle::after {

  left: 4px;
  top: 6px;

  width: 10px;
  height: 4px;

  background: currentColor;

  box-shadow:
    -1px 3px 0 -1px currentColor,
    3px 4px 0 -1px currentColor,
    7px 3px 0 -1px currentColor;

}


/* WRENCH */

.pixel-icon--wrench::before {

  left: 3px;
  top: 2px;

  width: 5px;
  height: 5px;

  border: 2px solid currentColor;

  transform: rotate(45deg);

  box-shadow:
    5px 5px 0 -1px currentColor,
    8px 8px 0 -1px currentColor;

}

.pixel-icon--wrench::after {

  right: 1px;
  bottom: 1px;

  width: 6px;
  height: 6px;

  border: 2px solid currentColor;

}


/* TOOLBOX */

.pixel-icon--toolbox::before {

  left: 1px;
  bottom: 2px;

  width: 16px;
  height: 10px;

  border: 2px solid currentColor;

}

.pixel-icon--toolbox::after {

  left: 5px;
  top: 3px;

  width: 8px;
  height: 4px;

  border: 2px solid currentColor;

}


/* PERSON */

.pixel-icon--person::before {

  left: 6px;
  top: 1px;

  width: 6px;
  height: 6px;

  background: currentColor;

}

.pixel-icon--person::after {

  left: 3px;
  bottom: 1px;

  width: 12px;
  height: 8px;

  background: currentColor;

}


/* CLIPBOARD */

.pixel-icon--clipboard::before {

  left: 3px;
  top: 3px;

  width: 12px;
  height: 14px;

  border: 2px solid currentColor;

}

.pixel-icon--clipboard::after {

  left: 6px;
  top: 1px;

  width: 6px;
  height: 4px;

  background: currentColor;

}


/* GEAR */

.pixel-icon--gear::before {

  left: 4px;
  top: 4px;

  width: 8px;
  height: 8px;

  border: 2px solid currentColor;

  box-shadow:
    0 -4px 0 -2px currentColor,
    0 4px 0 -2px currentColor,
    4px 0 0 -2px currentColor,
    -4px 0 0 -2px currentColor;

}

.pixel-icon--gear::after {

  left: 7px;
  top: 7px;

  width: 3px;
  height: 3px;

  background: currentColor;

}


/* BOLT */

.pixel-icon--bolt::before {

  left: 7px;
  top: 0;

  width: 7px;
  height: 18px;

  background: currentColor;

  clip-path:
    polygon(
      40% 0,
      100% 0,
      65% 42%,
      100% 42%,
      18% 100%,
      38% 57%,
      0 57%
    );

}


/* HAMMER */

.pixel-icon--hammer::before {

  left: 8px;
  top: 6px;

  width: 5px;
  height: 11px;

  background: currentColor;

  transform: rotate(32deg);

}

.pixel-icon--hammer::after {

  left: 2px;
  top: 2px;

  width: 13px;
  height: 6px;

  background: currentColor;

}


/* CHECK */

.pixel-icon--check::before {

  left: 2px;
  top: 7px;

  width: 6px;
  height: 3px;

  border-left: 2px solid currentColor;
  border-bottom: 2px solid currentColor;

  transform: rotate(-45deg);

}


/* FLAG */

.pixel-icon--flag::before {

  left: 3px;
  top: 1px;

  width: 3px;
  height: 17px;

  background: currentColor;

}

.pixel-icon--flag::after {

  left: 6px;
  top: 2px;

  width: 10px;
  height: 8px;

  background: currentColor;

  clip-path:
    polygon(
      0 0,
      100% 0,
      75% 50%,
      100% 100%,
      0 100%
    );

}


/* SEARCH */

.pixel-icon--search::before {

  left: 2px;
  top: 2px;

  width: 9px;
  height: 9px;

  border: 2px solid currentColor;

}

.pixel-icon--search::after {

  right: 0;
  bottom: 0;

  width: 7px;
  height: 2px;

  background: currentColor;

  transform: rotate(45deg);

}


/* PLUS */

.pixel-icon--plus::before {

  left: 2px;
  top: 8px;

  width: 15px;
  height: 3px;

  background: currentColor;

}

.pixel-icon--plus::after {

  left: 8px;
  top: 2px;

  width: 3px;
  height: 15px;

  background: currentColor;

}


/* SPARK */

.pixel-icon--spark::before {

  left: 7px;
  top: 0;

  width: 4px;
  height: 18px;

  background: currentColor;

}

.pixel-icon--spark::after {

  left: 0;
  top: 7px;

  width: 18px;
  height: 4px;

  background: currentColor;

}


/* =============================================================
   HEADER
   ============================================================= */

.workshop-header {

  overflow: hidden;

  border: 2px solid var(--w-line-light);

  background: var(--w-panel);

  box-shadow:
    7px 7px 0 var(--w-black);

}

.workshop-header-top,
.workshop-header-bottom {

  min-height: 31px;

  display: grid;

  align-items: center;

  gap: 15px;

  padding: 0 11px;

  background: var(--w-black-2);

  color: var(--w-dim);

  font-family: var(--font-display);
  font-size: .45rem;
  font-weight: 900;

  letter-spacing: .08em;

  text-transform: uppercase;

}

.workshop-header-top {

  grid-template-columns:
    1fr
    auto
    auto;

