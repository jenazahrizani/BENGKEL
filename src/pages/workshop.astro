---
import Layout from "../components/Layout.astro";
import "../styles/global.css";
import Button from "../components/Button.astro";
import Navigation from "../components/Navigation.astro";

const workshopStats = [
  {
    label: "MECHANIC",
    value: "01 / 01",
    detail: "READY",
    icon: "person",
    active: true,
    fill: 8,
  },
  {
    label: "WORKBENCH",
    value: "01 / 01",
    detail: "AVAILABLE",
    icon: "wrench",
    fill: 10,
  },
  {
    label: "ORDER",
    value: "01 / 01",
    detail: "ACTIVE",
    icon: "clipboard",
    fill: 5,
  },
  {
    label: "TOOLS",
    value: "08 / 08",
    detail: "READY",
    icon: "toolbox",
    fill: 10,
  },
];

const activeOrder = {
  id: "JOB-001",
  customer: "PAK ARDI",
  motor: "NUSA 125",
  type: "SERVICE",
  description:
    "Periksa kondisi mesin, rem, ban, dan lakukan servis dasar sebelum unit dikembalikan kepada pelanggan.",
  reward: 450000,
  progress: 35,
  deadline: "TODAY",
};

const workTypes = [
  {
    id: "WORK-01",
    name: "SERVICE",
    eyebrow: "BASIC / MAINTENANCE",
    icon: "wrench",
    description:
      "Servis dasar, pemeriksaan komponen, oli, rem, ban, dan pengecekan kondisi umum.",
  },
  {
    id: "WORK-02",
    name: "REPAIR",
    eyebrow: "FIX / RESTORE",
    icon: "hammer",
    description:
      "Perbaiki komponen rusak untuk mengembalikan reliability dan kondisi motor.",
  },
  {
    id: "WORK-03",
    name: "TUNE",
    eyebrow: "PERFORMANCE",
    icon: "bolt",
    description:
      "Atur karakter motor setelah parts terpasang agar performa sesuai kebutuhan build.",
  },
  {
    id: "WORK-04",
    name: "BUILD",
    eyebrow: "CUSTOM / PROJECT",
    icon: "gear",
    description:
      "Bangun motor dari basis tertentu sampai mencapai target build score dan setup.",
  },
  {
    id: "WORK-05",
    name: "RESTORE",
    eyebrow: "CONDITION / VALUE",
    icon: "spark",
    description:
      "Naikkan kondisi unit secara bertahap untuk meningkatkan nilai dan kelayakan jual.",
  },
  {
    id: "WORK-06",
    name: "FINAL CHECK",
    eyebrow: "RACE / DELIVERY",
    icon: "check",
    description:
      "Pemeriksaan akhir untuk memastikan motor siap dikirim, dijual, atau turun balap.",
  },
];

const workshopMotor = {
  id: "MTR-002",
  name: "JATRA 135",
  brand: "JATRA",
  year: "2016",
  type: "UNDERBONE",
  condition: "WORN",
  status: "PROJECT",
  build: "RACE BUILD",
  value: 9200000,
  buildScore: 48,
  stats: {
    power: 58,
    acceleration: 52,
    grip: 46,
    reliability: 55,
  },
};

const parts = [
  {
    id: "PRT-001",
    name: "RACING CDI",
    category: "IGNITION",
    icon: "cdi",
    status: "READY",
    fit: "NUSA / JATRA",
  },
  {
    id: "PRT-002",
    name: "CARBURETOR PWK",
    category: "FUEL",
    icon: "carburetor",
    status: "READY",
    fit: "125–150 CC",
  },
  {
    id: "PRT-003",
    name: "RACING CAM",
    category: "ENGINE",
    icon: "cam",
    status: "READY",
    fit: "135–150 CC",
  },
  {
    id: "PRT-004",
    name: "LIGHTWEIGHT RIM",
    category: "WHEEL",
    icon: "wheel",
    status: "READY",
    fit: "UNDERBONE",
  },
];

const customerOrders = [
  {
    id: "ORD-014",
    customer: "PAK BUDI",
    motor: "RANA 150",
    type: "TUNE",
    budget: "Rp 850.000",
    target: "STREET SPEC",
    reward: 650000,
    status: "OPEN",
    icon: "bolt",
  },
  {
    id: "ORD-015",
    customer: "MAS DION",
    motor: "NUSA 125",
    type: "SERVICE",
    budget: "Rp 500.000",
    target: "BASIC SERVICE",
    reward: 350000,
    status: "OPEN",
    icon: "wrench",
  },
  {
    id: "ORD-016",
    customer: "OM RAKA",
    motor: "JATRA 110",
    type: "REPAIR",
    budget: "Rp 1.250.000",
    target: "RELIABILITY",
    reward: 900000,
    status: "LOCKED",
    icon: "hammer",
  },
];

const workshopLog = [
  {
    time: "14:21",
    action: "INSPECTION",
    motor: "NUSA 125",
    detail: "COMPLETE",
    icon: "search",
  },
  {
    time: "13:48",
    action: "PART INSTALLED",
    motor: "NUSA 125",
    detail: "RACING CDI",
    icon: "gear",
  },
  {
    time: "12:32",
    action: "SERVICE",
    motor: "NUSA 125",
    detail: "BASIC CHECK",
    icon: "wrench",
  },
  {
    time: "11:07",
    action: "MOTOR MOVED",
    motor: "JATRA 135",
    detail: "BENCH 01",
    icon: "motorcycle",
  },
];
---

<Layout
  title="BENGKEL — WORKSHOP"
  description="Kerjakan service, repair, tuning, dan build."
>
  <div class="page workshop-page">

    <div class="game-layout">

      <Navigation active="workshop" />

      <main class="main">

        <div class="main-inner workshop-main">


          <!-- =====================================================
               HEADER
          ===================================================== -->

          <header class="workshop-header">

            <div class="workshop-header-top">

              <div class="workshop-head-left">
                <span class="header-led"></span>
                <span>WORKSHOP_01</span>
              </div>

              <span class="workshop-head-center">
                GARAGE / WORK AREA / BENCH_01
              </span>

              <div class="workshop-head-right">
                <span class="pixel-icon pixel-icon--wrench pixel-icon--tiny"></span>
                ACTIVE
              </div>

            </div>


            <div class="workshop-header-body">

              <div class="workshop-header-copy">

                <div class="workshop-title-meta">

                  <span class="workshop-title-icon">
                    <span class="pixel-icon pixel-icon--wrench pixel-icon--small"></span>
                  </span>

                  <span class="eyebrow">
                    WORKSHOP CONTROL
                  </span>

                </div>


                <h1>
                  WORKSHOP
                </h1>


                <div class="workshop-title-line"></div>


                <p>
                  Tempat semua pekerjaan selesai.
                  Kerjakan order pelanggan, repair motor,
                  pasang parts, tuning setup, dan bangun unit
                  sampai sesuai target.
                </p>

              </div>


              <div class="workshop-console">

                <div class="console-title">

                  <span class="pixel-icon pixel-icon--toolbox pixel-icon--tiny"></span>

                  WORKSHOP CONSOLE

                </div>


                <div class="console-row">

                  <span>WORKBENCH</span>

                  <strong class="accent-text">
                    01 / 01
                  </strong>

                </div>


                <div class="console-row">

                  <span>ACTIVE JOB</span>

                  <strong>
                    01
                  </strong>

                </div>


                <div class="console-row">

                  <span>PART READY</span>

                  <strong>
                    04
                  </strong>

                </div>


                <div class="console-actions">

                  <Button
                    href="/motor"
                    variant="primary"
                  >
                    LIHAT MOTOR
                  </Button>

                  <Button href="/market">
                    CARI PART
                  </Button>

                </div>

              </div>

            </div>


            <div class="workshop-header-bottom">

              <span>
                SERVICE / REPAIR / TUNE / BUILD
              </span>

              <span>
                BENCH_01
              </span>

              <span class="system-online">
                <i></i>
                SYSTEM READY
              </span>

            </div>

          </header>



          <!-- =====================================================
               STATUS
          ===================================================== -->

          <section class="workshop-section">

            <div class="section-header">

              <div class="section-heading">

                <span class="section-marker"></span>

                <div>
                  <span class="section-kicker">
                    WORKSHOP OVERVIEW
                  </span>

                  <h2>
                    STATUS BENGKEL
                  </h2>
                </div>

              </div>

              <span class="section-code">
                01 / SYSTEM
              </span>

            </div>


            <div class="workshop-status-grid">

              {
                workshopStats.map((stat, index) => (
                  <article
                    class:list={[
                      "workshop-stat",
                      stat.active && "workshop-stat--active",
                    ]}
                  >

                    <div class="workshop-stat-top">

                      <div class="workshop-stat-ident">

                        <span class="workshop-stat-icon">

                          <span
                            class:list={[
                              "pixel-icon",
                              `pixel-icon--${stat.icon}`,
                              "pixel-icon--small",
                            ]}
                          ></span>

                        </span>

                        <span>
                          {stat.label}
                        </span>

                      </div>

                      <span>
                        {String(index + 1).padStart(2, "0")}
                      </span>

                    </div>


                    <strong>
                      {stat.value}
                    </strong>


                    <div class="workshop-stat-bottom">

                      <div class="workshop-stat-meter">

                        {Array.from({ length: 8 }).map((_, meterIndex) => (
                          <i
                            class:filled={
                              meterIndex < stat.fill
                            }
                          ></i>
                        ))}

                      </div>

                      <span>
                        {stat.detail}
                      </span>

                    </div>

                  </article>
                ))
              }

            </div>

          </section>



          <!-- =====================================================
               ACTIVE ORDER
          ===================================================== -->

          <section class="workshop-section">

            <div class="section-header">

              <div class="section-heading">

                <span class="section-marker section-marker--accent"></span>

                <div>
                  <span class="section-kicker">
                    CURRENT JOB
                  </span>

                  <h2>
                    PEKERJAAN AKTIF
                  </h2>
                </div>

              </div>

              <span class="section-code">
                {activeOrder.id}
              </span>

            </div>


            <article class="active-job">

              <div class="active-job-top">

                <div class="active-job-ticket">

                  <span class="active-job-icon">
                    <span class="pixel-icon pixel-icon--clipboard pixel-icon--small"></span>
                  </span>

                  <div>

                    <span>
                      {activeOrder.id}
                    </span>

                    <strong>
                      {activeOrder.type}
                    </strong>

                  </div>

                </div>


                <div class="job-running">

                  <i></i>

                  RUNNING

                </div>

              </div>


              <div class="active-job-body">

                <div class="active-job-bike">

                  <span class="active-job-bike-code">
                    CUSTOMER UNIT / NUSA_125
                  </span>


                  <div class="job-bike-cross"></div>


                  <div
                    class="pixel-motor pixel-motor--job"
                    aria-hidden="true"
                  >

                    <span class="pixel-motor__body"></span>
                    <span class="pixel-motor__tank"></span>
                    <span class="pixel-motor__seat"></span>
                    <span class="pixel-motor__frame"></span>
                    <span class="pixel-motor__engine"></span>
                    <span class="pixel-motor__pipe"></span>
                    <span class="pixel-motor__front"></span>
                    <span class="pixel-motor__rear"></span>
                    <span class="pixel-motor__wheel pixel-motor__wheel--rear"></span>
                    <span class="pixel-motor__wheel pixel-motor__wheel--front"></span>
                    <span class="pixel-motor__handle"></span>

                  </div>


                  <div class="job-bike-name">

                    <span>
                      NUSA
                    </span>

                    <strong>
                      125
                    </strong>

                  </div>


                  <span class="job-bike-floor"></span>

                </div>


                <div class="active-job-content">

                  <div class="active-job-heading">

                    <div>

                      <span class="section-kicker">
                        CUSTOMER SERVICE
                      </span>

                      <h3>
                        {activeOrder.customer}
                      </h3>

                    </div>


                    <div class="customer-job-type">

                      <span>
                        REQUEST
                      </span>

                      <strong>
                        {activeOrder.type}
                      </strong>

                    </div>

                  </div>


                  <p class="active-job-description">
                    {activeOrder.description}
                  </p>


                  <div class="job-step-list">

                    <div class="job-step job-step--done">

                      <span class="job-step-box">
                        ✓
                      </span>

                      <div>

                        <span>
                          01
                        </span>

                        <strong>
                          INSPECTION
                        </strong>

                        <small>
                          COMPLETED
                        </small>

                      </div>

                    </div>


                    <div class="job-step">

                      <span class="job-step-box">
                        02
                      </span>

                      <div>

                        <span>
                          02
                        </span>

                        <strong>
                          SERVICE
                        </strong>

                        <small>
                          CURRENT TASK
                        </small>

                      </div>

                    </div>


                    <div class="job-step">

                      <span class="job-step-box">
                        03
                      </span>

                      <div>

                        <span>
                          03
                        </span>

                        <strong>
                          FINAL CHECK
                        </strong>

                        <small>
                          WAITING
                        </small>

                      </div>

                    </div>

                  </div>


                  <div class="job-progress">

                    <div class="job-progress-head">

                      <span>
                        JOB PROGRESS
                      </span>

                      <strong>
                        {activeOrder.progress}%
                      </strong>

                    </div>


                    <div class="job-progress-track">
                      <i
                        style={`width:${activeOrder.progress}%`}
                      ></i>
                    </div>

                  </div>


                  <div class="active-job-footer">

                    <div>

                      <span>
                        CUSTOMER REWARD
                      </span>

                      <strong>
                        Rp {activeOrder.reward.toLocaleString("id-ID")}
                      </strong>

                    </div>


                    <div>

                      <span>
                        DEADLINE
                      </span>

                      <strong class="accent-text">
                        {activeOrder.deadline}
                      </strong>

                    </div>


                    <a
                      href="/workshop"
                      class="job-action"
                    >
                      OPEN WORK
                      <span>
                        →
                      </span>
                    </a>

                  </div>

                </div>

              </div>

            </article>

          </section>



          <!-- =====================================================
               WORK TYPES
          ===================================================== -->

          <section class="workshop-section">

            <div class="section-header">

              <div class="section-heading">

                <span class="section-marker"></span>

                <div>

                  <span class="section-kicker">
                    AVAILABLE WORK
                  </span>

                  <h2>
                    JENIS PEKERJAAN
                  </h2>

                </div>

              </div>

              <span class="section-code">
                06 TYPES
              </span>

            </div>


            <div class="work-types-grid">

              {
                workTypes.map((work, index) => (
                  <article
                    class:list={[
                      "work-type-card",
                      index === 4 && "work-type-card--featured",
                    ]}
                  >

                    <div class="work-type-top">

                      <span class="work-type-number">
                        {String(index + 1).padStart(2, "0")}
                      </span>

                      <span class="work-type-status">
                        AVAILABLE
                      </span>

                    </div>


                    <div class="work-type-icon">

                      <span
                        class:list={[
                          "pixel-icon",
                          `pixel-icon--${work.icon}`,
                          "pixel-icon--medium",
                        ]}
                      ></span>

                    </div>


                    <div class="work-type-content">

                      <span class="section-kicker">
                        {work.eyebrow}
                      </span>

                      <h3>
                        {work.name}
                      </h3>

                      <p>
                        {work.description}
                      </p>

                    </div>


                    <div class="work-type-footer">

                      <span>
                        {work.id}
                      </span>

                      <span>
                        OPEN →
                      </span>

                    </div>

                  </article>
                ))
              }

            </div>

          </section>



          <!-- =====================================================
               ACTIVE PROJECT
          ===================================================== -->

          <section class="workshop-section">

            <div class="section-header">

              <div class="section-heading">

                <span class="section-marker section-marker--accent"></span>

                <div>

                  <span class="section-kicker">
                    CURRENT PROJECT
                  </span>

                  <h2>
                    MOTOR DI WORKBENCH
                  </h2>

                </div>

              </div>

              <span class="section-code">
                {workshopMotor.id}
              </span>

            </div>


            <div class="project-layout">


              <!-- MOTOR -->

              <article class="project-motor-card">

                <div class="project-motor-top">

                  <div>

                    <span>
                      PROJECT_001
                    </span>

                    <strong>
                      {workshopMotor.status}
                    </strong>

                  </div>

                  <span>
                    BENCH_01
                  </span>

                </div>


                <div class="project-motor-art">

                  <div class="project-motor-grid"></div>


                  <div class="project-motor-frame"></div>


                  <div
                    class="pixel-motor pixel-motor--project"
                    aria-hidden="true"
                  >

                    <span class="pixel-motor__body"></span>
                    <span class="pixel-motor__tank"></span>
                    <span class="pixel-motor__seat"></span>
                    <span class="pixel-motor__frame"></span>
                    <span class="pixel-motor__engine"></span>
                    <span class="pixel-motor__pipe"></span>
                    <span class="pixel-motor__front"></span>
                    <span class="pixel-motor__rear"></span>
                    <span class="pixel-motor__wheel pixel-motor__wheel--rear"></span>
                    <span class="pixel-motor__wheel pixel-motor__wheel--front"></span>
                    <span class="pixel-motor__handle"></span>

                  </div>


                  <span class="project-motor-floor"></span>


                  <div class="project-motor-name">

                    <span>
                      {workshopMotor.brand}
                    </span>

                    <strong>
                      135
                    </strong>

                  </div>


                  <span class="project-motor-tag">
                    RACE BUILD
                  </span>

                </div>


                <div class="project-motor-info">

                  <span class="section-kicker">
                    {workshopMotor.brand} / {workshopMotor.year}
                  </span>

                  <h3>
                    {workshopMotor.name}
                  </h3>

                  <span>
                    {workshopMotor.type} / {workshopMotor.condition}
                  </span>

                </div>


                <div class="project-motor-actions">

                  <a
                    href="/motor?id=jatra-135"
                    class="retro-action retro-action--accent"
                  >
                    <span class="pixel-icon pixel-icon--search pixel-icon--tiny"></span>
                    OPEN MOTOR
                    <span>→</span>
                  </a>

                  <a
                    href="/market"
                    class="retro-action"
                  >
                    <span class="pixel-icon pixel-icon--gear pixel-icon--tiny"></span>
                    FIND PART
                    <span>→</span>
                  </a>

                </div>

              </article>



              <!-- TARGET -->

              <article class="project-target">

                <div class="project-target-head">

                  <div class="project-target-heading">

                    <span class="target-icon">
                      <span class="pixel-icon pixel-icon--flag pixel-icon--small"></span>
                    </span>

                    <div>

                      <span class="section-kicker">
                        BUILD TARGET
                      </span>

                      <h3>
                        RACE BUILD
                      </h3>

                    </div>

                  </div>

                  <span class="target-badge">
                    TARGET 70
                  </span>

                </div>


                <div class="target-main-score">

                  <div class="target-score-label">

                    <span>
                      CURRENT BUILD SCORE
                    </span>

                    <strong>
                      48 / 70
                    </strong>

                  </div>


                  <div class="target-track">

                    <i
                      style="width:68.57%"
                    ></i>

                  </div>


                  <div class="target-foot">

                    <span>
                      CURRENT
                    </span>

                    <strong>
                      +22 NEEDED
                    </strong>

                  </div>

                </div>


                <div class="project-checklist">

                  <div class="project-check project-check--done">

                    <span class="project-check-icon">
                      ✓
                    </span>

                    <div>

                      <span>
                        STEP 01
                      </span>

                      <strong>
                        MOTOR INSPECTION
                      </strong>

                      <small>
                        COMPLETED
                      </small>

                    </div>

                  </div>


                  <div class="project-check">

                    <span class="project-check-icon">
                      <span class="pixel-icon pixel-icon--gear pixel-icon--tiny"></span>
                    </span>

                    <div>

                      <span>
                        STEP 02
                      </span>

                      <strong>
                        ENGINE UPGRADE
                      </strong>

                      <small>
                        PERFORMANCE PART REQUIRED
                      </small>

                    </div>

                  </div>


                  <div class="project-check">

                    <span class="project-check-icon">
                      <span class="pixel-icon pixel-icon--bolt pixel-icon--tiny"></span>
                    </span>

                    <div>

                      <span>
                        STEP 03
                      </span>

                      <strong>
                        TUNE
                      </strong>

                      <small>
                        FINAL TUNING NOT SET
                      </small>

                    </div>

                  </div>


                  <div class="project-check">

                    <span class="project-check-icon">
                      <span class="pixel-icon pixel-icon--check pixel-icon--tiny"></span>
                    </span>

                    <div>

                      <span>
                        STEP 04
                      </span>

                      <strong>
                        FINAL TEST
                      </strong>

                      <small>
                        RACE READINESS CHECK
                      </small>

                    </div>

                  </div>

                </div>


                <div class="project-target-actions">

                  <Button
                    href="/motor?id=jatra-135"
                    variant="primary"
                  >
                    BUILD MOTOR
                  </Button>

                  <Button href="/market">
                    FIND PART
                  </Button>

                </div>

              </article>

            </div>

          </section>



          <!-- =====================================================
               PARTS
          ===================================================== -->

          <section class="workshop-section">

            <div class="section-header">

              <div class="section-heading">

                <span class="section-marker"></span>

                <div>

                  <span class="section-kicker">
                    WORKSHOP INVENTORY
                  </span>

                  <h2>
                    PART SIAP DIPASANG
                  </h2>

                </div>

              </div>

              <a
                href="/market"
                class="section-link"
              >
                SEMUA PART →
              </a>

            </div>


            <div class="workshop-parts-grid">

              {
                parts.map((part, index) => (
                  <article class="workshop-part-card">

                    <div class="workshop-part-top">

                      <span>
                        {part.id}
                      </span>

                      <span>
                        {part.status}
                      </span>

                    </div>


                    <div class="workshop-part-art">

                      <span class="part-art-label">
                        COMPONENT / {part.category}
                      </span>


                      <div
                        class:list={[
                          "part-pixel-object",
                          `part-pixel-object--${part.icon}`,
                        ]}
                        aria-hidden="true"
                      >

                        <span class="part-pixel-shadow"></span>
                        <span class="part-pixel-main"></span>
                        <span class="part-pixel-detail part-pixel-detail--1"></span>
                        <span class="part-pixel-detail part-pixel-detail--2"></span>
                        <span class="part-pixel-detail part-pixel-detail--3"></span>

                      </div>


                      <span class="part-art-index">
                        0{index + 1}
                      </span>

                    </div>


                    <div class="workshop-part-info">

                      <span class="section-kicker">
                        {part.category}
                      </span>

                      <h3>
                        {part.name}
                      </h3>

                      <span>
                        FIT / {part.fit}
                      </span>

                    </div>


                    <a
                      href="/market"
                      class="workshop-part-action"
                    >

                      <span class="pixel-icon pixel-icon--gear pixel-icon--tiny"></span>

                      <span>
                        PASANG
                      </span>

                      <span>
                        →
                      </span>

