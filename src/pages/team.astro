  color: var(--t-accent);

  border: 1px solid var(--t-accent-dark);

  background: var(--t-black-2);

}

.driver-heading h3 {

  margin-top: 4px;

  color: var(--t-white);

  font-family: var(--font-display);
  font-size: 1rem;
  font-weight: 900;

}

.driver-signed {

  padding: 5px 7px;

  color: var(--t-accent);

  border: 1px solid var(--t-accent-dark);

  font-family: var(--font-display);
  font-size: .4rem;
  font-weight: 900;

}

.driver-summary {

  display: grid;

  grid-template-columns:
    repeat(3,1fr);

  gap: 6px;

  margin-top: 15px;

}

.driver-summary-card {

  min-width: 0;

  padding: 10px;

  border: 1px solid var(--t-line);

  background: var(--t-black-2);

}

.driver-summary-card span,
.driver-summary-card small {

  display: block;

  color: var(--t-dim);

  font-family: var(--font-display);
  font-size: .34rem;
  font-weight: 900;

}

.driver-summary-card strong {

  display: block;

  margin-top: 5px;

  color: var(--t-white);

  font-family: var(--font-display);
  font-size: .63rem;
  font-weight: 900;

}

.driver-summary-card small {

  margin-top: 4px;

  color: var(--t-muted);

}

.skill-overview {

  margin-top: 17px;

  padding-top: 14px;

  border-top: 1px solid var(--t-line);

}

.skill-overview-head {

  display: flex;
  align-items: flex-end;
  justify-content: space-between;

  gap: 10px;

}

.skill-overview-head strong {

  display: block;

  margin-top: 4px;

  color: var(--t-white);

  font-family: var(--font-display);
  font-size: .58rem;
  font-weight: 900;

}

.skill-overview-head > span {

  color: var(--t-accent);

  font-family: var(--font-display);
  font-size: .42rem;
  font-weight: 900;

}

.skill-list {

  display: grid;

  gap: 7px;

  margin-top: 13px;

}

.skill-label {

  display: flex;
  align-items: center;
  justify-content: space-between;

  color: var(--t-dim);

  font-family: var(--font-display);
  font-size: .37rem;
  font-weight: 900;

}

.skill-label strong {

  color: var(--t-white);

}

.skill-track {

  height: 6px;

  margin-top: 4px;

  background: var(--t-black-2);

  border: 1px solid var(--t-line);

}

.skill-track i {

  height: 100%;

  display: block;

  background: var(--t-accent);

}

.driver-command-actions {

  display: grid;

  grid-template-columns:
    1fr
    1fr;

  gap: 7px;

  margin-top: 17px;

}

.driver-note {

  display: grid;

  grid-template-columns: 36px minmax(0,1fr);

  gap: 9px;

  margin-top: 15px;

  padding: 10px;

  border-left: 4px solid var(--t-accent);

  background: var(--t-black-2);

}

.driver-note-icon {

  width: 30px;
  height: 30px;

  display: grid;
  place-items: center;

  color: var(--t-accent);

  border: 1px solid var(--t-accent-dark);

}

.driver-note strong {

  color: var(--t-white);

  font-family: var(--font-display);
  font-size: .49rem;
  font-weight: 900;

}

.driver-note p {

  margin-top: 4px;

  color: var(--t-muted);

  font-size: .58rem;

  line-height: 1.5;

}


/* =============================================================
   DEVELOPMENT
   ============================================================= */

.development-panel {

  overflow: hidden;

  border: 2px solid var(--t-line);

  background: var(--t-panel);

  box-shadow:
    5px 5px 0 var(--t-black);

}

.development-main {

  display: flex;

  align-items: flex-end;
  justify-content: space-between;

  gap: 15px;

  padding: 17px;

  border-bottom: 1px solid var(--t-line);

  background: var(--t-black-2);

}

.development-level h3 {

  margin-top: 5px;

  color: var(--t-white);

  font-family: var(--font-display);
  font-size: 1.25rem;
  font-weight: 900;

}

.development-exp {

  text-align: right;

}

.development-exp strong {

  display: block;

  color: var(--t-accent);

  font-family: var(--font-display);
  font-size: 1.8rem;
  font-weight: 900;

  line-height: .8;

}

.development-exp span {

  color: var(--t-dim);

  font-family: var(--font-display);
  font-size: .36rem;
  font-weight: 900;

}

.development-track {

  padding: 15px 17px 0;

}

.development-track-top,
.development-track-bottom {

  display: flex;

  align-items: center;
  justify-content: space-between;

  gap: 10px;

  color: var(--t-dim);

  font-family: var(--font-display);
  font-size: .37rem;
  font-weight: 900;

}

.development-track-top strong {

  color: var(--t-white);

}

.development-progress {

  height: 10px;

  margin-top: 7px;

  border: 1px solid var(--t-line-light);

  background: var(--t-black-2);

}

.development-progress i {

  height: 100%;

  display: block;

  background: var(--t-accent);

}

.development-track-bottom {

  margin-top: 5px;

}

.development-track-bottom span:nth-child(2) {

  color: var(--t-accent);

}

.development-grid {

  display: grid;

  grid-template-columns:
    repeat(3,minmax(0,1fr));

  gap: 7px;

  padding: 17px;

}

.development-stat {

  padding: 10px;

  border: 1px solid var(--t-line);

  background: var(--t-black-2);

}

.development-stat-head {

  display: grid;

  grid-template-columns: 23px 1fr auto;

  align-items: center;

  gap: 6px;

}

.development-stat-icon {

  width: 22px;
  height: 22px;

  display: grid;
  place-items: center;

  border: 1px solid var(--t-line-light);

  color: var(--t-soft);

}

.development-stat-head > span:nth-child(2) {

  color: var(--t-dim);

  font-family: var(--font-display);
  font-size: .36rem;
  font-weight: 900;

}

.development-stat-head strong {

  color: var(--t-white);

  font-family: var(--font-display);
  font-size: .55rem;
  font-weight: 900;

}

.development-stat-track {

  height: 5px;

  margin-top: 8px;

  background: var(--t-panel-2);

}

.development-stat-track i {

  height: 100%;

  display: block;

  background: var(--t-accent-dark);

}

.development-stat-foot {

  display: flex;

  align-items: center;
  justify-content: space-between;

  margin-top: 5px;

  font-family: var(--font-display);
  font-size: .33rem;
  font-weight: 900;

}

.development-stat-foot span {

  color: var(--t-dim);

}

.development-stat-foot strong {

  color: var(--t-accent);

}

.development-footer {

  min-height: 46px;

  display: flex;
  align-items: center;
  justify-content: space-between;

  gap: 12px;

  padding: 0 17px;

  border-top: 1px solid var(--t-line);

}

.development-footer span {

  color: var(--t-dim);

  font-family: var(--font-display);
  font-size: .38rem;
  font-weight: 900;

}

.development-footer strong {

  color: var(--t-white);

  font-family: var(--font-display);
  font-size: .43rem;
  font-weight: 900;

}


/* =============================================================
   SCOUT
   ============================================================= */

.scout-grid {

  display: grid;

  grid-template-columns:
    repeat(3,minmax(0,1fr));

  gap: 10px;

}

.scout-card {

  overflow: hidden;

  background: var(--t-panel);

  border: 2px solid var(--t-line);

  box-shadow:
    4px 4px 0 var(--t-black);

  transition:
    transform 80ms steps(1),
    border-color 80ms steps(1);

}

.scout-card:hover {

  transform: translate(-2px,-2px);

  border-color: var(--t-line-light);

}

.scout-card--locked {

  opacity: .66;

}

.scout-top {

  min-height: 31px;

  display: flex;
  align-items: center;
  justify-content: space-between;

  padding: 0 9px;

  border-bottom: 2px solid var(--t-line);

  background: var(--t-black-2);

  color: var(--t-dim);

  font-family: var(--font-display);
  font-size: .37rem;
  font-weight: 900;

}

.scout-top span:last-child {

  color: var(--t-accent);

}

.scout-card--locked .scout-top span:last-child {

  color: var(--t-dim);

}

.scout-portrait {

  min-height: 175px;

  position: relative;

  display: grid;
  place-items: center;

  overflow: hidden;

  background:
    linear-gradient(
      90deg,
      transparent 49%,
      rgba(255,255,255,.03) 50%,
      transparent 51%
    ),
    #161816;

  background-size: 19px 19px;

}

.scout-head {

  width: 80px;
  height: 110px;

  position: relative;

}

.scout-head span {

  position: absolute;

  display: block;

}

.scout-face {

  left: 24px;
  top: 16px;

  width: 34px;
  height: 40px;

  background: #a8a8a0;

  border: 3px solid var(--t-black);

}

.scout-hair {

  left: 20px;
  top: 8px;

  width: 43px;
  height: 25px;

  background: var(--t-line-light);

  border: 3px solid var(--t-black);

}

.scout-visor {

  left: 24px;
  top: 25px;

  width: 34px;
  height: 9px;

  background: var(--t-black);

}

.scout-neck {

  left: 34px;
  top: 53px;

  width: 15px;
  height: 12px;

  background: #888880;

  border: 2px solid var(--t-black);

}

.scout-shirt {

  left: 10px;
  top: 62px;

  width: 60px;
  height: 47px;

  background: #292b29;

  border: 3px solid var(--t-black);

}

.scout-code {

  position: absolute;

  left: 9px;
  top: 9px;

  color: var(--t-dim);

  font-family: var(--font-display);
  font-size: .34rem;
  font-weight: 900;

}

.scout-specialty {

  position: absolute;

  right: 9px;
  top: 9px;

  padding: 4px 5px;

  border: 1px solid var(--t-accent-dark);

  color: var(--t-accent);

  background: var(--t-black-2);

  font-family: var(--font-display);
  font-size: .33rem;
  font-weight: 900;

}

.scout-info {

  padding: 12px;

}

.scout-info h3 {

  margin-top: 5px;

  color: var(--t-white);

  font-family: var(--font-display);
  font-size: .87rem;
  font-weight: 900;

  line-height: .95;

}

.scout-profile {

  display: grid;

  grid-template-columns:
    repeat(4,1fr);

  gap: 4px;

  margin-top: 11px;

}

.scout-profile > div {

  padding: 7px;

  border: 1px solid var(--t-line);

  background: var(--t-black-2);

}

.scout-profile span {

  display: block;

  color: var(--t-dim);

  font-family: var(--font-display);
  font-size: .32rem;
  font-weight: 900;

}

.scout-profile strong {

  display: block;

  margin-top: 4px;

  color: var(--t-white);

  font-family: var(--font-display);
  font-size: .55rem;
  font-weight: 900;

}

.scout-footer {

  display: flex;

  align-items: flex-end;
  justify-content: space-between;

  gap: 10px;

  margin-top: 12px;
  padding-top: 11px;

  border-top: 1px solid var(--t-line);

}

.scout-footer > div {

  display: flex;
  flex-direction: column;

  gap: 3px;

}

.scout-footer > div span {

  color: var(--t-dim);

  font-family: var(--font-display);
  font-size: .33rem;
  font-weight: 900;

}

.scout-footer strong {

  color: var(--t-white);

  font-family: var(--font-display);
  font-size: .62rem;
  font-weight: 900;

}

.scout-action {

  min-width: 80px;

  min-height: 34px;

  display: flex;
  align-items: center;
  justify-content: space-between;

  padding: 0 8px;

  border: 2px solid var(--t-accent-dark);

  color: var(--t-accent);

  background: var(--t-black-2);

  font-family: var(--font-display);
  font-size: .38rem;
  font-weight: 900;

  text-decoration: none;

}

.scout-action:hover {

  color: var(--t-black);

  background: var(--t-accent);

}

.scout-action--locked {

  border-color: var(--t-line);

  color: var(--t-dim);

  pointer-events: none;

}


/* =============================================================
   ROLES
   ============================================================= */

.roles-grid {

  display: grid;

  grid-template-columns:
    repeat(3,minmax(0,1fr));

  gap: 10px;

}

.role-card {

  min-height: 240px;

  display: flex;
  flex-direction: column;

  overflow: hidden;

  background: var(--t-panel);

  border: 2px solid var(--t-line);

  box-shadow:
    4px 4px 0 var(--t-black);

}

.role-card:hover {

  border-color: var(--t-line-light);

}

.role-top {

  min-height: 31px;

  display: flex;
  align-items: center;
  justify-content: space-between;

  padding: 0 9px;

  border-bottom: 2px solid var(--t-line);

  background: var(--t-black-2);

  color: var(--t-dim);

  font-family: var(--font-display);
  font-size: .37rem;
  font-weight: 900;

}

.role-top span:last-child {

  color: var(--t-accent);

}

.role-icon {

  width: 58px;
  height: 58px;

  display: grid;
  place-items: center;

  margin: 15px;

  border: 2px solid var(--t-line-light);

  color: var(--t-soft);

  background: var(--t-black-2);

  box-shadow:
    4px 4px 0 var(--t-black);

}

.role-content {

  padding: 0 15px;

}

.role-content h3 {

  margin-top: 5px;

  color: var(--t-white);

  font-family: var(--font-display);
  font-size: 1rem;
  font-weight: 900;

}

.role-content p {

  margin-top: 7px;

  color: var(--t-muted);

  font-size: .62rem;

  line-height: 1.55;

}

.role-footer {

  min-height: 37px;

  display: flex;
  align-items: center;
  justify-content: space-between;

  margin-top: auto;

  padding: 0 12px;

  border-top: 1px solid var(--t-line);

  color: var(--t-dim);

  font-family: var(--font-display);
  font-size: .37rem;
  font-weight: 900;

}

.role-footer strong {

  color: var(--t-accent);

}


/* =============================================================
   RACE HISTORY
   ============================================================= */

.race-history {

  overflow: hidden;

  background: var(--t-panel);

  border: 2px solid var(--t-line);

  box-shadow:
    5px 5px 0 var(--t-black);

}

.race-history-head {

  min-height: 59px;

  display: flex;

  align-items: center;
  justify-content: space-between;

  gap: 15px;

  padding: 9px 12px;

  border-bottom: 2px solid var(--t-line);

  background: var(--t-black-2);

}

.race-history-head > div {

  display: flex;

  align-items: center;

  gap: 8px;

}

.history-head-icon {

  width: 32px;
  height: 32px;

  display: grid;
  place-items: center;

  border: 1px solid var(--t-accent-dark);

  color: var(--t-accent);

}

.race-history-head strong {

  display: block;

  margin-top: 3px;

  color: var(--t-white);

  font-family: var(--font-display);
  font-size: .62rem;
  font-weight: 900;

}

.race-history-head > span {

  color: var(--t-dim);

  font-family: var(--font-display);
  font-size: .36rem;
  font-weight: 900;

}

.race-history-list {

  display: grid;

}

.race-history-row {

  min-height: 77px;

  display: grid;

  grid-template-columns:
    35px
    35px
    minmax(0,1fr)
    80px
    120px;

  align-items: center;

  gap: 10px;

  padding: 9px 12px;

  border-bottom: 1px solid var(--t-line);

}

.race-history-row:last-child {

  border-bottom: 0;

}

.race-history-row:hover {

  background: var(--t-panel-2);

}

.race-history-number {

  color: var(--t-dim);

  font-family: var(--font-display);
  font-size: .4rem;
  font-weight: 900;

}

.race-history-icon {

  width: 31px;
  height: 31px;

  display: grid;
  place-items: center;

  border: 1px solid var(--t-line-light);

  color: var(--t-soft);

}

.race-history-main {

  min-width: 0;

  display: flex;
  flex-direction: column;

  gap: 4px;

}

.race-history-main span {

  color: var(--t-dim);

  font-family: var(--font-display);
  font-size: .34rem;
  font-weight: 900;

}

.race-history-main strong {

  overflow: hidden;

  color: var(--t-white);

  font-family: var(--font-display);
  font-size: .52rem;
  font-weight: 900;

  text-overflow: ellipsis;
  white-space: nowrap;

}

.race-history-time {

  display: flex;
  flex-direction: column;

  gap: 3px;

}

.race-history-time span {

  color: var(--t-dim);

  font-family: var(--font-display);
  font-size: .33rem;
  font-weight: 900;

}

.race-history-time strong {

  color: var(--t-white);

  font-family: var(--font-display);
  font-size: .68rem;
  font-weight: 900;

}

.race-history-result {

  display: flex;
  flex-direction: column;

  gap: 3px;

  text-align: right;

}

.race-history-result span {

  color: var(--t-dim);

  font-family: var(--font-display);
  font-size: .33rem;
  font-weight: 900;

}

.race-history-result strong {

  color: var(--t-accent);

  font-family: var(--font-display);
  font-size: .45rem;
  font-weight: 900;

}


/* =============================================================
   TEAM RULE
   ============================================================= */

.team-rule {

  min-height: 220px;

  position: relative;

  display: grid;

  grid-template-columns:
    70px
    minmax(0,1fr)
    60px;

  align-items: center;

  gap: 20px;

  padding: 21px;

  overflow: hidden;

  border: 2px solid var(--t-line);

  background:
    repeating-linear-gradient(
      0deg,
      #191a17 0 5px,
      #161715 5px 10px
    );

  box-shadow:
    6px 6px 0 var(--t-black);

}

.team-rule::after {

  content: "TEAM";

  position: absolute;

  right: 14px;
  top: 3px;

  color: rgba(241,241,235,.035);

  font-family: var(--font-display);
  font-size: 7rem;
  font-weight: 900;

  line-height: 1;

}

.team-rule-icon {

  width: 66px;
  height: 66px;

  position: relative;
  z-index: 2;

  display: grid;
  place-items: center;

  background: var(--t-accent);

  border: 3px solid var(--t-black);

  color: var(--t-black);

  box-shadow:
    5px 5px 0 var(--t-black);

}

.team-rule-content {

  position: relative;

  z-index: 2;

}

.team-rule-content h2 {

  max-width: 780px;

  margin-top: 5px;

  color: var(--t-white);

  font-family: var(--font-display);
  font-size: clamp(1.6rem,3.1vw,2.5rem);
  font-weight: 900;

  line-height: .92;

}

.team-rule-content p {

  max-width: 790px;

  margin-top: 10px;

  color: var(--t-muted);

  font-size: var(--text-sm);

  line-height: 1.6;

}

.team-rule-stamp {

  position: relative;

  z-index: 3;

  width: 55px;
  height: 55px;

  display: flex;
  align-items: center;
  justify-content: center;

  flex-direction: column;

  border: 2px solid var(--t-accent-dark);

  color: var(--t-accent);

  font-family: var(--font-display);

  transform: rotate(4deg);

}

.team-rule-stamp span {

  font-size: .33rem;

}

.team-rule-stamp strong {

  font-size: 1rem;

}


/* =============================================================
   TEAM LOG
   ============================================================= */

.team-log {

  overflow: hidden;

  background: var(--t-panel);

  border: 2px solid var(--t-line);

  box-shadow:
    5px 5px 0 var(--t-black);

}

.team-log-head {

  min-height: 59px;

  display: flex;

  align-items: center;
  justify-content: space-between;

  gap: 15px;

  padding: 9px 12px;

  border-bottom: 2px solid var(--t-line);

  background: var(--t-black-2);

}

.team-log-head > div {

  display: flex;

  align-items: center;

  gap: 8px;

}

.team-log-icon {

  width: 32px;
  height: 32px;

  display: grid;
  place-items: center;

  border: 1px solid var(--t-accent-dark);

  color: var(--t-accent);

}

.team-log-head strong {

  color: var(--t-white);

  font-family: var(--font-display);
  font-size: .61rem;
  font-weight: 900;

}

.team-log-head > span {

  color: var(--t-dim);

  font-family: var(--font-display);
  font-size: .36rem;
  font-weight: 900;

}

.team-log-row {

  min-height: 69px;

  display: grid;

  grid-template-columns:
    35px
    58px
    32px
    minmax(0,1fr)
    90px;

  align-items: center;

  gap: 10px;

  padding: 9px 12px;

  border-bottom: 1px solid var(--t-line);

}

.team-log-row:last-child {

  border-bottom: 0;

}

.team-log-row:hover {

  background: var(--t-panel-2);

}

.team-log-number,
.team-log-time {

