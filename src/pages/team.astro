                }

              </div>

            </div>

          </section>



          <!-- =====================================================
               FOOTER
          ===================================================== -->

          <footer class="team-footer">

            <div class="footer-line"></div>

            <div class="footer-row">

              <div class="footer-brand">

                <span class="footer-brand-icon">
                  <span class="pixel-icon pixel-icon--helmet pixel-icon--small"></span>
                </span>

                <div>

                  <strong>
                    BENGKEL
                  </strong>

                  <span>
                    TEAM MANAGEMENT SYSTEM
                  </span>

                </div>

              </div>


              <span>
                DRIVER / RACE / DEVELOPMENT / HISTORY
              </span>


              <span class="footer-online">

                <i></i>

                SYSTEM ONLINE

              </span>

            </div>

          </footer>

        </div>

      </main>

    </div>

  </div>
</Layout>


<style>

/* =============================================================
   TOKENS
   ============================================================= */

.team-page {

  --t-black: #050505;
  --t-black-2: #090909;

  --t-panel: #101010;
  --t-panel-2: #151515;
  --t-panel-3: #1c1c1c;

  --t-line: #292929;
  --t-line-light: #3d3d3d;

  --t-white: #f1f1eb;
  --t-soft: #d0d0ca;

  --t-muted: #989892;
  --t-dim: #62625d;

  --t-accent: #b7d83c;
  --t-accent-dark: #687d27;

  --t-danger: #c65a51;

}


/* =============================================================
   BASE
   ============================================================= */

.team-main {

  min-width: 0;

}

.team-section {

  margin-top: 42px;

}

.section-header {

  min-height: 55px;

  display: flex;
  align-items: center;
  justify-content: space-between;

  gap: 15px;

  margin-bottom: 10px;

  border-bottom: 2px solid var(--t-line);

}

.section-heading {

  display: flex;
  align-items: center;

  gap: 11px;

}

.section-marker {

  width: 8px;
  height: 8px;

  flex: 0 0 auto;

  background: var(--t-white);

  box-shadow:
    4px 4px 0 var(--t-line-light);

}

.section-marker--accent {

  background: var(--t-accent);

  box-shadow:
    4px 4px 0 var(--t-accent-dark);

}

.section-kicker {

  display: block;

  color: var(--t-dim);

  font-family: var(--font-display);
  font-size: .51rem;
  font-weight: 900;

  letter-spacing: .1em;

  text-transform: uppercase;

}

.section-header h2 {

  margin-top: 4px;

  color: var(--t-white);

  font-family: var(--font-display);
  font-size: clamp(1.35rem,3vw,2rem);
  font-weight: 900;

  line-height: .9;

  letter-spacing: -.04em;

  text-transform: uppercase;

}

.section-code {

  color: var(--t-dim);

  font-family: var(--font-display);
  font-size: .44rem;
  font-weight: 900;

  letter-spacing: .08em;

  text-transform: uppercase;

}

.eyebrow {

  color: var(--t-dim);

  font-family: var(--font-display);
  font-size: .53rem;
  font-weight: 900;

  letter-spacing: .1em;

  text-transform: uppercase;

}

.accent-text {

  color: var(--t-accent) !important;

}


/* =============================================================
   PIXEL ICON SYSTEM
   ============================================================= */

.pixel-icon {

  position: relative;

  display: block;

  width: 18px;
  height: 18px;

  color: currentColor;

  image-rendering: pixelated;

}

.pixel-icon::before,
.pixel-icon::after {

  content: "";

  position: absolute;

  display: block;

}

.pixel-icon--tiny {

  width: 10px;
  height: 10px;

}

.pixel-icon--small {

  width: 18px;
  height: 18px;

}

.pixel-icon--medium {

  width: 30px;
  height: 30px;

}


/* HELMET */

.pixel-icon--helmet::before {

  left: 2px;
  top: 3px;

  width: 14px;
  height: 10px;

  border: 2px solid currentColor;

  border-bottom: 0;

}

.pixel-icon--helmet::after {

  left: 7px;
  top: 10px;

  width: 9px;
  height: 5px;

  background: currentColor;

}


/* FLAG */

.pixel-icon--flag::before {

  left: 3px;
  top: 1px;

  width: 3px;
  height: 17px;

  background: currentColor;

}

.pixel-icon--flag::after {

  left: 6px;
  top: 2px;

  width: 10px;
  height: 8px;

  background: currentColor;

  clip-path:
    polygon(
      0 0,
      100% 0,
      75% 50%,
      100% 100%,
      0 100%
    );

}


/* TROPHY */

.pixel-icon--trophy::before {

  left: 5px;
  top: 2px;

  width: 8px;
  height: 10px;

  border: 2px solid currentColor;

  border-bottom: 0;

}

.pixel-icon--trophy::after {

  left: 4px;
  bottom: 2px;

  width: 10px;
  height: 3px;

  background: currentColor;

  box-shadow:
    3px -3px 0 -1px currentColor,
    1px 3px 0 currentColor;

}


/* CHART */

.pixel-icon--chart::before {

  left: 2px;
  bottom: 2px;

  width: 3px;
  height: 7px;

  background: currentColor;

  box-shadow:
    5px -3px 0 currentColor,
    10px -7px 0 currentColor;

}

.pixel-icon--chart::after {

  left: 2px;
  bottom: 1px;

  width: 14px;
  height: 2px;

  background: currentColor;

}


/* BOLT */

.pixel-icon--bolt::before {

  left: 6px;
  top: 0;

  width: 8px;
  height: 18px;

  background: currentColor;

  clip-path:
    polygon(
      40% 0,
      100% 0,
      64% 42%,
      100% 42%,
      18% 100%,
      38% 57%,
      0 57%
    );

}


/* STEERING */

.pixel-icon--steering::before {

  left: 2px;
  top: 3px;

  width: 14px;
  height: 10px;

  border: 3px solid currentColor;

  border-radius: 50%;

}

.pixel-icon--steering::after {

  left: 8px;
  top: 9px;

  width: 3px;
  height: 7px;

  background: currentColor;

}


/* TARGET */

.pixel-icon--target::before {

  left: 2px;
  top: 2px;

  width: 14px;
  height: 14px;

  border: 2px solid currentColor;

  border-radius: 50%;

}

.pixel-icon--target::after {

  left: 7px;
  top: 7px;

  width: 4px;
  height: 4px;

  background: currentColor;

}


/* DOCUMENT */

.pixel-icon--document::before {

  left: 3px;
  top: 2px;

  width: 12px;
  height: 15px;

  border: 2px solid currentColor;

}

.pixel-icon--document::after {

  left: 6px;
  top: 7px;

  width: 6px;
  height: 2px;

  background: currentColor;

  box-shadow:
    0 4px 0 currentColor;

}


/* =============================================================
   HEADER
   ============================================================= */

.team-header {

  overflow: hidden;

  background: var(--t-panel);

  border: 2px solid var(--t-line-light);

  box-shadow:
