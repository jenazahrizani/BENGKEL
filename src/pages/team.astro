---
import Layout from "../components/Layout.astro";
import "../styles/global.css";
import Button from "../components/Button.astro";
import Navigation from "../components/Navigation.astro";

const teamStats = [
  {
    label: "JOKI",
    value: "01 / 01",
    detail: "SIGNED",
    icon: "helmet",
    fill: 7,
    active: true,
  },
  {
    label: "RACE",
    value: "07",
    detail: "TOTAL RACE",
    icon: "flag",
    fill: 6,
  },
  {
    label: "WIN",
    value: "02",
    detail: "CAREER WIN",
    icon: "trophy",
    fill: 3,
  },
  {
    label: "TEAM EXP",
    value: "68%",
    detail: "LEVEL 3",
    icon: "chart",
    fill: 5,
  },
];

const mainDriver = {
  id: "DRV-001",
  name: 'BIMO "KILAT"',
  nickname: "KILAT",
  age: 21,
  specialty: "CONSISTENCY",
  level: 3,
  exp: 68,
  raceFee: 250000,
  status: "SIGNED",
  stats: {
    skill: 72,
    consistency: 86,
    launch: 78,
    control: 69,
    nerve: 74,
    experience: 68,
  },
  wins: 2,
  races: 7,
};

const development = [
  {
    label: "SKILL",
    current: 72,
    next: 80,
    icon: "target",
  },
  {
    label: "CONSISTENCY",
    current: 86,
    next: 90,
    icon: "chart",
  },
  {
    label: "LAUNCH",
    current: 78,
    next: 85,
    icon: "bolt",
  },
  {
    label: "CONTROL",
    current: 69,
    next: 78,
    icon: "steering",
  },
  {
    label: "NERVE",
    current: 74,
    next: 82,
    icon: "helmet",
  },
  {
    label: "EXPERIENCE",
    current: 68,
    next: 75,
    icon: "flag",
  },
];

const availableDrivers = [
  {
    id: "DRV-002",
    name: 'RIZAL "TANGAN BESI"',
    nickname: "TANGAN BESI",
    level: 2,
    age: 24,
    specialty: "LAUNCH",
    raceFee: 180000,
    skill: 64,
    consistency: 58,
    launch: 82,
    nerve: 77,
    status: "AVAILABLE",
  },
  {
    id: "DRV-003",
    name: 'DANU "PENDEK"',
    nickname: "PENDEK",
    level: 2,
    age: 19,
    specialty: "CONTROL",
    raceFee: 150000,
    skill: 61,
    consistency: 71,
    launch: 67,
    nerve: 65,
    status: "AVAILABLE",
  },
  {
    id: "DRV-004",
    name: 'REZA "KABEL"',
    nickname: "KABEL",
    level: 1,
    age: 20,
    specialty: "AGGRESSIVE",
    raceFee: 120000,
    skill: 55,
    consistency: 49,
    launch: 76,
    nerve: 84,
    status: "LOCKED",
  },
];

const teamRoles = [
  {
    title: "CONSISTENT",
    stat: "CONTROL",
    icon: "chart",
    description:
      "Joki dengan performa lebih stabil. Cocok untuk mengejar catatan waktu dan menjaga hasil race.",
  },
  {
    title: "LAUNCHER",
    stat: "START",
    icon: "bolt",
    description:
      "Spesialis start agresif. Nilai launch tinggi membantu mendapatkan posisi awal.",
  },
  {
    title: "HOT HEAD",
    stat: "NERVE",
    icon: "helmet",
    description:
      "Berani mengambil risiko ketika tekanan tinggi. Potensi besar, tetapi hasil bisa lebih fluktuatif.",
  },
];

const driverHistory = [
  {
    event: "ABIANSEMAL NIGHT RUN",
    class: "UNDER 125",
    result: "1ST PLACE",
    time: "08.42",
    status: "WIN",
    icon: "trophy",
  },
  {
    event: "MENGWI STREET CUP",
    class: "UNDER 150",
    result: "2ND PLACE",
    time: "08.67",
    status: "PODIUM",
    icon: "flag",
  },
  {
    event: "KUTA TEST NIGHT",
    class: "UNDER 125",
    result: "4TH PLACE",
    time: "08.91",
    status: "FINISH",
    icon: "flag",
  },
  {
    event: "BADUNG OPEN RUN",
    class: "UNDER 125",
    result: "1ST PLACE",
    time: "08.31",
    status: "WIN",
    icon: "trophy",
  },
];

const teamLog = [
  {
    time: "22:14",
    action: "RACE WIN",
    detail: "ABIANSEMAL NIGHT RUN",
    icon: "trophy",
  },
  {
    time: "20:41",
    action: "DRIVER ASSIGNED",
    detail: "BIMO / NUSA 125",
    icon: "helmet",
  },
  {
    time: "18:32",
    action: "LEVEL UP",
    detail: "LEVEL 02 → LEVEL 03",
    icon: "chart",
  },
  {
    time: "16:07",
    action: "CONTRACT",
    detail: "BIMO / RENEWED",
    icon: "document",
  },
];
---

<Layout
  title="BENGKEL — TEAM"
  description="Kelola joki dan sejarah tim."
>
  <div class="page team-page">

    <div class="game-layout">

      <Navigation active="team" />

      <main class="main">

        <div class="main-inner team-main">


          <!-- =====================================================
               HEADER
          ===================================================== -->

          <header class="team-header">

            <div class="team-header-top">

              <div class="team-head-left">
                <span class="header-led"></span>
                <span>TEAM_01</span>
              </div>

              <span class="team-head-center">
                GARAGE / TEAM / DRIVER ROOM
              </span>

              <div class="team-head-right">
                <span class="pixel-icon pixel-icon--helmet pixel-icon--tiny"></span>
                ACTIVE
              </div>

            </div>


            <div class="team-header-body">

              <div class="team-header-copy">

                <div class="team-title-meta">

                  <span class="team-title-icon">
                    <span class="pixel-icon pixel-icon--helmet pixel-icon--small"></span>
                  </span>

                  <span class="eyebrow">
                    DRIVER MANAGEMENT
                  </span>

                </div>


                <h1>
                  TEAM
                </h1>


                <div class="team-title-line"></div>


                <p>
                  Joki bukan sekadar biaya race.
                  Pilih karakter yang cocok dengan motor,
                  kembangkan skill, tentukan role, lalu
                  bangun sejarah tim dari satu lintasan ke
                  lintasan berikutnya.
                </p>

              </div>


              <div class="team-console">

                <div class="console-title">

                  <span class="pixel-icon pixel-icon--helmet pixel-icon--tiny"></span>

                  TEAM CONSOLE

                </div>


                <div class="console-row">

                  <span>DRIVER</span>

                  <strong class="accent-text">
                    01 / 01
                  </strong>

                </div>


                <div class="console-row">

                  <span>LEVEL</span>

                  <strong>
                    LV. 03
                  </strong>

                </div>


                <div class="console-row">

                  <span>CAREER WIN</span>

                  <strong>
                    02
                  </strong>

                </div>


                <div class="console-actions">

                  <Button
                    href="/race"
                    variant="primary"
                  >
                    SIAPKAN RACE
                  </Button>

                  <Button href="/garage">
                    GARASI
                  </Button>

                </div>

              </div>

            </div>


            <div class="team-header-bottom">

              <span>
                DRIVER / DEVELOPMENT / RACE / HISTORY
              </span>

              <span>
                DRIVER_SLOT 01
              </span>

              <span class="system-online">
                <i></i>
                TEAM READY
              </span>

            </div>

          </header>



          <!-- =====================================================
               TEAM STATUS
          ===================================================== -->

          <section class="team-section">

            <div class="section-header">

              <div class="section-heading">

                <span class="section-marker"></span>

                <div>

                  <span class="section-kicker">
                    TEAM OVERVIEW
                  </span>

                  <h2>
                    STATUS TIM
                  </h2>

                </div>

              </div>

              <span class="section-code">
                01 / TEAM
              </span>

            </div>


            <div class="team-status-grid">

              {
                teamStats.map((stat, index) => (
                  <article
                    class:list={[
                      "team-stat",
                      stat.active && "team-stat--active",
                    ]}
                  >

                    <div class="team-stat-top">

                      <div class="team-stat-ident">

                        <span class="team-stat-icon">

                          <span
                            class:list={[
                              "pixel-icon",
                              `pixel-icon--${stat.icon}`,
                              "pixel-icon--small",
                            ]}
                          ></span>

                        </span>

                        <span>
                          {stat.label}
                        </span>

                      </div>

                      <span>
                        {String(index + 1).padStart(2, "0")}
                      </span>

                    </div>


                    <strong>
                      {stat.value}
                    </strong>


                    <div class="team-stat-bottom">

                      <div class="team-stat-meter">

                        {Array.from({ length: 8 }).map((_, meterIndex) => (
                          <i
                            class:filled={
                              meterIndex < Math.ceil(stat.fill * .8)
                            }
                          ></i>
                        ))}

                      </div>

                      <span>
                        {stat.detail}
                      </span>

                    </div>

                  </article>
                ))
              }

            </div>

          </section>



          <!-- =====================================================
               MAIN DRIVER
          ===================================================== -->

          <section class="team-section">

            <div class="section-header">

              <div class="section-heading">

                <span class="section-marker section-marker--accent"></span>

                <div>

                  <span class="section-kicker">
                    ACTIVE DRIVER
                  </span>

                  <h2>
                    JOKI UTAMA
                  </h2>

                </div>

              </div>

              <span class="section-code">
                {mainDriver.id}
              </span>

            </div>


            <div class="driver-main">


              <!-- DRIVER PORTRAIT -->

              <article class="driver-card">

                <div class="driver-card-top">

                  <div>

                    <span>
                      {mainDriver.id}
                    </span>

                    <strong>
                      SIGNED
                    </strong>

                  </div>

                  <span>
                    LV. {mainDriver.level}
                  </span>

                </div>


                <div class="driver-portrait">

                  <div class="portrait-grid"></div>

                  <div class="portrait-frame">

                    <div class="pixel-driver">

                      <span class="driver-head"></span>
                      <span class="driver-helmet"></span>
                      <span class="driver-visor"></span>
                      <span class="driver-neck"></span>
                      <span class="driver-body"></span>
                      <span class="driver-arm driver-arm--left"></span>
                      <span class="driver-arm driver-arm--right"></span>

                    </div>

                  </div>


                  <span class="portrait-code">
                    DRIVER / PROFILE_01
                  </span>

                  <span class="portrait-bottom">
                    BIMO / KILAT
                  </span>

                  <span class="portrait-role">
                    CONSISTENCY
                  </span>

                </div>


                <div class="driver-card-info">

                  <span class="section-kicker">
                    MAIN DRIVER
                  </span>

                  <h3>
                    {mainDriver.name}
                  </h3>

                  <div class="driver-subline">

                    <span>
                      AGE {mainDriver.age}
                    </span>

                    <span>
                      / 
                    </span>

                    <strong>
                      {mainDriver.specialty}
                    </strong>

                  </div>

                </div>


                <div class="driver-mini-stats">

                  <div>
                    <span>SKILL</span>
                    <strong>{mainDriver.stats.skill}</strong>
                  </div>

                  <div>
                    <span>CONSIST.</span>
                    <strong>{mainDriver.stats.consistency}</strong>
                  </div>

                  <div>
                    <span>LAUNCH</span>
                    <strong>{mainDriver.stats.launch}</strong>
                  </div>

                  <div>
                    <span>NERVE</span>
                    <strong>{mainDriver.stats.nerve}</strong>
                  </div>

                </div>

              </article>



              <!-- DRIVER COMMAND -->

              <article class="driver-command">

                <div class="driver-command-head">

                  <div class="driver-heading">

                    <span class="driver-command-icon">
                      <span class="pixel-icon pixel-icon--helmet pixel-icon--small"></span>
                    </span>

                    <div>

                      <span class="section-kicker">
                        DRIVER PROFILE
                      </span>

                      <h3>
                        PROFILE / KILAT
                      </h3>

                    </div>

                  </div>


                  <span class="driver-signed">
                    SIGNED
                  </span>

                </div>


                <div class="driver-summary">

                  <div class="driver-summary-card">

                    <span>
                      SPECIALTY
                    </span>

                    <strong>
                      {mainDriver.specialty}
                    </strong>

                    <small>
                      STABLE RUNS
                    </small>

                  </div>


                  <div class="driver-summary-card">

                    <span>
                      RACE FEE
                    </span>

                    <strong>
                      Rp {mainDriver.raceFee.toLocaleString("id-ID")}
                    </strong>

                    <small>
                      PER RACE
                    </small>

                  </div>


                  <div class="driver-summary-card">

                    <span>
                      CAREER
                    </span>

                    <strong>
                      {mainDriver.wins} W / {mainDriver.races} R
                    </strong>

                    <small>
                      CURRENT RECORD
                    </small>

                  </div>

                </div>


                <div class="skill-overview">

                  <div class="skill-overview-head">

                    <div>

                      <span class="section-kicker">
                        DRIVER PERFORMANCE
                      </span>

                      <strong>
                        PERFORMANCE PROFILE
                      </strong>

                    </div>

                    <span>
                      LV. {mainDriver.level}
                    </span>

                  </div>


                  <div class="skill-list">

                    {
                      Object.entries(mainDriver.stats).map(([label, value]) => (
                        <div class="skill-row">

                          <div class="skill-label">

                            <span>
                              {label === "acceleration"
                                ? "LAUNCH"
                                : label}
                            </span>

                            <strong>
                              {value}
                            </strong>

                          </div>

                          <div class="skill-track">

                            <i
                              style={`width:${value}%`}
                            ></i>

                          </div>

                        </div>
                      ))
                    }

                  </div>

                </div>


                <div class="driver-command-actions">

                  <Button
                    href="/race"
                    variant="primary"
                  >
                    ASSIGN TO RACE
                  </Button>

                  <Button href="/team">
                    VIEW HISTORY
                  </Button>

                </div>


                <div class="driver-note">

                  <span class="driver-note-icon">
                    <span class="pixel-icon pixel-icon--chart pixel-icon--small"></span>
                  </span>

                  <div>

                    <strong>
                      KONSISTEN ADALAH SENJATA
                    </strong>

                    <p>
                      Joki dengan consistency tinggi
                      cenderung menghasilkan performa yang
                      lebih dekat dengan kemampuan dasarnya.
                    </p>

                  </div>

                </div>

              </article>

            </div>

          </section>



          <!-- =====================================================
               DEVELOPMENT
          ===================================================== -->

          <section class="team-section">

            <div class="section-header">

              <div class="section-heading">

                <span class="section-marker"></span>

                <div>

                  <span class="section-kicker">
                    DEVELOPMENT
                  </span>

                  <h2>
                    PERKEMBANGAN JOKI
                  </h2>

                </div>

              </div>

              <span class="section-code">
                EXP 68%
              </span>

            </div>


            <article class="development-panel">

              <div class="development-main">

                <div class="development-level">

                  <span class="section-kicker">
                    NEXT LEVEL
                  </span>

                  <h3>
                    LEVEL {mainDriver.level} → {mainDriver.level + 1}
                  </h3>

                </div>


                <div class="development-exp">

                  <strong>
                    {mainDriver.exp}%
                  </strong>

                  <span>
                    EXPERIENCE
                  </span>

                </div>

              </div>


              <div class="development-track">

                <div class="development-track-top">

                  <span>
                    EXPERIENCE TO NEXT LEVEL
                  </span>

                  <strong>
                    {mainDriver.exp} / 100
                  </strong>

                </div>

                <div class="development-progress">

                  <i
                    style={`width:${mainDriver.exp}%`}
                  ></i>

                </div>

                <div class="development-track-bottom">

                  <span>
                    LEVEL {mainDriver.level}
                  </span>

                  <span>
                    32% TO GO
                  </span>

                  <span>
                    LEVEL {mainDriver.level + 1}
                  </span>

                </div>

              </div>


              <div class="development-grid">

                {
                  development.map((stat) => (
                    <article class="development-stat">

                      <div class="development-stat-head">

                        <span class="development-stat-icon">

                          <span
                            class:list={[
                              "pixel-icon",
                              `pixel-icon--${stat.icon}`,
                              "pixel-icon--tiny",
                            ]}
                          ></span>

                        </span>

                        <span>
                          {stat.label}
                        </span>

                        <strong>
                          {stat.current}
                        </strong>

                      </div>


                      <div class="development-stat-track">

                        <i
                          style={`width:${stat.current}%`}
                        ></i>

                      </div>


                      <div class="development-stat-foot">

                        <span>
                          CURRENT
                        </span>

                        <strong>
                          NEXT {stat.next}
                        </strong>

                      </div>

                    </article>
                  ))
                }

              </div>


              <div class="development-footer">

                <span>
                  DEVELOPMENT METHOD
                </span>

                <strong>
                  RACE / EXPERIENCE / WINS
                </strong>

              </div>

            </article>

          </section>



          <!-- =====================================================
               SCOUT
          ===================================================== -->

          <section class="team-section">

            <div class="section-header">

              <div class="section-heading">

                <span class="section-marker section-marker--accent"></span>

                <div>

                  <span class="section-kicker">
                    DRIVER SCOUT
                  </span>

                  <h2>
                    JOKI TERSEDIA
                  </h2>

                </div>

              </div>

              <span class="section-code">
                03 CANDIDATES
              </span>

            </div>


            <div class="scout-grid">

              {
                availableDrivers.map((driver, index) => (
                  <article
                    class:list={[
                      "scout-card",
                      driver.status === "LOCKED" &&
                        "scout-card--locked",
                    ]}
                  >

                    <div class="scout-top">

                      <span>
                        {driver.id}
                      </span>

                      <span>
                        {driver.status}
                      </span>

                    </div>


                    <div class="scout-portrait">

                      <div class="scout-head">
                        <span class="scout-face"></span>
                        <span class="scout-hair"></span>
                        <span class="scout-visor"></span>
                        <span class="scout-neck"></span>
                        <span class="scout-shirt"></span>
                      </div>

                      <span class="scout-code">
                        SCOUT / 0{index + 1}
                      </span>

                      <span class="scout-specialty">
                        {driver.specialty}
                      </span>

                    </div>


                    <div class="scout-info">

                      <span class="section-kicker">
                        LEVEL {driver.level} / AGE {driver.age}
                      </span>

                      <h3>
                        {driver.name}
                      </h3>


                      <div class="scout-profile">

                        <div>

                          <span>
                            SKILL
                          </span>

                          <strong>
                            {driver.skill}
                          </strong>

                        </div>

                        <div>

                          <span>
                            CONSIST.
                          </span>

                          <strong>
                            {driver.consistency}
                          </strong>

                        </div>

                        <div>

                          <span>
                            LAUNCH
                          </span>

                          <strong>
                            {driver.launch}
                          </strong>

                        </div>

                        <div>

                          <span>
                            NERVE
                          </span>

                          <strong>
                            {driver.nerve}
                          </strong>

                        </div>

                      </div>


                      <div class="scout-footer">

                        <div>

                          <span>
                            RACE FEE
                          </span>

                          <strong>
                            Rp {driver.raceFee.toLocaleString("id-ID")}
                          </strong>

                        </div>

                        <a
                          href="/team"
                          class:list={[
                            "scout-action",
                            driver.status === "LOCKED" &&
                              "scout-action--locked",
                          ]}
                        >
                          {driver.status === "LOCKED"
                            ? "LOCKED"
                            : "SCOUT"}

                          <span>
                            →
                          </span>

                        </a>

                      </div>

                    </div>

                  </article>
                ))
              }

            </div>

          </section>



          <!-- =====================================================
               ROLES
          ===================================================== -->

          <section class="team-section">

            <div class="section-header">

              <div class="section-heading">

                <span class="section-marker"></span>

                <div>

                  <span class="section-kicker">
                    DRIVER TYPES
                  </span>

                  <h2>
                    GAYA BERMAIN JOKI
                  </h2>

                </div>

              </div>

              <span class="section-code">
                ROLE / 03
              </span>

            </div>


            <div class="roles-grid">

              {
                teamRoles.map((role, index) => (
                  <article class="role-card">

                    <div class="role-top">

                      <span>
                        ROLE_{String(index + 1).padStart(2, "0")}
                      </span>

                      <span>
                        {role.stat}
                      </span>

                    </div>


                    <div class="role-icon">

                      <span
                        class:list={[
                          "pixel-icon",
                          `pixel-icon--${role.icon}`,
                          "pixel-icon--medium",
                        ]}
                      ></span>

                    </div>


                    <div class="role-content">

                      <span class="section-kicker">
                        DRIVER STYLE
                      </span>

                      <h3>
                        {role.title}
                      </h3>

                      <p>
                        {role.description}
                      </p>

                    </div>


                    <div class="role-footer">

                      <span>
                        {role.stat}
                      </span>

                      <strong>
                        SELECT →
                      </strong>

                    </div>

                  </article>
                ))
              }

            </div>

          </section>



          <!-- =====================================================
               HISTORY
          ===================================================== -->

          <section class="team-section">

            <div class="section-header">

              <div class="section-heading">

                <span class="section-marker"></span>

                <div>

                  <span class="section-kicker">
                    DRIVER HISTORY
                  </span>

                  <h2>
                    RIWAYAT BALAP
                  </h2>

                </div>

              </div>

              <span class="section-code">
                BIMO / KILAT
              </span>

            </div>


            <div class="race-history">

              <div class="race-history-head">

                <div>

                  <span class="history-head-icon">
                    <span class="pixel-icon pixel-icon--flag pixel-icon--small"></span>
                  </span>

                  <div>

                    <span class="section-kicker">
                      RACE LOG
                    </span>

                    <strong>
                      CAREER HISTORY
                    </strong>

                  </div>

                </div>


                <span>
                  2 WINS / 7 RACE
                </span>

              </div>


              <div class="race-history-list">

                {
                  driverHistory.map((race, index) => (
                    <article class="race-history-row">

                      <span class="race-history-number">
                        {String(index + 1).padStart(2, "0")}
                      </span>


                      <span class="race-history-icon">

                        <span
                          class:list={[
                            "pixel-icon",
                            `pixel-icon--${race.icon}`,
                            "pixel-icon--small",
                          ]}
                        ></span>

                      </span>


                      <div class="race-history-main">

                        <span>
                          {race.class}
                        </span>

                        <strong>
                          {race.event}
                        </strong>

                      </div>


                      <div class="race-history-time">

