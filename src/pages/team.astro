                        <span>
                          {race.status}
                        </span>

                        <strong>
                          {race.result}
                        </strong>

                      </div>

                    </article>
                  ))
                }

              </div>

            </div>

          </section>



          <!-- =====================================================
               TEAM PRINCIPLE
          ===================================================== -->

          <section class="team-section">

            <article class="team-rule">

              <div class="team-rule-icon">

                <span class="pixel-icon pixel-icon--helmet pixel-icon--medium"></span>

              </div>


              <div class="team-rule-content">

                <span class="section-kicker">
                  TEAM PRINCIPLE
                </span>

                <h2>
                  JOKI ADALAH BAGIAN
                  DARI SEJARAH GARASI
                </h2>

                <p>
                  Setiap joki punya perkembangan, kemenangan,
                  kekalahan, gaya mengemudi, dan catatan sendiri.
                  Bahkan setelah dilepas atau berhenti balap,
                  sejarahnya tetap menjadi bagian dari legacy garasi.
                </p>

              </div>


              <div class="team-rule-stamp">

                <span>
                  TEAM
                </span>

                <strong>
                  01
                </strong>

              </div>

            </article>

          </section>



          <!-- =====================================================
               TEAM LOG
          ===================================================== -->

          <section class="team-section">

            <div class="section-header">

              <div class="section-heading">

                <span class="section-marker"></span>

                <div>

                  <span class="section-kicker">
                    TEAM HISTORY
                  </span>

                  <h2>
                    LOG TIM
                  </h2>

                </div>

              </div>

              <span class="section-code">
                RECENT / 04
              </span>

            </div>


            <div class="team-log">

              <div class="team-log-head">

                <div>

                  <span class="team-log-icon">
                    <span class="pixel-icon pixel-icon--document pixel-icon--small"></span>
                  </span>

                  <strong>
                    RECENT TEAM ACTIVITY
                  </strong>

                </div>

                <span>
                  LIVE LOG
                </span>

              </div>


              <div class="team-log-list">

                {
                  teamLog.map((log, index) => (
                    <div class="team-log-row">

                      <span class="team-log-number">
                        {String(index + 1).padStart(2, "0")}
                      </span>

                      <span class="team-log-time">
                        {log.time}
                      </span>

                      <span class="team-log-symbol">

                        <span
                          class:list={[
                            "pixel-icon",
                            `pixel-icon--${log.icon}`,
                            "pixel-icon--small",
                          ]}
                        ></span>

                      </span>

                      <div class="team-log-main">

                        <strong>
                          {log.action}
                        </strong>

                        <span>
                          {log.detail}
                        </span>

                      </div>

                      <span class="team-log-status">
                        COMPLETE
                      </span>

                    </div>
