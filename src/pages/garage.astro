  display: flex;
  flex-direction: column;
  justify-content: space-between;

  padding: 13px;

  border-right: 2px solid var(--g-line);
  border-bottom: 2px solid var(--g-line);

  background: var(--g-panel);
}

.status-card--active {
  background: var(--g-panel-2);

  border-top: 3px solid var(--g-accent);
}

.status-card-head,
.status-card-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;

  gap: 8px;

  color: var(--g-dim);

  font-family: var(--font-display);
  font-size: .45rem;
  font-weight: 900;

  text-transform: uppercase;
}

.status-card-ident {
  display: flex;
  align-items: center;
  gap: 7px;
}

.status-icon {
  width: 25px;
  height: 25px;

  display: grid;
  place-items: center;

  border: 1px solid var(--g-line-light);

  color: var(--g-soft);
}

.status-card--active .status-icon {
  color: var(--g-accent);
  border-color: var(--g-accent-dark);
}

.status-card-value {
  color: var(--g-white);

  font-family: var(--font-display);
  font-size: 2rem;
  font-weight: 900;

  line-height: .8;
}

.segment-bar {
  display: grid;

  grid-template-columns: repeat(8,1fr);

  flex: 1;

  gap: 3px;
}

.segment-bar i {
  height: 4px;

  background: var(--g-line-light);
}

.segment-bar .segment-active {
  background: var(--g-accent-dark);
}

.status-card--active .segment-bar .segment-active {
  background: var(--g-accent);
}


/* =============================================================
   FLOOR
   ============================================================= */

.floor {
  overflow: hidden;

  background: var(--g-panel);

  border: 2px solid var(--g-line-light);

  box-shadow:
    8px 8px 0 var(--g-black);
}

.floor-topbar,
.floor-bottombar {
  min-height: 32px;

  display: flex;
  align-items: center;
  justify-content: space-between;

  gap: 12px;

  padding: 0 11px;

  color: var(--g-dim);

  background: var(--g-black-2);

  font-family: var(--font-display);
  font-size: .44rem;
  font-weight: 900;

  letter-spacing: .08em;

  text-transform: uppercase;
}

.floor-topbar {
  border-bottom: 2px solid var(--g-line);
}

.floor-bottombar {
  border-top: 2px solid var(--g-line);
}

.floor-top-left,
.floor-online {
  display: flex;
  align-items: center;
  gap: 7px;
}

.floor-body {
  position: relative;

  overflow: hidden;

  background: #151715;
}

.floor-grid {
  position: absolute;
  inset: 0;

  opacity: .35;

  background-image:
    linear-gradient(var(--g-line) 1px, transparent 1px),
    linear-gradient(90deg, var(--g-line) 1px, transparent 1px);

  background-size: 34px 34px;
}

.floor-ambient {
  position: absolute;

  border-radius: 50%;

  background: var(--g-accent);

  opacity: .035;

  filter: blur(28px);
}

.floor-ambient--one {
  width: 180px;
  height: 180px;

  top: 20px;
  left: 9%;
}

.floor-ambient--two {
  width: 160px;
  height: 160px;

  bottom: 10px;
  right: 7%;
}

.floor-watermark {
  position: absolute;

  top: 0;
  right: 18px;

  color: rgba(241,241,235,.025);

  font-family: var(--font-display);
  font-size: 10rem;
  font-weight: 900;

  line-height: 1;
}

.floor-bays {
  position: relative;
  z-index: 2;

  display: grid;

  grid-template-columns:
    repeat(3,minmax(0,1fr));

  gap: 10px;

  padding: 17px;
}


/* =============================================================
   BAY
   ============================================================= */

.bay {
  min-width: 0;
  min-height: 470px;

  display: flex;
  flex-direction: column;

  overflow: hidden;

  background:
    rgba(7,7,7,.95);

  border: 2px solid var(--g-line-light);

  box-shadow:
    4px 4px 0 var(--g-black);
}

.bay--empty {
  border-style: dashed;
}

.bay-header {
  min-height: 54px;

  display: flex;
  align-items: center;
  justify-content: space-between;

  gap: 10px;

  padding: 8px 10px;

  border-bottom: 2px solid var(--g-line);

  background: var(--g-black-2);
}

.bay-header-main {
  min-width: 0;

  display: flex;
  flex-direction: column;

  gap: 4px;
}

.bay-index {
  color: var(--g-dim);

  font-family: var(--font-display);
  font-size: .41rem;
  font-weight: 900;
}

.bay-name-row {
  display: flex;
  align-items: center;
  gap: 7px;
}

.bay-name-row strong {
  color: var(--g-white);

  font-family: var(--font-display);
  font-size: .76rem;
  font-weight: 900;

  line-height: .9;

  white-space: nowrap;
}

.mini-bike-dot {
  width: 20px;
  height: 20px;

  display: grid;
  place-items: center;

  border: 1px solid var(--g-line-light);

  color: var(--g-accent);
}

.mini-bike-dot--empty {
  color: var(--g-dim);
}

.bay-state {
  color: var(--g-accent);

  font-family: var(--font-display);
  font-size: .43rem;
  font-weight: 900;
}

.bay-state--dim {
  color: var(--g-dim);
}


/* =============================================================
   BAY MOTOR DISPLAY
   ============================================================= */

.bay-display {
  position: relative;

  min-height: 250px;

  flex: 1;

  display: grid;
  place-items: center;

  overflow: hidden;

  background:
    linear-gradient(
      135deg,
      #191b19 25%,
      #151715 25%,
      #151715 50%,
      #191b19 50%,
      #191b19 75%,
      #151715 75%
    );

  background-size: 22px 22px;
}

.display-grid {
  position: absolute;
  inset: 0;

  opacity: .55;

  background-image:
    linear-gradient(
      rgba(241,241,235,.03) 1px,
      transparent 1px
    ),
    linear-gradient(
      90deg,
      rgba(241,241,235,.03) 1px,
      transparent 1px
    );

  background-size: 23px 23px;
}

.display-cross {
  position: absolute;

  width: 145px;
  height: 145px;

  border: 1px solid rgba(183,216,60,.15);
}

.display-cross::before,
.display-cross::after {
  content: "";

  position: absolute;

  background: rgba(183,216,60,.13);
}

.display-cross::before {
  top: -15px;
  bottom: -15px;
  left: 50%;

  width: 1px;
}

.display-cross::after {
  left: -15px;
  right: -15px;
  top: 50%;

  height: 1px;
}

.display-target {
  position: absolute;

  width: 172px;
  height: 172px;

  border: 1px dashed rgba(241,241,235,.09);
}

.pixel-motor {
  position: relative;

  width: 190px;
  height: 108px;

  color: var(--g-white);

  image-rendering: pixelated;
}

.pixel-motor span {
  position: absolute;
  display: block;
}

.pixel-motor__wheel {
  width: 42px;
  height: 42px;

  bottom: 6px;

  border: 6px solid var(--g-black);

  background: transparent;

  box-shadow:
    inset 0 0 0 4px var(--g-soft);
}

.pixel-motor__wheel::after {
  content: "";

  position: absolute;

  left: 12px;
  top: 12px;

  width: 6px;
  height: 6px;

  background: var(--g-black);
}

.pixel-motor__wheel--rear {
  left: 17px;
}

.pixel-motor__wheel--front {
  right: 17px;
}

.pixel-motor__body {
  left: 41px;
  top: 43px;

  width: 94px;
  height: 19px;

  background: var(--g-accent);

  clip-path:
    polygon(
      0 30%,
      18% 30%,
      28% 0,
      55% 0,
      67% 30%,
      100% 30%,
      100% 100%,
      0 100%
    );
}

.pixel-motor__tank {
  left: 73px;
  top: 27px;

  width: 38px;
  height: 18px;

  background: var(--g-white);

  clip-path:
    polygon(
      0 0,
      76% 0,
      100% 36%,
      82% 100%,
      18% 100%
    );
}

.pixel-motor__seat {
  left: 51px;
  top: 24px;

  width: 31px;
  height: 9px;

  background: var(--g-black);
}

.pixel-motor__frame {
  left: 66px;
  top: 44px;

  width: 44px;
  height: 33px;

  border-left: 5px solid var(--g-black);
  border-bottom: 5px solid var(--g-black);

  transform: skew(-17deg);
}

.pixel-motor__engine {
  left: 76px;
  top: 49px;

  width: 29px;
  height: 22px;

  background: var(--g-line-light);

  border: 3px solid var(--g-black);
}

.pixel-motor__engine::after {
  content: "";

  position: absolute;

  left: 6px;
  top: 6px;

  width: 10px;
  height: 4px;

  background: var(--g-soft);

  box-shadow:
    0 6px 0 var(--g-soft);
}

.pixel-motor__pipe {
  left: 103px;
  top: 68px;

  width: 38px;
  height: 5px;

  border-bottom: 4px solid var(--g-soft);

  transform: rotate(-5deg);
}

.pixel-motor__front {
  right: 38px;
  top: 41px;

  width: 6px;
  height: 34px;

  background: var(--g-black);

  transform: rotate(-8deg);
}

.pixel-motor__rear {
  left: 44px;
  top: 47px;

  width: 5px;
  height: 26px;

  background: var(--g-black);
}

.pixel-motor__handle {
  right: 23px;
  top: 27px;

  width: 26px;
  height: 5px;

  background: var(--g-black);

  transform: rotate(-20deg);
}

.pixel-motor__handle::after {
  content: "";

  position: absolute;

  right: 2px;
  top: -6px;

  width: 5px;
  height: 14px;

  background: var(--g-black);
}

.pixel-motor--large {
  z-index: 3;

  transform: scale(1.28);

  filter:
    drop-shadow(5px 5px 0 var(--g-black));
}

.pixel-motor--inventory {
  transform: scale(1.48);

  filter:
    drop-shadow(6px 6px 0 var(--g-black));
}

.pixel-motor--job {
  transform: scale(.88);

  filter:
    drop-shadow(5px 5px 0 var(--g-black));
}


/* =============================================================
   BAY MOTOR DETAILS
   ============================================================= */

.display-bike-info {
  position: absolute;

  left: 12px;
  top: 12px;

  display: flex;
  align-items: baseline;

  gap: 5px;

  z-index: 5;

  font-family: var(--font-display);
  text-transform: uppercase;
}

.display-bike-info span {
  position: static;

  color: var(--g-muted);

  font-size: .4rem;
  font-weight: 900;
}

.display-bike-info strong {
  color: var(--g-white);

  font-size: .82rem;
  font-weight: 900;
}

.display-tech {
  position: absolute;

  right: 12px;
  top: 12px;

  display: grid;

  grid-template-columns: auto auto;

  gap: 4px 7px;

  z-index: 5;

  text-align: right;

  font-family: var(--font-display);
}

.display-tech span {
  position: static;

  color: var(--g-dim);

  font-size: .37rem;
  font-weight: 900;
}

.display-tech strong {
  position: static;

  color: var(--g-white);

  font-size: .42rem;
  font-weight: 900;
}

.display-floor-line {
  position: absolute;

  left: 13%;
  right: 13%;
  bottom: 23px;

  height: 3px;

  background: var(--g-accent);

  box-shadow:
    0 5px 0 var(--g-black);

  z-index: 5;
}

.display-scan-line {
  position: absolute;

  left: 16px;
  right: 16px;
  top: 40%;

  height: 1px;

  background: rgba(183,216,60,.12);

  z-index: 4;
}

.bay-spec-strip {
  display: grid;

  grid-template-columns: repeat(4,1fr);

  border-top: 1px solid var(--g-line);

  background: var(--g-panel);
}

.bay-spec-strip > div {
  padding: 7px 8px;

  border-right: 1px solid var(--g-line);
}

.bay-spec-strip > div:last-child {
  border-right: 0;
}

.bay-spec-strip span,
.bay-spec-strip strong {
  display: block;
}

.bay-spec-strip span {
  color: var(--g-dim);

  font-family: var(--font-display);
  font-size: .35rem;
  font-weight: 900;
}

.bay-spec-strip strong {
  margin-top: 4px;

  color: var(--g-white);

  font-family: var(--font-display);
  font-size: .65rem;
  font-weight: 900;
}


/* =============================================================
   EMPTY BAY
   ============================================================= */

.empty-display {
  min-height: 285px;

  flex: 1;

  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;

  gap: 10px;

  background:
    repeating-linear-gradient(
      135deg,
      #141614 0 9px,
      #111311 9px 18px
    );
}

.empty-frame {
  width: 108px;
  height: 108px;

  position: relative;

  display: grid;
  place-items: center;

  border: 1px dashed var(--g-line-light);
}

.empty-corner {
  position: absolute;

  width: 13px;
  height: 13px;

  border-color: var(--g-line-light);
}

.empty-corner--tl {
  top: -1px;
  left: -1px;

  border-left: 2px solid;
  border-top: 2px solid;
}

.empty-corner--tr {
  top: -1px;
  right: -1px;

  border-right: 2px solid;
  border-top: 2px solid;
}

.empty-corner--bl {
  bottom: -1px;
  left: -1px;

  border-left: 2px solid;
  border-bottom: 2px solid;
}

.empty-corner--br {
  right: -1px;
  bottom: -1px;

  border-right: 2px solid;
  border-bottom: 2px solid;
}

.empty-cross {
  position: absolute;

  inset: 20px;

  border: 1px solid rgba(241,241,235,.07);
}

.empty-cross::before,
.empty-cross::after {
  content: "";

  position: absolute;

  background: var(--g-line-light);
}

.empty-cross::before {
  left: 50%;
  top: 18px;
  bottom: 18px;

  width: 2px;

  transform: translateX(-50%);
}

.empty-cross::after {
  left: 18px;
  right: 18px;
  top: 50%;

  height: 2px;

  transform: translateY(-50%);
}

.empty-slot-icon {
  position: relative;
  z-index: 2;

  color: var(--g-dim);
}

.empty-display strong {
  color: var(--g-white);

  font-family: var(--font-display);
  font-size: .8rem;
  font-weight: 900;
}

.empty-display > span {
  color: var(--g-dim);

  font-family: var(--font-display);
  font-size: .41rem;
  font-weight: 900;

  letter-spacing: .08em;
}

.bay-empty-note {
  display: flex;
  align-items: center;
  justify-content: space-between;

  padding: 8px 10px;

  border-top: 1px solid var(--g-line);

  background: var(--g-panel);
}

.bay-empty-note span {
  color: var(--g-dim);

  font-family: var(--font-display);
  font-size: .38rem;
  font-weight: 900;
}

.bay-empty-note strong {
  color: var(--g-accent);

  font-family: var(--font-display);
  font-size: .45rem;
  font-weight: 900;
}


/* =============================================================
   WORKBENCH
   ============================================================= */

.workbench-display {
  min-height: 322px;

  position: relative;

  flex: 1;

  overflow: hidden;

  background:
    linear-gradient(
      #141614 0 64%,
      #101210 64%
    );
}

.bench-wall {
  position: absolute;

  top: 0;
  left: 0;
  right: 0;

  height: 66%;

  background:
    linear-gradient(
      rgba(255,255,255,.025) 1px,
      transparent 1px
    ),
    linear-gradient(
      90deg,
      rgba(255,255,255,.025) 1px,
      transparent 1px
    );

  background-size: 16px 16px;
}

.pegboard {
  position: absolute;

  top: 19px;
  left: 18px;
  right: 18px;

  height: 112px;

  overflow: hidden;

  border: 2px solid var(--g-line);

  background:
    radial-gradient(
      circle,
      #323532 0 2px,
      transparent 2px
    );

  background-size: 14px 14px;
}

.pegboard span {
  position: absolute;

  display: block;

  width: 4px;

  background: var(--g-soft);
}

.pegboard span:nth-child(1) {
  left: 11%;
  top: 30px;
  height: 22px;
}

.pegboard span:nth-child(2) {
  left: 23%;
  top: 17px;
  height: 30px;
}

.pegboard span:nth-child(3) {
  left: 34%;
  top: 36px;
  height: 19px;
}

.pegboard span:nth-child(4) {
  left: 44%;
  top: 21px;
  height: 26px;
}

.pegboard span:nth-child(5) {
  left: 54%;
  top: 34px;
  height: 20px;
}

.pegboard span:nth-child(6) {
  left: 65%;
  top: 18px;
  height: 30px;
}

.pegboard span:nth-child(7) {
  left: 75%;
  top: 29px;
  height: 23px;
}

.pegboard span:nth-child(8) {
  left: 84%;
  top: 16px;
  height: 31px;
}

.pegboard span:nth-child(9) {
  left: 30%;
  top: 76px;
  height: 18px;
  background: var(--g-accent);
}

.pegboard span:nth-child(10) {
  left: 49%;
  top: 77px;
  height: 20px;
}

.pegboard span:nth-child(11) {
  left: 66%;
  top: 72px;
  height: 24px;
}

.pegboard span:nth-child(12) {
  left: 78%;
  top: 75px;
  height: 18px;
}

.bench-sign {
  position: absolute;

  top: 139px;
  left: 18px;

  color: var(--g-dim);

  font-family: var(--font-display);
  font-size: .39rem;
  font-weight: 900;
}

.workbench {
  position: absolute;

  left: 17px;
  right: 17px;
  bottom: 41px;

  height: 118px;
}

.workbench-top {
  position: absolute;

  left: 0;
  right: 0;
  top: 14px;

  height: 12px;

  background: #3c403d;

  border: 3px solid var(--g-black);

  box-shadow:
    0 6px 0 var(--g-black);
}

.workbench-leg {
  position: absolute;

  top: 26px;

  width: 9px;
  height: 82px;

  background: #272a27;

  border: 2px solid var(--g-black);
}

.workbench-leg--left {
  left: 13px;
}

.workbench-leg--right {
  right: 13px;
}

.toolbox {
  position: absolute;

  left: 31px;
  top: 39px;

  width: 64px;
  height: 37px;

  display: flex;
  align-items: center;
  justify-content: space-evenly;

  background: #2d302d;

  border: 3px solid var(--g-black);
}

.toolbox i {
  width: 9px;
  height: 9px;

  border: 2px solid var(--g-soft);
}

.toolbox i:nth-child(2) {
  background: var(--g-accent);
  border-color: var(--g-accent);
}

.tool {
  position: absolute;

  display: block;

  background: var(--g-soft);

  border: 2px solid var(--g-black);
}

.tool--wrench {
  left: 31%;
  top: -3px;

  width: 5px;
  height: 22px;

  transform: rotate(32deg);
}

.tool--hammer {
  left: 48%;
  top: -5px;

  width: 5px;
  height: 25px;

  transform: rotate(-22deg);
}

.tool--driver {
  right: 31%;
  top: -2px;

  width: 5px;
  height: 20px;

  background: var(--g-accent);
}

.tool--meter {
  right: 17%;
  top: 0;

  width: 18px;
  height: 6px;
}

.bench-drawer {
  position: absolute;

  top: 47px;

  width: 45px;
  height: 9px;

  background: #232623;

  border: 2px solid var(--g-black);
}

.bench-drawer--1 {
  left: 39%;
}

.bench-drawer--2 {
  left: 58%;
}

.bench-floor-light {
  position: absolute;

  left: 17%;
  right: 17%;
  bottom: 26px;

  height: 3px;

  background: var(--g-line-light);

  box-shadow:
    0 5px 0 var(--g-black);
}

.workbench-label {
  position: absolute;

  left: 17px;
  bottom: 9px;

  display: flex;
  align-items: center;
  gap: 7px;

  color: var(--g-dim);

  font-family: var(--font-display);
  font-size: .4rem;
  font-weight: 900;

  text-transform: uppercase;
}


/* =============================================================
   BAY FOOTER
   ============================================================= */

.bay-footer {
  min-height: 70px;

  display: flex;
  align-items: center;
  justify-content: space-between;

  gap: 10px;

  padding: 10px;

  border-top: 2px solid var(--g-line);

  background: var(--g-black-2);
}

.bay-footer-status {
  min-width: 0;

  display: flex;
  flex-direction: column;

  gap: 4px;
}

.bay-footer-status span {
  color: var(--g-dim);

  font-family: var(--font-display);
  font-size: .4rem;
  font-weight: 900;
}

.bay-footer-status strong {
  color: var(--g-white);

  font-family: var(--font-display);
  font-size: .68rem;
  font-weight: 900;
}


/* =============================================================
   RETRO BUTTON
   ============================================================= */

.retro-button {
  min-height: 31px;

  display: inline-flex;
  align-items: center;
  justify-content: center;

  padding: 0 10px;

  border: 2px solid var(--g-line-light);

  background: var(--g-panel-2);

  box-shadow:
    3px 3px 0 var(--g-black);

  color: var(--g-white);

  font-family: var(--font-display);
  font-size: .42rem;
  font-weight: 900;

  letter-spacing: .05em;

  text-decoration: none;
  text-transform: uppercase;

  transition:
    transform 70ms steps(1),
    box-shadow 70ms steps(1),
    border-color 70ms steps(1),
    color 70ms steps(1);
}

.retro-button:hover {
  transform: translate(2px,2px);

  box-shadow:
    1px 1px 0 var(--g-black);

  border-color: var(--g-accent-dark);

  color: var(--g-accent);
}

.retro-button--accent {
  border-color: var(--g-accent-dark);
  color: var(--g-accent);
}

.retro-button--wide {
  width: 100%;
  gap: 8px;
}


/* =============================================================
   INVENTORY
   ============================================================= */

.inventory-grid {
  display: grid;

  grid-template-columns:
    minmax(0,1.5fr)
    minmax(240px,.7fr);

  gap: 10px;
}

.garage-motor-card {
  min-width: 0;

  display: flex;
  flex-direction: column;

  overflow: hidden;

  border: 2px solid var(--g-line-light);

  background: var(--g-panel);

  box-shadow:
    6px 6px 0 var(--g-black);
}

.garage-motor-card-top {
  min-height: 32px;

  display: flex;
  align-items: center;
  justify-content: space-between;

  padding: 0 10px;

  border-bottom: 2px solid var(--g-line);

  background: var(--g-black-2);

  font-family: var(--font-display);
  font-size: .41rem;
  font-weight: 900;
}

.garage-motor-id,
.garage-motor-status {
  display: flex;
  align-items: center;
  gap: 7px;
}

.garage-motor-id {
  color: var(--g-dim);
}

.garage-motor-status {
  color: var(--g-accent);
}

.accent-number {
  color: var(--g-accent);
}

.garage-motor-art {
  min-height: 255px;

  position: relative;

  display: grid;
  place-items: center;

  overflow: hidden;

  background:
    linear-gradient(
      90deg,
      transparent 49%,
      rgba(255,255,255,.035) 50%,
      transparent 51%
    ),
    linear-gradient(
      transparent 49%,
      rgba(255,255,255,.035) 50%,
      transparent 51%
    ),
    #171917;

  background-size: 22px 22px;
}

.garage-motor-art-code {
  position: absolute;

  left: 11px;
  top: 11px;

  color: var(--g-dim);

  font-family: var(--font-display);
  font-size: .38rem;
  font-weight: 900;

  z-index: 6;
}

.garage-motor-art-corner {
  width: 18px;
  height: 18px;

  position: absolute;

  z-index: 6;
}

.garage-motor-art-corner--tl {
  top: 10px;
  left: 10px;

  border-top: 2px solid var(--g-accent);
  border-left: 2px solid var(--g-accent);
}

.garage-motor-art-corner--tr {
  top: 10px;
  right: 10px;

  border-top: 2px solid var(--g-accent);
  border-right: 2px solid var(--g-accent);
}

.garage-motor-art-corner--bl {
  bottom: 10px;
  left: 10px;

  border-bottom: 2px solid var(--g-accent);
  border-left: 2px solid var(--g-accent);
}

.garage-motor-art-corner--br {
  right: 10px;
  bottom: 10px;

  border-bottom: 2px solid var(--g-accent);
  border-right: 2px solid var(--g-accent);
}

.garage-motor-ground {
  position: absolute;

  left: 13%;
  right: 13%;
  bottom: 30px;

  height: 5px;

  background: var(--g-line-light);

  box-shadow:
    0 5px 0 var(--g-black);
}

.garage-motor-art-type {
  position: absolute;

  right: 11px;
  bottom: 12px;

  color: rgba(241,241,235,.34);

  font-family: var(--font-display);
  font-size: .37rem;
  font-weight: 900;

  z-index: 6;
}

.garage-motor-info {
  padding: 14px;
}

.garage-motor-title {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;

  gap: 12px;

  padding-bottom: 13px;

  border-bottom: 1px solid var(--g-line);
}

.garage-motor-title h3 {
  margin-top: 5px;

  color: var(--g-white);

  font-family: var(--font-display);
  font-size: 1.35rem;
  font-weight: 900;

  line-height: .9;

  text-transform: uppercase;
}

.garage-motor-title > div > span:last-child {
  display: block;

  margin-top: 6px;

  color: var(--g-dim);

  font-family: var(--font-display);
  font-size: .41rem;
  font-weight: 900;
}

.motor-condition {
  padding: 5px 6px;

  color: var(--g-muted);

  border: 1px solid var(--g-line-light);

  font-family: var(--font-display);
  font-size: .4rem;
  font-weight: 900;
}

.garage-motor-stats {
  display: grid;

  grid-template-columns: repeat(4,1fr);

  gap: 5px;

  margin-top: 13px;
}

.garage-motor-stats > div {
  padding: 8px;

  border: 1px solid var(--g-line);

  background: var(--g-black-2);
}

.garage-motor-stats span {
  color: var(--g-dim);

  font-family: var(--font-display);
  font-size: .36rem;
  font-weight: 900;
}

.garage-motor-stats strong {
  display: block;

  margin-top: 4px;

  color: var(--g-white);

  font-family: var(--font-display);
  font-size: .72rem;
  font-weight: 900;
}

.garage-motor-finance {
  display: flex;

  align-items: flex-end;
  justify-content: space-between;

  margin-top: 14px;
  padding-top: 12px;

  border-top: 1px solid var(--g-line);
}

.garage-motor-finance > div {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.garage-motor-finance span {
  color: var(--g-dim);

  font-family: var(--font-display);
  font-size: .4rem;
  font-weight: 900;
}

.garage-motor-finance strong {
  color: var(--g-white);

  font-family: var(--font-display);
  font-size: .9rem;
  font-weight: 900;
}

.garage-motor-finance > div:last-child {
  align-items: flex-end;
}

.garage-motor-actions {
  display: grid;

  grid-template-columns: 1fr 1fr;

  gap: 6px;

  padding: 0 10px 10px;
}

.motor-action {
  min-height: 37px;

  display: grid;

  grid-template-columns: 16px 1fr 14px;

  align-items: center;

  gap: 6px;

  padding: 0 8px;

  border: 2px solid var(--g-line);

  color: var(--g-muted);

  background: var(--g-black-2);

  font-family: var(--font-display);
  font-size: .4rem;
  font-weight: 900;

  text-decoration: none;
  text-transform: uppercase;
}

.motor-action:hover {
  color: var(--g-accent);
  border-color: var(--g-accent-dark);
}

.motor-action--primary {
  color: var(--g-accent);
  border-color: var(--g-accent-dark);
}

.motor-action > span:last-child {
  text-align: right;
}

.inventory-empty {
  min-height: 360px;

  display: flex;
  flex-direction: column;

  padding: 14px;

  border: 2px dashed var(--g-line-light);

  background: var(--g-panel);

  box-shadow:
    5px 5px 0 var(--g-black);
}

.inventory-empty-top {
  display: flex;
  align-items: center;
  justify-content: space-between;

  color: var(--g-dim);

  font-family: var(--font-display);
  font-size: .42rem;
  font-weight: 900;
}

.inventory-empty-top > div {
  display: flex;
  align-items: center;
  gap: 7px;
}

.inventory-empty-art {
  min-height: 125px;

  position: relative;

  display: grid;
  place-items: center;

  margin-top: 12px;

  border: 1px dashed var(--g-line);

  background:
    linear-gradient(
      90deg,
      transparent 49%,
      rgba(255,255,255,.025) 50%,
      transparent 51%
    ),
    linear-gradient(
      transparent 49%,
      rgba(255,255,255,.025) 50%,
      transparent 51%
    );

  background-size: 18px 18px;
}

.inventory-cross {
  position: absolute;

  width: 90px;
  height: 90px;

  border: 1px solid rgba(241,241,235,.08);
}

.inventory-cross::before,
.inventory-cross::after {
  content: "";

  position: absolute;

  background: var(--g-line-light);
}

.inventory-cross::before {
  left: 50%;
  top: 16px;
  bottom: 16px;

  width: 2px;
}

.inventory-cross::after {
  top: 50%;
  left: 16px;
  right: 16px;

  height: 2px;
}

.inventory-empty-icon {
  position: relative;
  z-index: 2;

  color: var(--g-dim);
}

.inventory-slot-label {
  position: absolute;

  left: 8px;
  bottom: 7px;

  color: var(--g-dim);

  font-family: var(--font-display);
  font-size: .36rem;
  font-weight: 900;
}

.inventory-empty-copy {
  padding: 15px 0 17px;
}

.inventory-empty-copy h3 {
  color: var(--g-white);

  font-family: var(--font-display);
  font-size: 1rem;
  font-weight: 900;

  line-height: .95;
}

.inventory-empty-copy p {
  max-width: 260px;

  margin-top: 10px;

  color: var(--g-muted);

  font-size: .67rem;
  line-height: 1.5;
}


/* =============================================================
   JOB
   ============================================================= */

.job-card {
  overflow: hidden;

  border: 2px solid var(--g-line-light);

  background: var(--g-panel);

  box-shadow:
    7px 7px 0 var(--g-black);
}

.job-card-head {
  min-height: 53px;

  display: flex;
  align-items: center;
  justify-content: space-between;

  padding: 0 12px;

  border-bottom: 2px solid var(--g-line);

  background: var(--g-black-2);
}

.job-ticket {
  display: flex;
  align-items: center;
  gap: 9px;
}

.job-ticket-icon {
  width: 29px;
  height: 29px;

  display: grid;
  place-items: center;

  border: 1px solid var(--g-line-light);

  color: var(--g-accent);
}

.job-ticket > div {
  display: flex;
  flex-direction: column;

  gap: 3px;
}

.job-ticket span,
.job-ticket strong {
  font-family: var(--font-display);
  font-weight: 900;
  text-transform: uppercase;
}

.job-ticket > div > span {
  color: var(--g-dim);
  font-size: .37rem;
}

.job-ticket strong {
  color: var(--g-white);
  font-size: .63rem;
}

.job-state {
  display: flex;
  align-items: center;
  gap: 6px;

  color: var(--g-accent);

  font-family: var(--font-display);
  font-size: .42rem;
  font-weight: 900;
}

.job-state i {
  width: 5px;
  height: 5px;
  background: var(--g-accent);
}

.job-card-body {
  display: grid;

  grid-template-columns:
    290px
    minmax(0,1fr);
}

.job-bike-panel {
  min-height: 320px;

  position: relative;

  display: grid;
  place-items: center;

  overflow: hidden;

  border-right: 2px solid var(--g-line);

  background:
    repeating-linear-gradient(
      135deg,
      #191b19 0 9px,
      #151715 9px 18px
    );
}

.job-bike-panel::before {
  content: "";

  position: absolute;

  width: 175px;
  height: 175px;

  border: 1px dashed rgba(241,241,235,.11);
}

.job-panel-code {
  position: absolute;

  left: 12px;
  top: 11px;

  color: var(--g-dim);

  font-family: var(--font-display);
  font-size: .38rem;
  font-weight: 900;

  z-index: 5;
}

.job-bike-label {
  position: absolute;

  left: 12px;
  bottom: 13px;

  display: flex;
  align-items: baseline;
  gap: 5px;

  font-family: var(--font-display);
  font-weight: 900;
  text-transform: uppercase;
}

.job-bike-label span {
  color: var(--g-muted);
  font-size: .4rem;
}

.job-bike-label strong {
  color: var(--g-white);
  font-size: .85rem;
}

.job-information {
  min-width: 0;

  padding: 21px;
}

.job-information-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;

  gap: 15px;

  padding-bottom: 14px;

  border-bottom: 1px solid var(--g-line);
}

.job-information-top h3 {
  margin-top: 6px;

  color: var(--g-white);

  font-family: var(--font-display);
  font-size: clamp(1.5rem,3vw,2.4rem);
  font-weight: 900;

  line-height: .9;

  text-transform: uppercase;
}

.job-customer {
  min-width: 105px;

  display: flex;
  flex-direction: column;
  gap: 4px;

  text-align: right;
}

.job-customer span {
  color: var(--g-dim);

  font-family: var(--font-display);
  font-size: .39rem;
  font-weight: 900;
}

.job-customer strong {
  color: var(--g-accent);

  font-family: var(--font-display);
  font-size: .65rem;
  font-weight: 900;
}

.job-description {
  max-width: 700px;

  margin-top: 14px;

  color: var(--g-muted);

  font-size: .72rem;

  line-height: 1.6;
}

.job-checklist {
  display: grid;

  grid-template-columns: repeat(3,1fr);

  gap: 6px;

  margin-top: 17px;
}

.job-check {
  min-height: 55px;

  display: flex;
  align-items: center;

  gap: 7px;

  padding: 8px;

  border: 1px solid var(--g-line);

  background: var(--g-black-2);
}

.check-box {
  width: 21px;
  height: 21px;

  display: grid;
  place-items: center;

  border: 2px solid var(--g-line-light);

  color: transparent;

  font-family: var(--font-display);
  font-size: .57rem;
  font-weight: 900;
}

.job-check.done .check-box {
  border-color: var(--g-accent-dark);

  color: var(--g-black);

  background: var(--g-accent);
}

.job-check > div {
  display: flex;
  flex-direction: column;
  gap: 3px;
}

.job-check > div span {
  color: var(--g-dim);

  font-family: var(--font-display);
  font-size: .35rem;
  font-weight: 900;
}

.job-check > div strong {
  color: var(--g-white);

  font-family: var(--font-display);
  font-size: .45rem;
  font-weight: 900;
}

.job-progress {
  margin-top: 18px;
}

.job-progress-head {
  display: flex;
  justify-content: space-between;

  color: var(--g-dim);

  font-family: var(--font-display);
  font-size: .4rem;
  font-weight: 900;
}

.job-progress-head strong {
  color: var(--g-accent);
}

.job-progress-track {
  height: 8px;

  margin-top: 7px;

  border: 1px solid var(--g-line);

  background: var(--g-black-2);
}

.job-progress-track i {
  height: 100%;

  display: block;

  background: var(--g-accent);
}

.job-footer {
  display: grid;

  grid-template-columns:
    minmax(130px,1fr)
    90px
    175px;

  align-items: end;

  gap: 15px;

  margin-top: 18px;
  padding-top: 14px;

  border-top: 2px solid var(--g-line);
}

.job-reward,
.job-deadline {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.job-reward span,
.job-deadline span {
  color: var(--g-dim);

  font-family: var(--font-display);
  font-size: .39rem;
  font-weight: 900;
}

.job-reward strong {
  color: var(--g-white);

  font-family: var(--font-display);
  font-size: .95rem;
  font-weight: 900;
}

.job-deadline strong {
  color: var(--g-accent);

  font-family: var(--font-display);
  font-size: .63rem;
  font-weight: 900;
}

.job-button {
  min-height: 39px;

  display: flex;
  align-items: center;
  justify-content: space-between;

  padding: 0 10px;

  border: 2px solid var(--g-accent-dark);

  color: var(--g-accent);

  background: var(--g-black-2);

  font-family: var(--font-display);
  font-size: .43rem;
  font-weight: 900;

  text-decoration: none;
  text-transform: uppercase;
}

.job-button:hover {
  color: var(--g-black);
  background: var(--g-accent);
}


/* =============================================================
   SYSTEM LIST
   ============================================================= */

.system-list {
  border-top: 2px solid var(--g-line);
}

.system-row {
  min-height: 82px;

  display: grid;

  grid-template-columns:
    40px
    37px
    minmax(160px,.7fr)
    minmax(130px,1fr)
    125px;

  align-items: center;

  gap: 12px;

  padding: 10px 12px;

  border-bottom: 2px solid var(--g-line);

  background: var(--g-panel);
}

.system-row:nth-child(2) {
  background: var(--g-panel-2);
}

.system-row:nth-child(3) {
  background: #131513;
}

.system-row:nth-child(4) {
  background: var(--g-panel-2);
}

.system-index {
  color: var(--g-dim);

  font-family: var(--font-display);
  font-size: .51rem;
  font-weight: 900;
}

.system-icon-shell {
  width: 33px;
  height: 33px;

  display: grid;
  place-items: center;

  border: 1px solid var(--g-line-light);

  color: var(--g-soft);
}

.system-name {
  display: flex;
  flex-direction: column;

  gap: 4px;
}

.system-name span {
  color: var(--g-dim);

  font-family: var(--font-display);
  font-size: .41rem;
  font-weight: 900;
}

.system-name strong {
  color: var(--g-white);

  font-family: var(--font-display);
  font-size: .72rem;
  font-weight: 900;
}

.system-meter {
  display: grid;

  grid-template-columns: repeat(10,1fr);

  gap: 3px;
}

.system-meter i {
  height: 5px;

  background: var(--g-line-light);
}

.system-meter--good {
  background: var(--g-accent-dark) !important;
}

.system-meter--warning {
  background: var(--g-accent) !important;
}

.system-detail {
  color: var(--g-muted);

  font-family: var(--font-display);
  font-size: .41rem;
  font-weight: 900;

  text-align: right;
}

.system-detail--warning {
  color: var(--g-accent);
}


/* =============================================================
   UPGRADE BLUEPRINT
   ============================================================= */

.upgrade {
  display: grid;

  grid-template-columns:
    350px
    minmax(0,1fr);

  overflow: hidden;

  border: 2px solid var(--g-line-light);

  background: var(--g-panel);

  box-shadow:
    7px 7px 0 var(--g-black);
}

.upgrade-blueprint {
  min-height: 345px;

  position: relative;

  overflow: hidden;

  border-right: 2px solid var(--g-line);

  background:
    linear-gradient(
      rgba(183,216,60,.05) 1px,
      transparent 1px
    ),
    linear-gradient(
      90deg,
      rgba(183,216,60,.05) 1px,
      transparent 1px
    ),
    #11140f;

  background-size: 22px 22px;
}

.blueprint-header {
  position: absolute;

  left: 12px;
  right: 12px;
  top: 11px;

  display: flex;
  justify-content: space-between;

  color: var(--g-dim);

  font-family: var(--font-display);
  font-size: .4rem;
  font-weight: 900;
}

.blueprint-title {
  position: absolute;

  left: 12px;
  top: 35px;

  color: rgba(183,216,60,.34);

  font-family: var(--font-display);
  font-size: .52rem;
  font-weight: 900;
}

.blueprint-floor-plan {
  position: absolute;

  left: 20px;
  right: 20px;
  top: 84px;
  bottom: 55px;

  display: grid;

  grid-template-columns: 1fr 72px 1fr;

  align-items: center;

  gap: 7px;
}

.blueprint-room {
  min-height: 145px;

  position: relative;

  display: grid;

  grid-template-columns: repeat(2,1fr);

  grid-template-rows: repeat(2,1fr);

  gap: 5px;

  padding: 17px 8px 8px;

  border: 2px solid var(--g-line-light);

  background: rgba(5,5,5,.5);
}

.blueprint-room--next {
  border-color: var(--g-accent);
}

.room-label {
  position: absolute;

  left: 7px;
  top: 4px;

  color: var(--g-dim);

  font-family: var(--font-display);
  font-size: .36rem;
  font-weight: 900;
}

.room-bay,
.room-bench {
  border: 1px solid var(--g-line-light);

  background: rgba(255,255,255,.025);
}

.blueprint-room--next .room-bay {
  border-color: rgba(183,216,60,.45);
}

.room-bench {
  grid-column: span 2;
}

.blueprint-route {
  display: flex;
  align-items: center;
  justify-content: center;

  gap: 4px;
}

.blueprint-route i {
  width: 7px;
  height: 3px;

  background: var(--g-accent-dark);
}

.blueprint-route span {
  margin-left: 3px;

  color: var(--g-accent);

  font-family: var(--font-display);
  font-size: 1rem;
  font-weight: 900;
}

.blueprint-dimensions {
  position: absolute;

  left: 20px;
  right: 20px;
  bottom: 18px;

  display: flex;
  justify-content: space-between;

  color: var(--g-dim);

  font-family: var(--font-display);
  font-size: .36rem;
  font-weight: 900;
}

.blueprint-stamp {
  position: absolute;

  right: 14px;
  top: 35px;

  width: 49px;
  height: 49px;

  display: flex;
  align-items: center;
  justify-content: center;

  flex-direction: column;

  border: 2px solid var(--g-accent-dark);

  color: var(--g-accent);

  font-family: var(--font-display);
  font-size: .33rem;
  font-weight: 900;

  transform: rotate(4deg);
}

.blueprint-stamp strong {
  font-size: .95rem;
}


/* =============================================================
   UPGRADE CONTENT
   ============================================================= */

.upgrade-content {
  min-width: 0;

  padding: 22px;
}

.upgrade-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;

  gap: 14px;
}

.upgrade-heading-title {
  display: flex;
  align-items: center;

  gap: 9px;
}

.upgrade-icon {
  width: 34px;
  height: 34px;

  display: grid;
  place-items: center;

  color: var(--g-accent);

  border: 1px solid var(--g-accent-dark);

  background: var(--g-black-2);
}

.upgrade-heading h3 {
  margin-top: 4px;

  color: var(--g-white);

  font-family: var(--font-display);
  font-size: 1.5rem;
  font-weight: 900;

  line-height: .95;
}

.upgrade-lock {
  padding: 5px 7px;

  border: 1px solid var(--g-line-light);

  color: var(--g-dim);

  font-family: var(--font-display);
  font-size: .4rem;
  font-weight: 900;
}

.upgrade-content > p {
  max-width: 670px;

  margin-top: 13px;

  color: var(--g-muted);

  font-size: var(--text-sm);

  line-height: 1.6;
}

.upgrade-stat-grid {
  display: grid;

  grid-template-columns: repeat(4,1fr);

  gap: 6px;

  margin-top: 20px;
}

.upgrade-stat {
  display: grid;

  grid-template-columns: 25px 1fr;

  align-items: center;

  gap: 7px;

  padding: 9px;

  border: 1px solid var(--g-line);

  background: var(--g-black-2);
}

.upgrade-stat-icon {
  width: 25px;
  height: 25px;

  display: grid;
  place-items: center;

  border: 1px solid var(--g-line-light);

  color: var(--g-accent);
}

.upgrade-stat > div {
  min-width: 0;
}

.upgrade-stat span {
  color: var(--g-dim);

  font-family: var(--font-display);
  font-size: .36rem;
  font-weight: 900;
}

.upgrade-stat strong {
  display: flex;
  align-items: center;
  gap: 4px;

  margin-top: 4px;

  color: var(--g-white);

  font-family: var(--font-display);
  font-size: .73rem;
  font-weight: 900;
}

.upgrade-stat strong small {
  color: var(--g-accent);

  font-size: .52rem;
}

.upgrade-requirement {
  margin-top: 18px;

  padding-top: 14px;

  border-top: 2px solid var(--g-line);
}

.requirement-head {
  display: flex;
  align-items: center;
  justify-content: space-between;

  color: var(--g-dim);

  font-family: var(--font-display);
  font-size: .39rem;
  font-weight: 900;
}

.requirement-track {
  display: grid;

  grid-template-columns: repeat(6,1fr);

  gap: 4px;

  margin-top: 8px;
}

.requirement-track i {
  height: 5px;

  background: var(--g-line-light);
}

.requirement-track i:nth-child(-n+3) {
  background: var(--g-accent-dark);
}

.requirement-copy {
  display: flex;

  gap: 25px;

  margin-top: 9px;
}

.requirement-copy > div {
  display: flex;
  flex-direction: column;
  gap: 3px;
}

.requirement-copy span {
  color: var(--g-dim);

  font-family: var(--font-display);
  font-size: .36rem;
  font-weight: 900;
}

.requirement-copy strong {
  color: var(--g-white);

  font-family: var(--font-display);
  font-size: .7rem;
  font-weight: 900;
}

.upgrade-footer {
  margin-top: 19px;

  padding-top: 13px;

  display: flex;
  align-items: flex-end;
  justify-content: space-between;

  gap: 15px;

  border-top: 2px solid var(--g-line);
}

.upgrade-next-label {
  display: flex;
  flex-direction: column;

  gap: 4px;
}

.upgrade-next-label span {
  color: var(--g-dim);

  font-family: var(--font-display);
  font-size: .38rem;
  font-weight: 900;
}

.upgrade-next-label strong {
  color: var(--g-accent);

  font-family: var(--font-display);
  font-size: .9rem;
  font-weight: 900;
}


