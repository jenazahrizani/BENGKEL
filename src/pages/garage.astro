  font-family: var(--font-display);
  font-size: .38rem;
  font-weight: 900;
}

.header-capacity strong {
  margin-top: 4px;

  color: var(--g-white);

  font-family: var(--font-display);
  font-size: .62rem;
  font-weight: 900;
}

.header-actions {
