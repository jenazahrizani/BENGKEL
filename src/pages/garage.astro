  font-size: var(--text-sm);

  line-height: 1.65;
}

.garage-header-panel {
  display: grid;

  gap: 8px;
}

.level-box {
  display: grid;

  grid-template-columns: 54px 1fr;

  gap: 10px;

  padding: 11px;

  border: 2px solid var(--g-line);

  background: var(--g-black-2);
}

.level-icon {
  width: 54px;
  height: 54px;

  display: grid;
