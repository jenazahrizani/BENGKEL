  line-height: .74;

  letter-spacing: -.09em;

  text-transform: uppercase;
}

.header-rule {
  width: min(340px,65%);

  height: 3px;

  margin-top: 20px;

  background: var(--g-accent);
}

.garage-header-copy p {
  max-width: 680px;

  margin-top: 18px;

