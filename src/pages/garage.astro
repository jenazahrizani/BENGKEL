---
import Layout from "../components/Layout.astro";
import "../styles/global.css";
import Button from "../components/Button.astro";
import Navigation from "../components/Navigation.astro";

const garage = {
  name: "BENGKEL",
  level: 1,
  capacity: 2,
  mechanicCapacity: 1,
  driverCapacity: 1,
  orderCapacity: 1,
};

const garageStats = [
  {
    label: "MOTOR",
    value: "1 / 2",
    detail: "SLOT AVAILABLE",
    icon: "motorcycle",
    active: true,
  },
  {
    label: "MECHANIC",
    value: "1 / 1",
    detail: "READY",
    icon: "person",
  },
  {
    label: "JOKI",
    value: "1 / 1",
    detail: "READY",
    icon: "helmet",
  },
  {
    label: "ORDER",
    value: "1 / 1",
    detail: "ACTIVE",
    icon: "clipboard",
  },
];

const motor = {
  id: "MTR-001",
  name: "NUSA 125",
  brand: "NUSA",
  year: "2018",
  type: "UNDERBONE",
  condition: "GOOD",
  status: "READY",
  build: "STREET BUILD",
  value: 18500000,
  buildScore: 68,
  stats: {
    power: 72,
    acceleration: 68,
    grip: 64,
    reliability: 78,
  },
};

const activeOrder = {
  id: "JOB-001",
  title: "SERVICE NUSA 125",
  customer: "PAK ARDI",
  type: "SERVICE",
  description:
    "Periksa kondisi mesin, rem, ban, dan lakukan servis dasar sebelum unit dikembalikan ke pelanggan.",
  reward: 450000,
  deadline: "TODAY",
  progress: 35,
};

const workshopStatus = [
  {
    label: "WORKBENCH",
    value: "READY",
    detail: "TOOLS AVAILABLE",
    icon: "wrench",
    fill: 9,
    tone: "good",
  },
  {
    label: "TOOLS",
    value: "AVAILABLE",
    detail: "8 / 8 READY",
    icon: "toolbox",
    fill: 10,
    tone: "good",
  },
  {
    label: "CUSTOMER ORDER",
    value: "ACTIVE",
    detail: "01 / 01 SLOT",
    icon: "clipboard",
    fill: 4,
    tone: "warning",
  },
  {
    label: "POWER",
    value: "ONLINE",
    detail: "GARAGE SYSTEM",
    icon: "bolt",
    fill: 8,
    tone: "good",
  },
];

const upgradePreview = {
  nextLevel: 2,
  name: "GARASI BERKEMBANG",
  motorCapacity: 4,
  mechanicCapacity: 2,
  driverCapacity: 1,
  orderCapacity: 2,
  cost: 25000000,
};

const commandItems = [
  {
    key: "A",
    label: "MOTOR",
    title: "KELOLA MOTOR",
    description:
      "Inspect, repair, build, tune, jual, atau siapkan race.",
    href: "/motor",
    icon: "motorcycle",
  },
  {
    key: "B",
    label: "WORKSHOP",
    title: "KERJAKAN ORDER",
    description:
      "Selesaikan pekerjaan pelanggan dan tingkatkan reputasi bengkel.",
    href: "/workshop",
    icon: "wrench",
  },
  {
    key: "C",
    label: "RACE",
    title: "TURUN BALAP",
    description:
      "Pilih motor dan joki, lalu kejar catatan waktu terbaik.",
    href: "/race",
    icon: "flag",
  },
  {
    key: "D",
    label: "MARKET",
    title: "CARI UNIT & PART",
    description:
      "Berburu motor bekas, project, salvage, dan komponen baru.",
    href: "/market",
    icon: "search",
  },
];
---

<Layout
  title="BENGKEL — GARAGE"
  description="Bangun. Racik. Jual. Gas."
>
  <div class="page garage-page">
    <div class="game-layout">

      <Navigation active="garage" />

      <main class="main">

        <div class="main-inner garage-main">

          <!-- =====================================================
               HEADER
          ===================================================== -->

          <header class="garage-header">

            <div class="garage-header-top">

              <div class="garage-head-left">
                <span class="header-led"></span>
                <span>GARAGE_01</span>
              </div>

              <span class="garage-head-center">
                HOME / WORKSHOP / FLOOR_01
              </span>

              <div class="garage-head-right">
                <span class="pixel-icon pixel-icon--bolt pixel-icon--tiny"></span>
                ONLINE
              </div>

            </div>


            <div class="garage-header-body">

              <div class="garage-header-copy">

                <div class="garage-kicker-row">

                  <span class="garage-title-icon">
                    <span class="pixel-icon pixel-icon--garage pixel-icon--small"></span>
                  </span>

                  <span class="header-kicker">
                    LOCAL WORKSHOP
                  </span>

                </div>

                <h1>
                  BENGKEL
                </h1>

                <div class="header-rule"></div>

                <p>
                  Markas utama untuk membeli, memperbaiki,
                  membangun, menyetel, dan menyiapkan motor
                  sebelum turun ke jalan atau lintasan.
                </p>

              </div>


              <div class="garage-header-panel">

                <div class="level-box">

                  <div class="level-icon">
                    <span class="pixel-icon pixel-icon--garage pixel-icon--medium"></span>
                  </div>

                  <div class="level-copy">
                    <span>GARAGE LEVEL</span>

                    <strong>
                      01
                    </strong>

                    <small>
                      SMALL SHOP
                    </small>
                  </div>

                </div>


                <div class="header-capacity">

                  <div>
                    <span>MOTOR</span>
                    <strong>01 / 02</strong>
                  </div>

                  <div>
                    <span>ORDER</span>
                    <strong>01 / 01</strong>
                  </div>

                  <div>
                    <span>WORKBENCH</span>
                    <strong>01</strong>
                  </div>

                </div>


                <div class="header-actions">

                  <Button
                    href="/market"
                    variant="primary"
                  >
                    CARI MOTOR
                  </Button>

                  <Button href="/workshop">
                    WORKSHOP
                  </Button>

                </div>

              </div>

            </div>


            <div class="garage-header-bottom">

              <span>BUILD / SERVICE / RACE</span>

              <span>LVL 01 / EXP 42%</span>

              <span class="header-system">
                <i></i>
                SYSTEM READY
              </span>

            </div>

          </header>



          <!-- =====================================================
               CURRENT STATUS
          ===================================================== -->

          <section class="garage-section">

            <div class="section-header">

              <div class="section-heading">

                <span class="section-marker"></span>

                <div>
                  <span class="section-kicker">
                    GARAGE SYSTEM
                  </span>

                  <h2>
                    CURRENT STATUS
                  </h2>
                </div>

              </div>

              <span class="section-code">
                01 / 08
              </span>

            </div>


            <div class="status-grid">

              {
                garageStats.map((stat, index) => (
                  <article
                    class:list={[
                      "status-card",
                      stat.active && "status-card--active",
                    ]}
                  >

                    <div class="status-card-head">

                      <div class="status-card-ident">

                        <span class="status-icon">
                          <span
                            class:list={[
                              "pixel-icon",
                              `pixel-icon--${stat.icon}`,
                              "pixel-icon--small",
                            ]}
                          ></span>
                        </span>

                        <span>
                          {stat.label}
                        </span>

                      </div>

                      <span>
                        {String(index + 1).padStart(2, "0")}
                      </span>

                    </div>


                    <strong class="status-card-value">
                      {stat.value}
                    </strong>


                    <div class="status-card-foot">

                      <div class="segment-bar">
                        {Array.from({ length: 8 }).map((_, segmentIndex) => (
                          <i
                            class:segment-active={
                              stat.active
                                ? segmentIndex < 6
                                : segmentIndex < 5
                            }
                          ></i>
                        ))}
                      </div>

                      <span>
                        {stat.detail}
                      </span>

                    </div>

                  </article>
                ))
              }

            </div>

          </section>



          <!-- =====================================================
               WORKSHOP FLOOR
          ===================================================== -->

          <section class="garage-section garage-floor-section">

            <div class="section-header">

              <div class="section-heading">

                <span class="section-marker section-marker--accent"></span>

                <div>
                  <span class="section-kicker">
                    GARAGE FLOOR / 01
                  </span>

                  <h2>
                    WORKSHOP FLOOR
                  </h2>
                </div>

              </div>

              <div class="section-meta">
                <span>02 BAY</span>
                <span>01 BENCH</span>
                <span>OPEN</span>
              </div>

            </div>


            <div class="floor">

              <div class="floor-topbar">

                <div class="floor-top-left">
                  <span class="pixel-icon pixel-icon--garage pixel-icon--tiny"></span>
                  <span>FLOOR PLAN</span>
                </div>

                <span>WORK AREA</span>

                <span>FLOOR_01</span>

              </div>


              <div class="floor-body">

                <div class="floor-grid"></div>

                <div class="floor-ambient floor-ambient--one"></div>
                <div class="floor-ambient floor-ambient--two"></div>

                <span class="floor-watermark">
                  B
                </span>


                <div class="floor-bays">


                  <!-- =================================================
                       BAY 01
                  ================================================== -->

                  <article class="bay bay--occupied">

                    <div class="bay-header">

                      <div class="bay-header-main">

                        <span class="bay-index">
                          BAY 01
                        </span>

                        <div class="bay-name-row">
                          <span class="mini-bike-dot">
                            <span class="pixel-icon pixel-icon--motorcycle pixel-icon--tiny"></span>
                          </span>

                          <strong>
                            NUSA 125
                          </strong>
                        </div>

                      </div>

                      <span class="bay-state">
                        ACTIVE
                      </span>

                    </div>


                    <div class="bay-display">

                      <div class="display-grid"></div>

                      <div class="display-cross"></div>

                      <div class="display-target"></div>


                      <div
                        class="pixel-motor pixel-motor--large"
                        aria-hidden="true"
                      >
                        <span class="pixel-motor__body"></span>
                        <span class="pixel-motor__tank"></span>
                        <span class="pixel-motor__seat"></span>
                        <span class="pixel-motor__frame"></span>
                        <span class="pixel-motor__engine"></span>
                        <span class="pixel-motor__pipe"></span>
                        <span class="pixel-motor__front"></span>
                        <span class="pixel-motor__rear"></span>
                        <span class="pixel-motor__wheel pixel-motor__wheel--rear"></span>
                        <span class="pixel-motor__wheel pixel-motor__wheel--front"></span>
                        <span class="pixel-motor__handle"></span>
                      </div>


                      <div class="display-bike-info">

                        <span>
                          {motor.brand}
                        </span>

                        <strong>
                          125
                        </strong>

                      </div>


                      <div class="display-tech">

                        <span>CONDITION</span>
                        <strong>GOOD</strong>

                        <span>BUILD</span>
                        <strong>68</strong>

                      </div>


                      <div class="display-floor-line"></div>

                      <div class="display-scan-line"></div>

                    </div>


                    <div class="bay-spec-strip">

                      <div>
                        <span>POWER</span>
                        <strong>{motor.stats.power}</strong>
                      </div>

                      <div>
                        <span>ACCEL</span>
                        <strong>{motor.stats.acceleration}</strong>
                      </div>

                      <div>
                        <span>GRIP</span>
                        <strong>{motor.stats.grip}</strong>
                      </div>

                      <div>
                        <span>RELIAB.</span>
                        <strong>{motor.stats.reliability}</strong>
                      </div>

                    </div>


                    <div class="bay-footer">

                      <div class="bay-footer-status">

                        <span>
                          STREET BUILD
                        </span>

                        <strong>
                          READY
                        </strong>

                      </div>

                      <a
                        href="/motor"
                        class="retro-button"
                      >
                        INSPECT →
                      </a>

                    </div>

                  </article>



                  <!-- =================================================
                       BAY 02
                  ================================================== -->

                  <article class="bay bay--empty">

                    <div class="bay-header">

                      <div class="bay-header-main">

                        <span class="bay-index">
                          BAY 02
                        </span>

                        <div class="bay-name-row">
                          <span class="mini-bike-dot mini-bike-dot--empty">
                            <span class="pixel-icon pixel-icon--plus pixel-icon--tiny"></span>
                          </span>

                          <strong>
                            EMPTY SLOT
                          </strong>
                        </div>

                      </div>

                      <span class="bay-state bay-state--dim">
                        OPEN
                      </span>

                    </div>


                    <div class="empty-display">

                      <div class="empty-frame">

                        <span class="empty-corner empty-corner--tl"></span>
                        <span class="empty-corner empty-corner--tr"></span>
                        <span class="empty-corner empty-corner--bl"></span>
                        <span class="empty-corner empty-corner--br"></span>

                        <div class="empty-cross"></div>

                        <div class="empty-slot-icon">
                          <span class="pixel-icon pixel-icon--motorcycle pixel-icon--medium"></span>
                        </div>

                      </div>


                      <strong>
                        OPEN SLOT
                      </strong>

                      <span>
                        READY FOR NEXT PROJECT
                      </span>

                    </div>


                    <div class="bay-empty-note">

                      <span>
                        SLOT CAPACITY
                      </span>

                      <strong>
                        01 AVAILABLE
                      </strong>

                    </div>


                    <div class="bay-footer">

                      <div class="bay-footer-status">

                        <span>
                          NEXT TARGET
                        </span>

                        <strong>
                          MOTOR / PROJECT
                        </strong>

                      </div>

                      <a
                        href="/market"
                        class="retro-button retro-button--accent"
                      >
                        + FILL
                      </a>

                    </div>

                  </article>



                  <!-- =================================================
                       WORKBENCH
                  ================================================== -->

                  <article class="bay bay--workshop">

                    <div class="bay-header">

                      <div class="bay-header-main">

                        <span class="bay-index">
                          BENCH 01
                        </span>

                        <div class="bay-name-row">
                          <span class="mini-bike-dot">
                            <span class="pixel-icon pixel-icon--wrench pixel-icon--tiny"></span>
                          </span>

                          <strong>
                            WORKSHOP
                          </strong>
                        </div>

                      </div>

                      <span class="bay-state">
                        READY
                      </span>

                    </div>


                    <div class="workbench-display">

                      <div class="bench-wall"></div>

                      <div class="pegboard">

                        <span></span>
                        <span></span>
                        <span></span>
                        <span></span>
                        <span></span>
                        <span></span>
                        <span></span>
                        <span></span>
                        <span></span>
                        <span></span>
                        <span></span>
                        <span></span>

                      </div>


                      <div class="bench-sign">
                        TOOL WALL / 01
                      </div>


                      <div class="workbench">

                        <span class="workbench-top"></span>

                        <span class="workbench-leg workbench-leg--left"></span>
                        <span class="workbench-leg workbench-leg--right"></span>

                        <span class="toolbox">
                          <i></i>
                          <i></i>
                          <i></i>
                        </span>

                        <span class="tool tool--wrench"></span>
                        <span class="tool tool--hammer"></span>
                        <span class="tool tool--driver"></span>
                        <span class="tool tool--meter"></span>

                        <span class="bench-drawer bench-drawer--1"></span>
                        <span class="bench-drawer bench-drawer--2"></span>

                      </div>


                      <div class="bench-floor-light"></div>

                      <div class="workbench-label">
                        <span class="pixel-icon pixel-icon--wrench pixel-icon--tiny"></span>
                        TOOLS / READY
                      </div>

                    </div>


                    <div class="bay-footer">

                      <div class="bay-footer-status">

                        <span>
                          WORKBENCH
                        </span>

                        <strong>
                          AVAILABLE
                        </strong>

                      </div>

                      <a
                        href="/workshop"
                        class="retro-button"
                      >
                        OPEN →
                      </a>

                    </div>

                  </article>

                </div>

              </div>


              <div class="floor-bottombar">

                <span>FLOOR_01</span>

                <span>02 BAY / 01 BENCH</span>

                <span class="floor-online">
                  <i></i>
                  GARAGE READY
                </span>

              </div>

            </div>

          </section>



          <!-- =====================================================
               MOTOR INVENTORY
          ===================================================== -->

          <section class="garage-section">

            <div class="section-header">

              <div class="section-heading">

                <span class="section-marker"></span>

                <div>
                  <span class="section-kicker">
                    INVENTORY / GARAGE
                  </span>

                  <h2>
                    MOTOR MILIKMU
                  </h2>
                </div>

              </div>

              <a
                href="/motor"
                class="section-link"
              >
                ALL MOTOR →
              </a>

            </div>


            <div class="inventory-grid">


              <!-- MOTOR CARD -->

              <article class="garage-motor-card">

                <div class="garage-motor-card-top">

                  <div class="garage-motor-id">
                    <span class="accent-number">01</span>
                    <span>{motor.id}</span>
                  </div>

                  <span class="garage-motor-status">
                    {motor.status}
                  </span>

                </div>


                <div class="garage-motor-art">

                  <div class="garage-motor-art-code">
                    OWNED / UNIT_01
                  </div>

                  <div class="garage-motor-art-corner garage-motor-art-corner--tl"></div>
                  <div class="garage-motor-art-corner garage-motor-art-corner--tr"></div>
                  <div class="garage-motor-art-corner garage-motor-art-corner--bl"></div>
                  <div class="garage-motor-art-corner garage-motor-art-corner--br"></div>

                  <div
                    class="pixel-motor pixel-motor--inventory"
                    aria-hidden="true"
                  >
                    <span class="pixel-motor__body"></span>
                    <span class="pixel-motor__tank"></span>
                    <span class="pixel-motor__seat"></span>
                    <span class="pixel-motor__frame"></span>
                    <span class="pixel-motor__engine"></span>
                    <span class="pixel-motor__pipe"></span>
                    <span class="pixel-motor__front"></span>
                    <span class="pixel-motor__rear"></span>
                    <span class="pixel-motor__wheel pixel-motor__wheel--rear"></span>
                    <span class="pixel-motor__wheel pixel-motor__wheel--front"></span>
                    <span class="pixel-motor__handle"></span>
                  </div>

                  <div class="garage-motor-ground"></div>

                  <span class="garage-motor-art-type">
                    {motor.type}
                  </span>

                </div>


                <div class="garage-motor-info">

                  <div class="garage-motor-title">

                    <div>

                      <span class="section-kicker">
                        {motor.brand} / {motor.year}
                      </span>

                      <h3>
                        {motor.name}
                      </h3>

                      <span>
                        {motor.build}
                      </span>

                    </div>

                    <span class="motor-condition">
                      {motor.condition}
                    </span>

                  </div>


                  <div class="garage-motor-stats">

                    <div>
                      <span>POWER</span>
                      <strong>{motor.stats.power}</strong>
                    </div>

                    <div>
                      <span>ACCEL</span>
                      <strong>{motor.stats.acceleration}</strong>
                    </div>

                    <div>
                      <span>GRIP</span>
                      <strong>{motor.stats.grip}</strong>
                    </div>

                    <div>
                      <span>RELIAB.</span>
                      <strong>{motor.stats.reliability}</strong>
                    </div>

                  </div>


                  <div class="garage-motor-finance">

                    <div>
                      <span>VALUE</span>
                      <strong>
                        Rp {motor.value.toLocaleString("id-ID")}
                      </strong>
                    </div>

                    <div>
                      <span>BUILD SCORE</span>
                      <strong class="accent-text">
                        {motor.buildScore}
                      </strong>
                    </div>

                  </div>

                </div>


                <div class="garage-motor-actions">

                  <a
                    href="/motor"
                    class="motor-action motor-action--primary"
                  >
                    <span class="pixel-icon pixel-icon--search pixel-icon--tiny"></span>
                    OPEN MOTOR
                    <span>→</span>
                  </a>

                  <a
                    href="/workshop"
                    class="motor-action"
                  >
                    WORKSHOP
                    <span>→</span>
                  </a>

                </div>

              </article>


              <!-- EMPTY INVENTORY SLOT -->

              <aside class="inventory-empty">

                <div class="inventory-empty-top">

                  <div>
                    <span class="accent-number">02</span>
                    <span>SLOT_02</span>
                  </div>

                  <span>
                    EMPTY
                  </span>

                </div>


                <div class="inventory-empty-art">

                  <div class="inventory-cross"></div>

                  <div class="inventory-empty-icon">
                    <span class="pixel-icon pixel-icon--plus pixel-icon--medium"></span>
                  </div>

                  <span class="inventory-slot-label">
                    AVAILABLE SLOT
                  </span>

                </div>


                <div class="inventory-empty-copy">

                  <h3>
                    FIND NEXT
                    <br />
                    PROJECT
                  </h3>

                  <p>
                    Motor bekas, stock,
                    salvage, atau project
                    dengan ruang build lebih besar.
                  </p>

                </div>


                <a
                  href="/market"
                  class="retro-button retro-button--accent retro-button--wide"
                >
                  <span class="pixel-icon pixel-icon--search pixel-icon--tiny"></span>
                  OPEN MARKET
                </a>

              </aside>

            </div>

          </section>



          <!-- =====================================================
               ACTIVE ORDER
          ===================================================== -->

          <section class="garage-section">

            <div class="section-header">

              <div class="section-heading">

                <span class="section-marker section-marker--accent"></span>

                <div>
                  <span class="section-kicker">
                    CUSTOMER JOB / ACTIVE
                  </span>

                  <h2>
                    ACTIVE ORDER
                  </h2>
                </div>

              </div>

              <a
                href="/workshop"
                class="section-link"
              >
                ALL JOBS →
              </a>

            </div>


            <article class="job-card">

              <div class="job-card-head">

                <div class="job-ticket">

                  <span class="job-ticket-icon">
                    <span class="pixel-icon pixel-icon--clipboard pixel-icon--small"></span>
                  </span>

                  <div>
                    <span>{activeOrder.id}</span>
                    <strong>{activeOrder.type}</strong>
                  </div>

                </div>

                <div class="job-state">
                  <i></i>
                  RUNNING
                </div>

              </div>


              <div class="job-card-body">

                <div class="job-bike-panel">

                  <span class="job-panel-code">
                    CUSTOMER UNIT
                  </span>

                  <div
                    class="pixel-motor pixel-motor--job"
                    aria-hidden="true"
                  >
                    <span class="pixel-motor__body"></span>
                    <span class="pixel-motor__tank"></span>
                    <span class="pixel-motor__seat"></span>
                    <span class="pixel-motor__frame"></span>
                    <span class="pixel-motor__engine"></span>
                    <span class="pixel-motor__pipe"></span>
                    <span class="pixel-motor__front"></span>
                    <span class="pixel-motor__rear"></span>
                    <span class="pixel-motor__wheel pixel-motor__wheel--rear"></span>
                    <span class="pixel-motor__wheel pixel-motor__wheel--front"></span>
                    <span class="pixel-motor__handle"></span>
                  </div>

                  <div class="job-bike-label">
                    <span>NUSA</span>
                    <strong>125</strong>
                  </div>

                </div>


                <div class="job-information">

                  <div class="job-information-top">

                    <div>

                      <span class="section-kicker">
                        CUSTOMER SERVICE
                      </span>

                      <h3>
                        {activeOrder.title}
                      </h3>

                    </div>

                    <div class="job-customer">

                      <span>CUSTOMER</span>

                      <strong>
                        {activeOrder.customer}
                      </strong>

                    </div>

                  </div>


                  <p class="job-description">
                    {activeOrder.description}
                  </p>


                  <div class="job-checklist">

                    <div class="job-check done">

