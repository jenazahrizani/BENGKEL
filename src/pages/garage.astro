  gap: 7px;
}


/* =============================================================
   STATUS
   ============================================================= */

.status-grid {
  display: grid;

  grid-template-columns: repeat(4,1fr);

  border-top: 2px solid var(--g-line);
  border-left: 2px solid var(--g-line);
}

.status-card {
