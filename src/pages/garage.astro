<style>

/* =============================================================
   DESIGN TOKENS
   ============================================================= */

.garage-page {

  --g-black: #050505;
  --g-black-2: #090909;

  --g-panel: #101010;
  --g-panel-2: #151515;
  --g-panel-3: #1b1b1b;

  --g-line: #292929;
  --g-line-light: #3d3d3d;

  --g-white: #f1f1eb;
  --g-soft: #d0d0ca;

  --g-muted: #979791;
  --g-dim: #61615c;

  --g-accent: #b7d83c;
  --g-accent-dark: #687d27;

  --g-danger: #c65a51;

}


/* =============================================================
   BASE
   ============================================================= */

.garage-main {
  min-width: 0;
}

.garage-section {
  margin-top: 42px;
}

.section-header {
  min-height: 55px;

  display: flex;
  align-items: center;
  justify-content: space-between;

  gap: 15px;

  margin-bottom: 10px;

  border-bottom: 2px solid var(--g-line);
}

.section-heading {
  display: flex;
  align-items: center;
  gap: 11px;
}

.section-marker {
  width: 8px;
  height: 8px;

  flex: 0 0 auto;

  background: var(--g-white);

  box-shadow:
    4px 4px 0 var(--g-line-light);
}

.section-marker--accent {
  background: var(--g-accent);

  box-shadow:
    4px 4px 0 var(--g-accent-dark);
}

.section-kicker {
  display: block;

  color: var(--g-dim);

  font-family: var(--font-display);
  font-size: .52rem;
  font-weight: 900;

  letter-spacing: .1em;

  text-transform: uppercase;
}

.section-header h2 {
  margin-top: 4px;

  color: var(--g-white);

  font-family: var(--font-display);
  font-size: clamp(1.35rem,3vw,2rem);
  font-weight: 900;

  line-height: .9;

  letter-spacing: -.04em;

  text-transform: uppercase;
}

.section-code,
.section-meta,
.section-link {
  color: var(--g-dim);

  font-family: var(--font-display);
  font-size: .48rem;
  font-weight: 900;

  letter-spacing: .08em;

  text-transform: uppercase;
}

.section-meta {
  display: flex;
  gap: 15px;
}

.section-link {
  color: var(--g-accent);

  text-decoration: none;
}

.section-link:hover {
  color: var(--g-white);
}

.accent-text {
  color: var(--g-accent) !important;
}


/* =============================================================
   PIXEL ICON SYSTEM
   ============================================================= */

.pixel-icon {
  position: relative;

  display: block;

  width: 18px;
  height: 18px;

  color: currentColor;

  image-rendering: pixelated;
}

.pixel-icon::before,
.pixel-icon::after {
  content: "";
  position: absolute;
  display: block;
}

.pixel-icon--tiny {
  width: 10px;
  height: 10px;
}

.pixel-icon--small {
  width: 18px;
  height: 18px;
}

.pixel-icon--medium {
  width: 30px;
  height: 30px;
}


/* MOTORCYCLE */

.pixel-icon--motorcycle::before {
  left: 1px;
  bottom: 1px;

  width: 5px;
  height: 5px;

  border: 2px solid currentColor;

  box-shadow:
    10px 0 0 -1px var(--g-panel),
    10px 0 0 0 currentColor;
}

.pixel-icon--motorcycle::after {
  left: 4px;
  top: 6px;

  width: 10px;
  height: 4px;

  background: currentColor;

  box-shadow:
    -1px 3px 0 -1px currentColor,
    3px 4px 0 -1px currentColor,
    7px 3px 0 -1px currentColor;
}


/* GARAGE */

.pixel-icon--garage::before {
  left: 2px;
  top: 4px;

  width: 14px;
  height: 12px;

  border: 2px solid currentColor;
}

.pixel-icon--garage::after {
  left: 0;
  top: 1px;

  width: 18px;
  height: 5px;

  border-left: 2px solid currentColor;
  border-top: 2px solid currentColor;

  transform: skewY(-30deg);
}


/* WRENCH */

.pixel-icon--wrench::before {
  left: 3px;
  top: 2px;

  width: 5px;
  height: 5px;

  border: 2px solid currentColor;

  transform: rotate(45deg);

  box-shadow:
    5px 5px 0 -1px currentColor,
    8px 8px 0 -1px currentColor;
}

.pixel-icon--wrench::after {
  right: 1px;
  bottom: 1px;

  width: 6px;
  height: 6px;

  border: 2px solid currentColor;
}


/* PERSON */

.pixel-icon--person::before {
  left: 6px;
  top: 1px;

  width: 6px;
  height: 6px;

  background: currentColor;
}

.pixel-icon--person::after {
  left: 3px;
  bottom: 1px;

  width: 12px;
  height: 8px;

  background: currentColor;
}


/* HELMET */

.pixel-icon--helmet::before {
  left: 2px;
  top: 3px;

  width: 14px;
  height: 10px;

  border: 2px solid currentColor;

  border-bottom: 0;
}

.pixel-icon--helmet::after {
  left: 7px;
  top: 10px;

  width: 9px;
  height: 5px;

  background: currentColor;
}


/* CLIPBOARD */

.pixel-icon--clipboard::before {
  left: 3px;
  top: 3px;

  width: 12px;
  height: 14px;

  border: 2px solid currentColor;
}

.pixel-icon--clipboard::after {
  left: 6px;
  top: 1px;

  width: 6px;
  height: 4px;

  background: currentColor;
}


/* TOOLBOX */

.pixel-icon--toolbox::before {
  left: 1px;
  bottom: 2px;

  width: 16px;
  height: 10px;

  border: 2px solid currentColor;
}

.pixel-icon--toolbox::after {
  left: 5px;
  top: 3px;

  width: 8px;
  height: 4px;

  border: 2px solid currentColor;
}


/* BOLT */

.pixel-icon--bolt::before {
  left: 7px;
  top: 0;

  width: 7px;
  height: 10px;

  background: currentColor;

  clip-path: polygon(
    40% 0,
    100% 0,
    65% 42%,
    100% 42%,
    18% 100%,
    38% 57%,
    0 57%
  );
}


/* SEARCH */

.pixel-icon--search::before {
  left: 2px;
  top: 2px;

  width: 9px;
  height: 9px;

  border: 2px solid currentColor;
}

.pixel-icon--search::after {
  right: 0;
  bottom: 0;

  width: 7px;
  height: 2px;

  background: currentColor;

  transform: rotate(45deg);
}


/* PLUS */

.pixel-icon--plus::before {
  left: 2px;
  top: 8px;

  width: 15px;
  height: 3px;

  background: currentColor;
}

.pixel-icon--plus::after {
  left: 8px;
  top: 2px;

  width: 3px;
  height: 15px;

  background: currentColor;
}


/* FLAG */

.pixel-icon--flag::before {
  left: 3px;
  top: 1px;

  width: 3px;
  height: 17px;

  background: currentColor;
}

.pixel-icon--flag::after {
  left: 6px;
  top: 2px;

  width: 10px;
  height: 8px;

  background: currentColor;

  clip-path: polygon(
    0 0,
    100% 0,
    75% 50%,
    100% 100%,
    0 100%
  );
}


/* =============================================================
   HEADER
   ============================================================= */

.garage-header {
  overflow: hidden;

  background: var(--g-panel);

  border: 2px solid var(--g-line-light);

  box-shadow:
    7px 7px 0 var(--g-black);
}

.garage-header-top,
.garage-header-bottom {
  min-height: 31px;

  display: grid;

  align-items: center;

  gap: 15px;

  padding: 0 11px;

  color: var(--g-dim);

  background: var(--g-black-2);

  font-family: var(--font-display);
  font-size: .47rem;
  font-weight: 900;

  letter-spacing: .08em;

  text-transform: uppercase;
}

.garage-header-top {
  grid-template-columns: 1fr auto auto;

  border-bottom: 2px solid var(--g-line);
}

.garage-header-bottom {
  grid-template-columns: 1fr auto auto;

  border-top: 2px solid var(--g-line);
}

.garage-head-left,
.garage-head-right,
.header-system {
  display: flex;
  align-items: center;
  gap: 7px;
}

.garage-head-left {
  color: var(--g-soft);
}

.garage-head-right,
.header-system {
  color: var(--g-accent);
}

.header-led,
.header-system i {
  width: 5px;
  height: 5px;

  display: block;

  background: var(--g-accent);
}

.garage-header-body {
  min-height: 345px;

  display: grid;

  grid-template-columns:
    minmax(0,1fr)
    260px;

  align-items: end;

  gap: 30px;

  padding: 32px;

  background:
    linear-gradient(
      90deg,
      rgba(255,255,255,.018),
      transparent 45%
    ),
    var(--g-panel);
}

.garage-header-copy {
  min-width: 0;
}

.garage-kicker-row {
  display: flex;
  align-items: center;
  gap: 9px;
}

.garage-title-icon {
  width: 25px;
  height: 25px;

  display: grid;
  place-items: center;

  border: 1px solid var(--g-line-light);

  color: var(--g-accent);

  background: var(--g-black-2);
}

.header-kicker {
  color: var(--g-dim);

  font-family: var(--font-display);
  font-size: .55rem;
  font-weight: 900;

  letter-spacing: .1em;

  text-transform: uppercase;
}

.garage-header-copy h1 {
  margin-top: 9px;

  color: var(--g-white);

  font-family: var(--font-display);
  font-size: clamp(4rem,11vw,8rem);
