  font-family: var(--font-display);
  font-size: .43rem;
  font-weight: 900;
}

.level-copy strong {
  grid-row: 1 / span 2;

  color: var(--g-accent);

  font-family: var(--font-display);
  font-size: 2rem;
  font-weight: 900;

  line-height: .8;
}

.level-copy small {
