      border-top:
        2px solid var(--g-line);
    }


    .race-head-left,
    .race-head-right,
    .header-system {

      display: flex;
      align-items: center;

      gap: 7px;
    }


    .race-head-left {
      color: var(--g-soft);
    }


    .race-head-right,
    .header-system {

      color: var(--g-accent);
    }


    .header-led,
    .header-system i {

      width: 5px;
      height: 5px;

      display: block;

      background: var(--g-accent);
    }


    .race-header-body {

      min-height: 345px;

      display: grid;

      grid-template-columns:
        minmax(0, 1fr)
        260px;

      align-items: end;

      gap: 30px;

      padding: 32px;

      background:
        linear-gradient(
          90deg,
          rgba(255,255,255,.018),
          transparent 45%
        ),
        var(--g-panel);
    }


    .race-header-copy {
      min-width: 0;
    }


    .race-kicker-row {

      display: flex;
      align-items: center;

      gap: 9px;
    }


    .race-title-icon {

      width: 25px;
      height: 25px;

      display: grid;
      place-items: center;

      border: 1px solid var(--g-line-light);

      color: var(--g-accent);

      background: var(--g-black-2);
    }


    .header-kicker {

      color: var(--g-dim);

      font-family: var(--font-display);
      font-size: .55rem;
      font-weight: 900;

      letter-spacing: .1em;

      text-transform: uppercase;
    }


    .race-header-copy h1 {

      margin-top: 9px;

      color: var(--g-white);

      font-family: var(--font-display);
      font-size:
        clamp(4rem, 11vw, 8rem);

      font-weight: 900;

      line-height: .74;

      letter-spacing: -.09em;

      text-transform: uppercase;
    }


    .header-rule {

      width:
        min(340px, 65%);

      height: 3px;

      margin-top: 20px;

      background: var(--g-accent);
    }


    .race-header-copy p {

      max-width: 680px;

      margin-top: 18px;

      color: var(--g-muted);

      font-size:
        var(--text-sm);

      line-height:
        1.65;
    }


    .race-header-panel {

      display: grid;

      gap: 8px;
    }


    .season-box {

      display: grid;

      grid-template-columns:
        54px
        1fr;

      gap: 10px;

      padding: 11px;

      border: 2px solid var(--g-line);

      background: var(--g-black-2);
    }


    .season-icon {

      width: 54px;
      height: 54px;

      display: grid;
      place-items: center;

      border: 1px solid var(--g-line-light);

      color: var(--g-accent);
    }


    .season-copy {

      display: grid;

      grid-template-columns:
        1fr
        auto;

      grid-template-rows:
        auto
        1fr;

      gap: 2px 7px;
    }


    .season-copy span {

      color: var(--g-dim);

      font-family: var(--font-display);
      font-size: .43rem;
      font-weight: 900;
    }


    .season-copy strong {

      grid-row:
        1 / span 2;

      color: var(--g-accent);

      font-family: var(--font-display);
      font-size: 2rem;
      font-weight: 900;

      line-height:
        .8;
    }


    .season-copy small {

      color: var(--g-muted);

      font-family: var(--font-display);
      font-size: .42rem;
      font-weight: 900;
    }


    .header-capacity {

      display: grid;

      grid-template-columns:
        repeat(3, 1fr);

      gap: 5px;
    }


    .header-capacity > div {

      padding: 8px;

      border: 1px solid var(--g-line);

      background: var(--g-black-2);
    }


    .header-capacity span,
    .header-capacity strong {

      display: block;
    }


    .header-capacity span {

      color: var(--g-dim);

      font-family: var(--font-display);
      font-size: .38rem;
      font-weight: 900;
    }


    .header-capacity strong {

      margin-top: 4px;

      color: var(--g-white);

      font-family: var(--font-display);
      font-size: .62rem;
      font-weight: 900;
    }


    .header-actions {

      display: grid;

      gap: 7px;
    }



    /* =============================================================
       SECTION
       ============================================================= */

    .race-page .section-header {

      min-height: 55px;

      margin-bottom: 10px;

      border-bottom:
        2px solid var(--g-line);
    }


    .race-page .section-heading {

      display: flex;
      align-items: center;

      gap: 11px;
    }


    .race-page .section-marker {

      width: 8px;
      height: 8px;

      flex: 0 0 auto;

      background: var(--g-white);

      box-shadow:
        4px 4px 0 var(--g-line-light);
    }


    .race-page .section-marker--accent {

      background: var(--g-accent);

      box-shadow:
        4px 4px 0 var(--g-accent-dark);
    }


    .race-page .section-kicker {

      display: block;

      color: var(--g-dim);

      font-family: var(--font-display);
      font-size: .52rem;
      font-weight: 900;

      letter-spacing: .1em;

      text-transform: uppercase;
    }


    .race-page .section-header h2 {

      margin-top: 4px;

      color: var(--g-white);

      font-family: var(--font-display);
      font-size:
        clamp(1.35rem, 3vw, 2rem);

      font-weight: 900;

      line-height: .9;

      letter-spacing: -.04em;

      text-transform: uppercase;
    }


    .race-page .section-code,
    .race-page .section-link {

      color: var(--g-dim);

      font-family: var(--font-display);
      font-size: .48rem;
      font-weight: 900;

      letter-spacing: .08em;

      text-transform: uppercase;
    }


    .race-page .section-link {

      color: var(--g-accent);
    }



    /* =============================================================
       STATUS
       ============================================================= */

    .race-status-grid {

      display: grid;

      grid-template-columns:
        repeat(4, 1fr);

      border-top:
        2px solid var(--g-line);

      border-left:
        2px solid var(--g-line);
    }


    .race-status-card {

      min-height: 142px;

      display: flex;
      flex-direction: column;
      justify-content: space-between;

      padding: 13px;

      border-right:
        2px solid var(--g-line);

      border-bottom:
        2px solid var(--g-line);

      background: var(--g-panel);
    }


    .race-status-card--active {

      background: var(--g-panel-2);

      border-top:
        3px solid var(--g-accent);
    }


    .race-status-head,
    .race-status-foot {

      display: flex;
      align-items: center;
      justify-content: space-between;

      gap: 8px;

      color: var(--g-dim);

      font-family: var(--font-display);
      font-size: .45rem;
      font-weight: 900;

      text-transform: uppercase;
    }


    .race-status-ident {

      display: flex;
      align-items: center;

      gap: 7px;
    }


    .race-status-icon {

      width: 25px;
      height: 25px;

      display: grid;
      place-items: center;

      border: 1px solid var(--g-line-light);

      color: var(--g-soft);
    }


    .race-status-card--active
    .race-status-icon {

      color: var(--g-accent);

      border-color:
        var(--g-accent-dark);
    }


    .race-status-value {

      color: var(--g-white);

      font-family: var(--font-display);
      font-size: 2rem;
      font-weight: 900;

      line-height: .8;
    }


    .segment-bar {

      display: grid;

      grid-template-columns:
        repeat(8, 1fr);

      flex: 1;

      gap: 3px;
    }


    .segment-bar i {

      height: 4px;

      background: var(--g-line-light);
    }


    .segment-bar .segment-active {

      background: var(--g-accent-dark);
    }


    .race-status-card--active
    .segment-bar
    .segment-active {

      background: var(--g-accent);
    }



    /* =============================================================
       FILTER
       ============================================================= */

    .race-filter-panel {

      display: grid;

      grid-template-columns:
        minmax(0, 1fr)
        135px;

      background: var(--g-panel);

      border: 2px solid var(--g-line-light);

      box-shadow:
        5px 5px 0 var(--g-black);
    }


    .race-filter-main {
      padding: 15px;
    }


    .race-filter-copy {

      display: flex;
      align-items: center;

      gap: 10px;
    }


    .race-filter-icon {

      width: 29px;
      height: 29px;

      display: grid;
      place-items: center;

      border: 1px solid var(--g-line-light);

      color: var(--g-accent);

      background: var(--g-black-2);
    }


    .race-filter-copy > div {

      display: flex;
      flex-direction: column;

      gap: 3px;
    }


    .race-filter-copy span {

      color: var(--g-dim);

      font-family: var(--font-display);
      font-size: .4rem;
      font-weight: 900;

      text-transform: uppercase;
    }


    .race-filter-copy strong {

      color: var(--g-white);

      font-size: .68rem;

      line-height: 1.35;
    }


    .race-filter-list {

      display: flex;
      flex-wrap: wrap;

      gap: 6px;

      margin-top: 13px;
      padding-top: 12px;

      border-top:
        1px solid var(--g-line);
    }


    .race-filter-button {

      min-height: 36px;

      display: inline-flex;
      align-items: center;
      justify-content: space-between;

      gap: 10px;

      padding: 7px 10px;

      border: 2px solid var(--g-line);

      background: var(--g-panel-2);

      color: var(--g-muted);

      font-family: var(--font-display);
      font-size: .4rem;
      font-weight: 900;

      letter-spacing: .06em;

      text-transform: uppercase;

      cursor: pointer;

      transition:
        transform 70ms steps(1),
        border-color 70ms steps(1),
        color 70ms steps(1),
        background 70ms steps(1);
    }


    .race-filter-button:hover {

      border-color:
        var(--g-line-light);

      color: var(--g-white);

      background: var(--g-panel-3);
    }


    .race-filter-button:active {

      transform:
        translate(2px, 2px);
    }


    .race-filter-button:focus-visible {

      outline:
        2px solid var(--g-accent);

      outline-offset: 3px;
    }


    .race-filter-button small {

      min-width: 20px;

      padding: 2px 4px;

      color: var(--g-dim);

      background: var(--g-black);

      font-size: .38rem;

      text-align: center;
    }


    .race-filter-button--active {

      border-color:
        var(--g-accent);

      background:
        var(--g-accent);

      color: var(--g-black);

      box-shadow:
        3px 3px 0 var(--g-black);
    }


    .race-filter-button--active small {

      background: var(--g-black);

      color: var(--g-accent);
    }


    .race-filter-status {

      display: flex;
      flex-direction: column;
      justify-content: space-between;

      padding: 12px;

      border-left:
        2px solid var(--g-line);

      background: var(--g-black-2);

      color: var(--g-dim);

      font-family: var(--font-display);
      font-size: .4rem;
      font-weight: 900;

      letter-spacing: .08em;

      text-transform: uppercase;
    }


    .race-filter-count {

      color: var(--g-accent);

      font-size: 2rem;

      line-height: 1;
    }



    /* =============================================================
       EVENTS
       ============================================================= */

    .race-event-list {

      display: grid;

      gap: 10px;
    }


    .race-event {

      display: grid;

      grid-template-columns:
        185px
        minmax(0, 1fr);

      min-width: 0;

      overflow: hidden;

      background: var(--g-panel);

      border: 2px solid var(--g-line-light);

      box-shadow:
        5px 5px 0 var(--g-black);

      transition:
        transform 70ms steps(1),
        border-color 70ms steps(1),
        box-shadow 70ms steps(1);
    }


    .race-event:hover {

      transform:
        translate(-2px, -2px);

      border-color:
        var(--g-line-light);

      box-shadow:
        7px 7px 0 var(--g-black);
    }


    .race-event--featured {

      border-color:
        var(--g-accent-dark);
    }


    .race-event--selected {

      border-color:
        var(--g-accent);

      box-shadow:
        6px 6px 0 var(--g-black);
    }


    .race-event[hidden] {

      display: none;
    }


    .race-event-visual {

      min-height: 250px;

      position: relative;

      overflow: hidden;

      display: grid;
      place-items: center;

      border-right:
        2px solid var(--g-line);

      background:
        linear-gradient(
          135deg,
          #191b19 25%,
          #151715 25%,
          #151715 50%,
          #191b19 50%,
          #191b19 75%,
          #151715 75%
        );

      background-size: 22px 22px;
    }


    .race-event-number {

      position: absolute;

      left: 11px;
      top: 11px;

      display: flex;
      flex-direction: column;

      gap: 3px;
    }


    .race-event-number span {

      color: var(--g-dim);

      font-family: var(--font-display);
      font-size: .38rem;
      font-weight: 900;
    }


    .race-event-number strong {

      color: var(--g-white);

      font-family: var(--font-display);
      font-size: 2.3rem;
      font-weight: 900;

      line-height: .8;

      letter-spacing:
        -.08em;
    }


    .race-event-type {

      position: absolute;

      top: 11px;
      right: 11px;

      padding:
        5px 7px;

      border:
        1px solid var(--g-line-light);

      background:
        var(--g-black-2);

      color: var(--g-soft);

      font-family: var(--font-display);
      font-size: .37rem;
      font-weight: 900;

      letter-spacing: .07em;

      text-transform:
        uppercase;
    }


    .race-event-type--accent {

      color: var(--g-accent);

      border-color:
        var(--g-accent-dark);
    }


    .race-event-type--danger {

      color: var(--g-danger);

      border-color:
        var(--g-danger);
    }


    .race-track {

      width: 128px;
      height: 164px;

      position: relative;

      overflow: hidden;

      border: 2px solid var(--g-black);

      background: #191a17;

      box-shadow:
        5px 5px 0 var(--g-black);

      transform:
        perspective(500px)
        rotateX(10deg);
    }


    .race-track-surface {

      position: absolute;
      inset: 0;

      background:
        repeating-linear-gradient(
          to bottom,
          #24251f 0 8px,
          #1f201b 8px 16px
        );
    }


    .track-line {

      position: absolute;

      left: 14px;
      width: 96px;

      height: 3px;

      background: var(--g-line-light);
    }


    .track-line--1 {
      top: 39px;
    }


    .track-line--2 {
      top: 80px;
    }


    .track-line--3 {
      top: 121px;
    }


    .track-finish {

      position: absolute;

      left: 9px;
      right: 9px;
      top: 9px;

      height: 17px;

      border:
        2px solid var(--g-black);

      background:
        linear-gradient(
          90deg,
          var(--g-white) 0 9px,
          var(--g-black) 9px 18px,
          var(--g-white) 18px 27px,
          var(--g-black) 27px 36px,
          var(--g-white) 36px 45px,
          var(--g-black) 45px 54px,
          var(--g-white) 54px 63px,
          var(--g-black) 63px 72px,
          var(--g-white) 72px 81px,
          var(--g-black) 81px 90px
        );
    }


    .track-ruler {

      position: absolute;

      left: 8px;
      bottom: 8px;

      color:
        rgba(241,241,235,.3);

      font-family:
        var(--font-display);

      font-size: .37rem;
      font-weight: 900;
    }


    .race-event-content {

      min-width: 0;

      padding: 17px;
    }


    .race-event-top {

      display: flex;
      align-items: flex-start;
      justify-content: space-between;

      gap: 14px;
    }


    .race-event-meta {

      display: flex;
      align-items: center;
      flex-wrap: wrap;

      gap: 7px;

      color: var(--g-dim);

      font-family:
        var(--font-display);

      font-size: .39rem;
      font-weight: 900;

      letter-spacing: .07em;

      text-transform:
        uppercase;
    }


    .race-event-meta i {

      width: 3px;
      height: 3px;

      background:
        var(--g-line-light);
    }


    .race-event-top h3 {

      margin-top: 7px;

      color: var(--g-white);

      font-family:
        var(--font-display);

      font-size:
        clamp(1.45rem, 3vw, 2.25rem);

      font-weight: 900;

      line-height: .9;

      letter-spacing: -.05em;

      text-transform: uppercase;
    }


    .race-status-badge {

      display: inline-flex;
      align-items: center;

      gap: 6px;

      padding:
        5px 7px;

      border:
        1px solid var(--g-accent-dark);

      color:
        var(--g-accent);

      background:
        var(--g-black-2);

      font-family:
        var(--font-display);

      font-size: .37rem;
      font-weight: 900;

      white-space:
        nowrap;
    }


    .race-status-badge i {

      width: 5px;
      height: 5px;

      background:
        var(--g-accent);
    }


    .race-event-note {

      max-width: 700px;

      margin-top: 11px;

      color: var(--g-muted);

      font-size: .72rem;

      line-height:
        1.55;
    }


    .race-spec-grid {

      display: grid;

      grid-template-columns:
        repeat(4, minmax(0,1fr));

      gap: 6px;

      margin-top: 15px;
    }


    .race-spec-grid > div {

      min-width: 0;

      display: flex;
      flex-direction: column;

      gap: 4px;

      padding: 8px;

      border:
        1px solid var(--g-line);

      background:
        var(--g-black-2);
    }


    .race-spec-grid span,
    .race-money span {

      color: var(--g-dim);

      font-family:
        var(--font-display);

      font-size: .36rem;
      font-weight: 900;
    }


    .race-spec-grid strong,
    .race-money strong {

      color: var(--g-white);

      font-family:
        var(--font-display);

      font-size: .55rem;
      font-weight: 900;

      overflow-wrap:
        anywhere;

      text-transform:
        uppercase;
    }


    .race-event-footer {

      display: flex;

      align-items:
        center;

      justify-content:
        space-between;

      gap: 14px;

      margin-top: 13px;
      padding-top: 13px;

      border-top:
        1px solid var(--g-line);
    }


    .race-money {

      display: flex;

      gap: 24px;
    }


    .race-money > div {

      display: flex;
      flex-direction: column;

      gap: 4px;
    }


    .race-money strong {

      font-size: .73rem;
    }


    .race-select-button {

      min-height: 39px;

      display: inline-flex;
      align-items: center;
      justify-content: space-between;

      gap: 16px;

      min-width: 110px;

      padding:
        0 10px;

      border:
        2px solid var(--g-line-light);

      background:
        var(--g-panel-2);

      color:
        var(--g-white);

      box-shadow:
        3px 3px 0 var(--g-black);

      font-family:
        var(--font-display);

      font-size: .39rem;
      font-weight: 900;

      letter-spacing: .06em;

      cursor: pointer;

      text-transform:
        uppercase;
    }


    .race-select-button:hover,
    .race-select-button--active {

      border-color:
        var(--g-accent);

      background:
        var(--g-accent);

      color:
        var(--g-black);
    }


    .race-select-button:active {

      transform:
        translate(2px,2px);
    }


    .race-empty {

      min-height: 185px;

      display: flex;
      flex-direction: column;

      align-items: center;
      justify-content: center;

      gap: 7px;

      border:
        2px dashed var(--g-line-light);

      background:
        var(--g-panel);
    }


    .race-empty[hidden] {
      display: none;
    }


    .race-empty .pixel-icon {
      color: var(--g-dim);
    }


    .race-empty strong {

      color: var(--g-white);

      font-family:
        var(--font-display);

      font-size: .72rem;
      font-weight: 900;
    }


    .race-empty span:last-child {

      color:
        var(--g-dim);

      font-size:
        .62rem;
    }



    /* =============================================================
       SETUP
       ============================================================= */

    .race-setup-grid {

      display: grid;

      grid-template-columns:
        minmax(0,1.15fr)
        repeat(2,minmax(0,.925fr));

      gap: 8px;
    }


    .setup-panel {

      min-width: 0;

      display: flex;
      flex-direction: column;

      padding: 14px;

      background:
        var(--g-panel);

      border:
        2px solid var(--g-line);

      box-shadow:
        5px 5px 0 var(--g-black);
    }


    .setup-panel--event {

      border-color:
        var(--g-accent-dark);
    }


    .setup-panel-top {

      min-height: 35px;

      display: flex;

      align-items: center;

      justify-content: space-between;

      gap: 10px;

      padding-bottom: 10px;

      border-bottom:
        1px solid var(--g-line);
    }


    .setup-panel-ident {

      display: flex;

      align-items: center;

      gap: 8px;
    }


    .setup-icon {

      width: 29px;
      height: 29px;

      display: grid;

      place-items: center;

      border:
        1px solid var(--g-line-light);

      color:
        var(--g-accent);

      background:
        var(--g-black-2);
    }


    .setup-panel-ident > div {

      display: flex;
      flex-direction: column;

      gap: 3px;
    }


    .setup-panel-ident span {

      color:
        var(--g-dim);

      font-family:
        var(--font-display);

      font-size: .36rem;
      font-weight: 900;

      text-transform:
        uppercase;
    }


    .setup-panel-ident strong {

      color:
        var(--g-white);

      font-family:
        var(--font-display);

      font-size: .58rem;
      font-weight: 900;
    }


    .setup-state {

      color:
        var(--g-dim);

      font-family:
        var(--font-display);

      font-size: .39rem;
      font-weight: 900;
    }


    .setup-state--accent {

      color:
        var(--g-accent);
    }


    .setup-event-title {

      margin-top: 15px;
    }


    .setup-event-title > span {

      color:
        var(--g-dim);

      font-family:
        var(--font-display);

      font-size: .38rem;
      font-weight: 900;
    }


    .setup-event-title h3 {

      margin-top: 5px;

      color:
        var(--g-white);

      font-family:
        var(--font-display);

      font-size:
        clamp(1.25rem,2.8vw,1.9rem);

      font-weight:
        900;

      line-height:
        .9;

      letter-spacing:
        -.045em;

      text-transform:
        uppercase;
    }


    .setup-event-class {

      display: inline-flex;
      align-self: flex-start;

      margin-top: 10px;

      padding:
        5px 7px;

      border:
        1px solid var(--g-accent-dark);

      color:
        var(--g-accent);

      background:
        var(--g-black-2);

      font-family:
        var(--font-display);

      font-size: .4rem;
      font-weight: 900;
    }


    .setup-data-grid {

      display: grid;

      grid-template-columns:
        repeat(2,minmax(0,1fr));

      gap: 6px;

      margin-top: 14px;
    }


    .setup-data-grid > div {

      min-width: 0;

      display: flex;
      flex-direction: column;

      gap: 4px;

      padding:
        8px;

      border:
        1px solid var(--g-line);

      background:
        var(--g-black-2);
    }


    .setup-data-grid > div:last-child {

      grid-column:
        1 / -1;
    }


    .setup-data-grid span {

      color:
        var(--g-dim);

      font-family:
        var(--font-display);

      font-size:
        .35rem;

      font-weight:
        900;
    }


    .setup-data-grid strong {

      color:
        var(--g-white);

      font-family:
        var(--font-display);

      font-size:
        .55rem;

      font-weight:
        900;

      overflow-wrap:
        anywhere;

      text-transform:
        uppercase;
    }


    .setup-panel-footer {

      display: flex;

      align-items:
        center;

      justify-content:
        space-between;

      gap:
        10px;

      margin-top:
        auto;

      padding-top:
        12px;

      border-top:
        1px solid var(--g-line);
    }


    .setup-ready {

      display: inline-flex;

      align-items:
        center;

      gap: 7px;

      color:
        var(--g-muted);

      font-family:
        var(--font-display);

      font-size:
        .38rem;

      font-weight:
        900;
    }


    .setup-ready i {

      width:
        5px;

      height:
        5px;

      background:
        var(--g-accent);
    }


    .setup-code {

      color:
        var(--g-dim);

      font-family:
        var(--font-display);

      font-size:
        .37rem;

      font-weight:
        900;
    }


    .setup-heading-block {

      display:
        flex;

      align-items:
        flex-start;

      justify-content:
        space-between;

      gap:
        10px;

      margin-top:
        14px;
    }


    .setup-heading-block > div {

      min-width:
        0;
    }


    .setup-heading-block span:first-child {

      display:
        block;

      color:
        var(--g-dim);

      font-family:
        var(--font-display);

      font-size:
        .35rem;

      font-weight:
        900;
    }


    .setup-heading-block h3 {

      margin-top:
        5px;

      color:
        var(--g-white);

      font-family:
        var(--font-display);

      font-size:
        1.08rem;

      font-weight:
        900;

      line-height:
        .9;

      text-transform:
        uppercase;
    }


    .setup-level {

      padding:
        5px 6px;

      color:
        var(--g-accent);

      border:
        1px solid var(--g-accent-dark);

      font-family:
        var(--font-display);

      font-size:
        .36rem;

      font-weight:
        900;
    }


    .motor-setup-display,
    .driver-setup-display {

      display:
        grid;

      grid-template-columns:
        112px minmax(0,1fr);

      gap:
        9px;

      margin-top:
        14px;
    }


    .motor-stage,
    .driver-stage {

      min-height:
        174px;

      position:
        relative;

      display:
        grid;

      place-items:
        center;

      overflow:
        hidden;

      border:
        1px solid var(--g-line);

      background:
        repeating-linear-gradient(
          135deg,
          #171917 0 8px,
          #131513 8px 16px
        );
    }


    .stage-cross {

      position:
        absolute;

      width:
        92px;

      height:
        92px;

      border:
        1px dashed
        rgba(241,241,235,.08);
    }


    .stage-line {

      position:
        absolute;

      left:
        12%;

      right:
        12%;

      bottom:
        25px;

      height:
        3px;

      background:
        var(--g-line-light);
    }


    .setup-bike {

      position:
        relative;

      width:
        170px;

      height:
        98px;

      color:
        var(--g-white);

      transform:
        scale(.66);

      image-rendering:
        pixelated;

      filter:
        drop-shadow(
          5px 5px 0 var(--g-black)
        );
    }


    .setup-bike span {

      position:
        absolute;

      display:
        block;
    }


    .setup-bike__wheel {

      bottom:
        5px;

      width:
        34px;

      height:
        34px;

      border:
        5px solid var(--g-black);

      box-shadow:
        inset
        0 0 0 2px var(--g-soft);
    }


    .setup-bike__wheel--rear {
      left:
        17px;
    }


    .setup-bike__wheel--front {
      right:
        17px;
    }


    .setup-bike__frame {

      left:
        47px;

      top:
        53px;

      width:
        70px;

      height:
        4px;

      background:
        var(--g-white);

      transform:
        skew(-18deg);
    }


    .setup-bike__body {

      left:
        58px;

      top:
        41px;

      width:
        48px;

      height:
        19px;

      background:
        var(--g-accent);

      clip-path:
        polygon(
          0 30%,
          23% 0,
          82% 0,
          100% 60%,
          77% 100%,
          15% 100%
        );
    }


    .setup-bike__tank {

      left:
        63px;

      top:
        28px;

      width:
        35px;

      height:
        20px;

      background:
        var(--g-white);

      border:
        3px solid var(--g-black);

      clip-path:
        polygon(
          0 18%,
          24% 0,
          82% 0,
          100% 50%,
          77% 100%,
          20% 100%
        );
    }


    .setup-bike__seat {

      left:
        59px;

      top:
        20px;

      width:
        37px;

      height:
        8px;

      background:
        var(--g-black);
    }


    .setup-bike__engine {

      left:
        69px;

      top:
        50px;

      width:
        22px;

      height:
        20px;

      background:
        var(--g-line);

      border:
        3px solid var(--g-black);
    }


    .setup-bike__pipe {

      left:
        83px;

      top:
        67px;

      width:
        43px;

      height:
        6px;

      border-bottom:
        4px solid var(--g-soft);

      transform:
        skew(18deg);
    }


    .setup-bike__fork {

      right:
        35px;

      top:
        34px;

      width:
        4px;

      height:
        34px;

      background:
        var(--g-black);

      transform:
        rotate(18deg);
      transform-origin:
        top center;
    }


    .setup-bike__handle {

      right:
        19px;

      top:
        29px;

      width:
        21px;

      height:
        5px;

      background:
        var(--g-black);
    }


    .setup-meter-list {

      display:
        flex;

      flex-direction:
        column;

      justify-content:
        center;

      gap:
        9px;
    }


    .setup-meter-row {

      display:
        grid;

      grid-template-columns:
        45px 23px minmax(0,1fr);

      align-items:
        center;

      gap:
        5px;
    }


    .setup-meter-row > span {

      color:
        var(--g-dim);

      font-family:
        var(--font-display);

      font-size:
        .34rem;

      font-weight:
        900;
    }


    .setup-meter-row strong {

      color:
        var(--g-white);

      font-family:
        var(--font-display);

      font-size:
        .48rem;

      font-weight:
        900;

      text-align:
        right;
    }


    .setup-meter-row > div {

      height:
        5px;

      overflow:
        hidden;

      border:
        1px solid var(--g-line);

      background:
        var(--g-black);
    }


    .setup-meter-row i {

      display:
        block;

      height:
        100%;

      background:
        var(--g-soft);
    }


    .setup-meter-row i.is-accent {

      background:
        var(--g-accent);
    }


    .setup-panel > .btn {

      width:
        100%;

      margin-top:
        12px;
    }


    /* DRIVER */

    .driver-shadow {

      position:
        absolute;

      left:
        19px;

      bottom:
        17px;

      width:
        73px;

      height:
        8px;

      background:
        var(--g-black);
    }


    .driver-head {

      position:
        absolute;

      left:
        45px;

      top:
        36px;

      width:
        24px;

      height:
        29px;

      background:
        #b7b7af;

      border:
        4px solid
        var(--g-black);
    }


    .driver-helmet {

      position:
        absolute;

      left:
        37px;

      top:
        24px;

      width:
        42px;

      height:
        27px;

      background:
        var(--g-white);

      border:
        4px solid
        var(--g-black);
    }


    .driver-visor {

      position:
        absolute;

      left:
        58px;

      top:
        36px;

      width:
        23px;

      height:
        8px;

      background:
        var(--g-black);

      border:
        2px solid
        var(--g-line-light);
    }


    .driver-neck {

      position:
        absolute;

      left:
        53px;

      top:
        61px;

      width:
        11px;

      height:
        9px;

      background:
        #898982;

      border:
        3px solid
        var(--g-black);
    }


    .driver-body {

      position:
        absolute;

      left:
        29px;

      top:
        67px;

      width:
        57px;

      height:
        45px;

      background:
        #6d3834;

      border:
        4px solid
        var(--g-black);

      clip-path:
        polygon(
          19% 0,
          76% 0,
          100% 26%,
          87% 100%,
          12% 100%,
          0 26%
        );
    }


    .driver-arm {

      position:
        absolute;

      top:
        73px;

      width:
        15px;

      height:
        37px;

      background:
        #6d3834;

      border:
        4px solid
        var(--g-black);
    }


    .driver-arm--left {

      left:
        15px;

      transform:
        rotate(18deg);
    }


    .driver-arm--right {

      right:
        15px;

      transform:
        rotate(-18deg);
    }


    .driver-stage-code {

      position:
        absolute;

      right:
        7px;

      bottom:
        6px;

      color:
        rgba(241,241,235,.28);

      font-family:
        var(--font-display);

      font-size:
        .34rem;

      font-weight:
        900;
    }


    .driver-stat-grid {

      display:
        grid;

      grid-template-columns:
        repeat(2,1fr);

      gap:
        6px;

      align-content:
        center;
    }


    .driver-stat-grid > div {

      min-height:
        46px;

      display:
        flex;

      flex-direction:
        column;

      justify-content:
        center;

      gap:
        4px;

      padding:
        7px;

      border:
        1px solid var(--g-line);

      background:
        var(--g-black-2);
    }


    .driver-stat-grid span {

      color:
        var(--g-dim);

      font-family:
        var(--font-display);

      font-size:
        .33rem;

      font-weight:
        900;
    }


    .driver-stat-grid strong {

      color:
        var(--g-white);

      font-family:
        var(--font-display);

      font-size:
        .55rem;

      font-weight:
        900;
    }



    /* =============================================================
       RISK
       ============================================================= */

    .risk-grid {

      display:
        grid;

      grid-template-columns:
        repeat(3,1fr);

      gap:
        8px;
    }


    .risk-card {

      min-width:
        0;

      min-height:
        170px;

      display:
        flex;

      flex-direction:
        column;

      padding:
        13px;

      text-align:
        left;

      border:
        2px solid var(--g-line);

      background:
        var(--g-panel);

      color:
        var(--g-white);

      cursor:
        pointer;

      transition:
        transform 70ms steps(1),
        background 70ms steps(1),
        border-color 70ms steps(1);
    }


    .risk-card:hover {

      transform:
        translate(-2px,-2px);

      border-color:
        var(--g-line-light);

      background:
        var(--g-panel-2);
    }


    .risk-card:focus-visible {

      outline:
        2px solid var(--g-accent);

      outline-offset:
        3px;
    }


    .risk-card--active {

      border-color:
        var(--g-accent);

      box-shadow:
        5px 5px 0 var(--g-black);
    }


    .risk-card-top {

      display:
        flex;

      align-items:
        center;

      justify-content:
        space-between;

      gap:
        10px;
    }


    .risk-number {

      width:
        28px;

      height:
        28px;

      display:
        grid;

      place-items:
        center;

      border:
        2px solid var(--g-line-light);

      background:
        var(--g-black-2);

      color:
        var(--g-dim);

      font-family:
        var(--font-display);

      font-size:
        .45rem;

      font-weight:
        900;
    }


    .risk-card--active
    .risk-number {

      color:
        var(--g-black);

      background:
        var(--g-accent);

      border-color:
        var(--g-accent);
    }


    .risk-tag {

      color:
        var(--g-dim);

      font-family:
        var(--font-display);

      font-size:
        .36rem;

      font-weight:
        900;

      letter-spacing:
        .07em;
    }


    .risk-card-body {

      padding:
        17px 0;
    }


    .risk-card-body strong {

      color:
        var(--g-white);

      font-family:
        var(--font-display);

      font-size:
        1.1rem;

      font-weight:
        900;

      line-height:
        .9;

      text-transform:
        uppercase;
    }


    .risk-card-body p {

      margin-top:
        8px;

      color:
        var(--g-muted);

      font-size:
        .64rem;

      line-height:
        1.55;
    }


    .risk-card-bottom {

      margin-top:
        auto;

      display:
        flex;

      align-items:
        center;

      justify-content:
        space-between;

      gap:
        10px;

      padding-top:
        10px;

      border-top:
        1px solid var(--g-line);
    }


    .risk-meter {

      display:
        flex;

      gap:
        4px;
    }


    .risk-meter i {

      width:
        22px;

      height:
        5px;

      background:
        var(--g-line-light);
    }


    .risk-meter i.active {

      background:
        var(--g-accent-dark);
    }


    .risk-card[data-risk="safe"]
    .risk-meter i.active {

      background:
        var(--g-white);
    }


    .risk-card[data-risk="push"]
    .risk-meter i.active {

      background:
        var(--g-danger);
    }


    .risk-card--active
    .risk-meter i.active {

      background:
        var(--g-accent);
    }


    .risk-card[data-risk="push"].risk-card--active
    .risk-meter i.active {

      background:
        var(--g-danger);
    }


    .risk-check {

      width:
        19px;

      height:
        19px;

      display:
        grid;

      place-items:
        center;

      border:
        1px solid var(--g-line-light);

      color:
        transparent;

      font-family:
        var(--font-display);

      font-size:
        .47rem;

      font-weight:
        900;
    }


    .risk-card--active
    .risk-check {

      color:
        var(--g-black);

      background:
        var(--g-accent);

      border-color:
        var(--g-accent);
    }



    /* =============================================================
       START RACE
       ============================================================= */

    .start-race {

      overflow:
        hidden;

      border:
        2px solid var(--g-line-light);

      background:
        var(--g-panel);

      box-shadow:
        7px 7px 0 var(--g-black);
    }


    .start-race-topbar {

      min-height:
        32px;

      display:
        flex;

      align-items:
        center;

      justify-content:
        space-between;

      padding:
        0 11px;

      color:
        var(--g-dim);

      background:
        var(--g-black-2);

      border-bottom:
        2px solid var(--g-line);

      font-family:
        var(--font-display);

      font-size:
        .4rem;

      font-weight:
        900;

      letter-spacing:
        .08em;

      text-transform:
        uppercase;
    }


    .start-race-topbar span:last-child {

      color:
        var(--g-accent);
    }


    .start-race-body {

      display:
        grid;

      grid-template-columns:
        minmax(0,1.3fr)
        auto
        190px;

      align-items:
        end;

      gap:
        16px;

      padding:
        18px;

      background:
        repeating-linear-gradient(
          to bottom,
          #181816 0 5px,
          #131310 5px 10px
        );
    }


    .start-race-copy h2 {

      margin-top:
        5px;

      color:
        var(--g-white);

      font-family:
        var(--font-display);

      font-size:
        clamp(2.2rem,5vw,4.1rem);

      font-weight:
        900;

      line-height:
        .8;

      letter-spacing:
        -.075em;

      text-transform:
        uppercase;
    }


    .final-build {

      display:
        flex;

      flex-wrap:
        wrap;

      align-items:
        center;

      gap:
        6px;

      margin-top:
        11px;

      color:
        var(--g-soft);

      font-family:
        var(--font-display);

      font-size:
        .42rem;

      font-weight:
        900;

      text-transform:
        uppercase;
    }


    .final-build i {

      color:
        var(--g-dim);
    }


    .final-status {

      display:
        flex;

      flex-wrap:
        wrap;

      gap:
        9px;

      margin-top:
        11px;

      color:
        var(--g-dim);

      font-family:
        var(--font-display);

      font-size:
        .37rem;

      font-weight:
        900;

      text-transform:
        uppercase;
    }


    .final-status span {

      display:
        inline-flex;

      align-items:
        center;

      gap:
        5px;
    }


    .final-status i {

      width:
        5px;

      height:
        5px;

      background:
        var(--g-accent);
    }


    .start-race-data {

      display:
        grid;

      grid-template-columns:
        repeat(3,minmax(65px,1fr));

      gap:
        5px;
    }


    .start-race-data > div {

      min-width:
        0;

      display:
        flex;

      flex-direction:
        column;

      gap:
        5px;

      padding:
        8px;

      background:
        var(--g-panel);

      border:
        1px solid var(--g-line);
    }


    .start-race-data span {

      color:
        var(--g-dim);

      font-family:
        var(--font-display);

      font-size:
        .35rem;

      font-weight:
        900;
    }


    .start-race-data strong {

      color:
        var(--g-white);

      font-family:
        var(--font-display);

      font-size:
        .55rem;

      font-weight:
        900;

      overflow-wrap:
        anywhere;
    }


    .start-race-action {

      min-width:
        0;
    }


    .start-race-action .btn {

      width:
        100%;
    }


    .start-race-action > span {

      display:
        block;

      margin-top:
        6px;

      color:
        var(--g-dim);

      font-family:
        var(--font-display);

      font-size:
        .34rem;

      font-weight:
        900;

      text-align:
        center;

      letter-spacing:
        .04em;
    }



    /* =============================================================
       TABLE
       ============================================================= */

    .table-panel,
    .history-panel {

      overflow:
        hidden;

      background:
        var(--g-panel);

      border:
        2px solid var(--g-line-light);

      box-shadow:
        6px 6px 0 var(--g-black);
    }


    .table-header {

      min-height:
        36px;

      display:
        grid;

      grid-template-columns:
        54px
        minmax(0,1fr)
        65px
        75px;

      align-items:
        center;

      gap:
        10px;

      padding:
        0 12px;

      background:
        var(--g-black-2);

      border-bottom:
