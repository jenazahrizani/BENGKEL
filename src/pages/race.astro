  <script>
    const raceData = {
      "RACE-001": {
        name: "ABIANSEMAL NIGHT RUN",
        type: "OFFICIAL",
        track: "200 M / ASPAL",
        weather: "KERING",
        entry: "Rp 75.000",
        prize: "Rp 350.000",
      },

      "RACE-002": {
        name: "MENGWI STREET CUP",
        type: "OFFICIAL",
        track: "250 M / ASPAL",
        weather: "BERANGIN",
        entry: "Rp 100.000",
        prize: "Rp 500.000",
      },

      "RACE-003": {
        name: "KUTA TEST NIGHT",
        type: "LIAR",
        track: "200 M / ASPAL",
        weather: "LEMBAB",
        entry: "Rp 125.000",
        prize: "Rp 650.000",
      },
    } as const;

    const filterButtons = Array.from(
      document.querySelectorAll<HTMLElement>(
        "[data-filter]"
      )
    );

    const raceCards = Array.from(
      document.querySelectorAll<HTMLElement>(
        "[data-race-card]"
      )
    );

    const emptyState = document.querySelector<HTMLElement>(
      "[data-empty-state]"
    );

    const selectedEvent = document.querySelector<HTMLElement>(
      "[data-selected-event]"
    );

    const selectedType = document.querySelector<HTMLElement>(
      "[data-selected-type]"
    );

    const selectedTrack = document.querySelector<HTMLElement>(
      "[data-selected-track]"
    );

    const selectedWeather =
      document.querySelector<HTMLElement>(
        "[data-selected-weather]"
      );

    const selectedEntry =
      document.querySelector<HTMLElement>(
        "[data-selected-entry]"
      );

    const selectedPrize =
      document.querySelector<HTMLElement>(
        "[data-selected-prize]"
      );

    const selectedCode =
      document.querySelector<HTMLElement>(
        "[data-selected-code]"
      );

    const startEntry =
      document.querySelector<HTMLElement>(
        "[data-start-entry]"
      );

    const startPrize =
      document.querySelector<HTMLElement>(
        "[data-start-prize]"
      );

    const selectedRisk =
      document.querySelector<HTMLElement>(
        "[data-selected-risk]"
      );

    const finalEvent =
      document.querySelector<HTMLElement>(
        "[data-final-event]"
      );

    const riskButtons = Array.from(
      document.querySelectorAll<HTMLButtonElement>(
        "[data-risk]"
      )
    );

    const eventButtons = Array.from(
      document.querySelectorAll<HTMLButtonElement>(
        "[data-select-race]"
      )
    );

    const applyFilter = (filterId: string) => {
      let visibleCount = 0;

      raceCards.forEach((card) => {
        const show =
          filterId === "all" ||
          card.dataset.category === filterId;

        card.hidden = !show;

        if (show) {
          visibleCount += 1;
        }
      });

      if (emptyState) {
        emptyState.hidden = visibleCount !== 0;
      }
    };

    filterButtons.forEach((button) => {
      button.addEventListener("click", () => {
        filterButtons.forEach((item) => {
          const active = item === button;

          item.classList.toggle(
            "race-filter-button--active",
            active
          );

          item.setAttribute(
            "aria-pressed",
            active ? "true" : "false"
          );
        });

        applyFilter(
          button.dataset.filter || "all"
        );
      });
    });

    const updateRace = (raceId: string) => {
      const race =
        raceData[raceId as keyof typeof raceData];

      if (!race) return;

      if (selectedEvent) {
        selectedEvent.textContent = race.name;
      }

      if (finalEvent) {
        finalEvent.textContent = race.name;
      }

      if (selectedType) {
        selectedType.textContent = race.type;
      }

      if (selectedTrack) {
        selectedTrack.textContent = race.track;
      }

      if (selectedWeather) {
        selectedWeather.textContent = race.weather;
      }

      if (selectedEntry) {
        selectedEntry.textContent = race.entry;
      }

      if (selectedPrize) {
        selectedPrize.textContent = race.prize;
      }

      if (selectedCode) {
        selectedCode.textContent = raceId;
      }

      if (startEntry) {
        startEntry.textContent = race.entry;
      }

      if (startPrize) {
        startPrize.textContent = race.prize;
      }

      eventButtons.forEach((button) => {
        const active =
          button.dataset.selectRace === raceId;

        button.classList.toggle(
          "race-select-button--active",
          active
        );
      });

      raceCards.forEach((card) => {
        const selected =
          card.querySelector(
            `[data-select-race="${raceId}"]`
          ) !== null;

        card.classList.toggle(
          "race-event--selected",
          selected
        );
      });
    };

    eventButtons.forEach((button) => {
      button.addEventListener("click", () => {
        const raceId =
          button.dataset.selectRace;

        if (!raceId) return;

        updateRace(raceId);

        document
          .querySelector(".setup-panel--event")
          ?.scrollIntoView({
            behavior: "smooth",
            block: "center",
          });
      });
    });

    riskButtons.forEach((button) => {
      button.addEventListener("click", () => {

        riskButtons.forEach((item) => {
          const active = item === button;

          item.classList.toggle(
            "risk-card--active",
            active
          );

          item.setAttribute(
            "aria-pressed",
            active ? "true" : "false"
          );
        });

        const riskLabel =
          button.querySelector(
            ".risk-card-body strong"
          )?.textContent || "NORMAL";

        if (selectedRisk) {
          selectedRisk.textContent =
            riskLabel;
        }
      });
    });

    updateRace("RACE-001");
    applyFilter("all");
  </script>


