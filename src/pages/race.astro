---
import Layout from "../components/Layout.astro";
import "../styles/global.css";
import Button from "../components/Button.astro";
import Navigation from "../components/Navigation.astro";

const raceStats = [
  {
    label: "RACE",
    value: "07",
    detail: "TOTAL START",
    icon: "flag",
    active: true,
  },
  {
    label: "WIN",
    value: "02",
    detail: "CAREER WIN",
    icon: "trophy",
  },
  {
    label: "BEST TIME",
    value: "08.31",
    detail: "UNDER 125",
    icon: "timer",
  },
  {
    label: "SEASON",
    value: "03/08",
    detail: "CURRENT ROUND",
    icon: "chart",
  },
];

const raceFilters = [
  { id: "all", label: "SEMUA", count: 3, active: true },
  { id: "under125", label: "UNDER 125", count: 1, active: false },
  { id: "under150", label: "UNDER 150", count: 1, active: false },
  { id: "open", label: "OPEN", count: 1, active: false },
];

const officialRaces = [
  {
    id: "RACE-001",
    category: "under125",
    class: "UNDER 125",
    type: "OFFICIAL",
    name: "ABIANSEMAL NIGHT RUN",
    track: "200 M / ASPAL",
    weather: "KERING",
    timeWindow: "22:00 — 23:30",
    entryFee: "Rp 75.000",
    prize: "Rp 350.000",
    bestTime: "08.31",
    opponents: 8,
    status: "OPEN",
    note: "Start bersih. Fokus launch dan consistency.",
    accent: "lime",
    distance: "200M",
  },
  {
    id: "RACE-002",
    category: "under150",
    class: "UNDER 150",
    type: "OFFICIAL",
    name: "MENGWI STREET CUP",
    track: "250 M / ASPAL",
    weather: "BERANGIN",
    timeWindow: "21:30 — 23:00",
    entryFee: "Rp 100.000",
    prize: "Rp 500.000",
    bestTime: "08.67",
    opponents: 10,
    status: "OPEN",
    note: "Saingan lebih rapat. Power dan kontrol harus seimbang.",
    accent: "white",
    distance: "250M",
  },
  {
    id: "RACE-003",
    category: "open",
    class: "OPEN STREET",
    type: "LIAR",
    name: "KUTA TEST NIGHT",
    track: "200 M / ASPAL",
    weather: "LEMBAB",
    timeWindow: "23:00 — 01:00",
    entryFee: "Rp 125.000",
    prize: "Rp 650.000",
    bestTime: "08.18",
    opponents: 12,
    status: "OPEN",
    note: "Event berisiko tinggi. Reward besar, margin salah tipis.",
    accent: "danger",
    distance: "200M",
  },
];

const selectedRace = officialRaces[0];

const championship = [
  { position: 1, team: "GARASI SELATAN", wins: 3, points: 126 },
  { position: 2, team: "BENGKEL UTARA", wins: 2, points: 118 },
  { position: 3, team: "NUSA GARAGE", wins: 2, points: 112 },
  { position: 4, team: "RAW POWER", wins: 1, points: 96 },
  { position: 5, team: "KILAT MOTOR", wins: 1, points: 91 },
];

const raceTips = [
  {
    number: "01",
    title: "LAUNCH DULU",
    description:
      "Start yang konsisten memberi ruang sebelum motor masuk top speed. Jangan mengejar angka power dengan timing start yang buruk.",
    icon: "bolt",
  },
  {
    number: "02",
    title: "JANGAN OVER-PUSH",
    description:
      "Risk lebih tinggi memang membuka performa tambahan, tetapi wear motor dan tekanan ke joki ikut naik.",
    icon: "gauge",
  },
  {
    number: "03",
    title: "BUILD HARUS COCOK",
    description:
      "Motor ringan belum tentu ideal untuk semua event. Cocokkan build, grip, reliability, dan karakter joki dengan lintasan.",
    icon: "wrench",
  },
];

const raceHistory = [
  {
    result: "1ST",
    event: "ABIANSEMAL NIGHT RUN",
    class: "UNDER 125",
    time: "08.31",
    prize: "+Rp 350.000",
    icon: "trophy",
  },
  {
    result: "2ND",
    event: "MENGWI STREET CUP",
    class: "UNDER 150",
    time: "08.67",
    prize: "+Rp 225.000",
    icon: "podium",
  },
  {
    result: "4TH",
    event: "KUTA TEST NIGHT",
    class: "UNDER 125",
    time: "08.91",
    prize: "+Rp 0",
    icon: "flag",
  },
  {
    result: "1ST",
    event: "BADUNG OPEN RUN",
    class: "UNDER 125",
    time: "08.42",
    prize: "+Rp 325.000",
    icon: "trophy",
  },
];

const setupMotor = {
  name: "NUSA 125",
  build: 41,
  power: 42,
  acceleration: 47,
  grip: 44,
  reliability: 71,
};

const setupDriver = {
  name: 'BIMO "KILAT"',
  level: 3,
  reaction: 78,
  shift: 71,
  consistency: 82,
  trait: "CONSISTENT",
};

const riskOptions = [
  {
    id: "safe",
    number: "01",
    title: "SAFE",
    subtitle: "CONSISTENCY",
    description:
      "Timing lebih mudah. Performa turun sedikit, tetapi wear motor dan tekanan balap lebih kecil.",
    fill: 1,
  },
  {
    id: "normal",
    number: "02",
    title: "NORMAL",
    subtitle: "BALANCED",
    description:
      "Performa dasar tanpa modifier tambahan. Pilihan standar untuk race routine.",
    fill: 2,
  },
  {
    id: "push",
    number: "03",
    title: "PUSH",
    subtitle: "MAX OUTPUT",
    description:
      "Window timing lebih sempit, performa lebih tinggi, tetapi wear dan tekanan joki ikut meningkat.",
    fill: 4,
  },
];
---

<Layout
  title="BENGKEL — RACE"
  description="Pilih event. Siapkan motor. Bawa build ke lintasan."
>
  <div class="page race-page">
    <div class="game-layout">

      <Navigation active="race" />

      <main class="main">

        <div class="main-inner race-main">

          <!-- =====================================================
               HEADER
          ===================================================== -->

          <header class="race-header">

            <div class="race-header-top">

              <div class="race-head-left">
                <span class="header-led"></span>
                <span>RACE_01</span>
              </div>

              <span class="race-head-center">
                GARAGE / RACE / CONTROL_01
              </span>

              <div class="race-head-right">
                <span class="pixel-icon pixel-icon--bolt pixel-icon--tiny"></span>
                ONLINE
              </div>

            </div>


            <div class="race-header-body">

              <div class="race-header-copy">

                <div class="race-kicker-row">

                  <span class="race-title-icon">
                    <span class="pixel-icon pixel-icon--flag pixel-icon--small"></span>
                  </span>

                  <span class="header-kicker">
                    RACING CONTROL
                  </span>

                </div>

                <h1>
                  RACE
                </h1>

                <div class="header-rule"></div>

                <p>
                  Pilih event, siapkan motor dan joki,
                  lalu bawa build kamu ke lintasan.
                  Timing, setup, dan kontrol menentukan hasil.
                </p>

              </div>


              <div class="race-header-panel">

                <div class="season-box">

                  <div class="season-icon">
                    <span class="pixel-icon pixel-icon--flag pixel-icon--medium"></span>
                  </div>

                  <div class="season-copy">

                    <span>
                      CURRENT SEASON
                    </span>

                    <strong>
                      03
                    </strong>

                    <small>
                      ROUND 03 / 08
                    </small>

                  </div>

                </div>


                <div class="header-capacity">

                  <div>
                    <span>RACE</span>
                    <strong>07 START</strong>
                  </div>

                  <div>
                    <span>WIN</span>
                    <strong>02</strong>
                  </div>

                  <div>
                    <span>BEST</span>
                    <strong>08.31</strong>
                  </div>

                </div>


                <div class="header-actions">

                  <Button
                    href="/team"
                    variant="primary"
                  >
                    PILIH JOKI
                  </Button>

                  <Button href="/motor">
                    PILIH MOTOR
                  </Button>

                </div>

              </div>

            </div>


            <div class="race-header-bottom">

              <span>SETUP / RACE / RESULT</span>

              <span>SEASON 03 / ROUND 03</span>

              <span class="header-system">
                <i></i>
                RACE SYSTEM READY
              </span>

            </div>

          </header>



          <!-- =====================================================
               RACING RECORD
          ===================================================== -->

          <section class="race-section">

            <div class="section-header">

              <div class="section-heading">

                <span class="section-marker"></span>

                <div>
                  <span class="section-kicker">
                    RACING RECORD
                  </span>

                  <h2>
                    CATATAN BALAP
                  </h2>
                </div>

              </div>

              <span class="section-code">
                SEASON / 03
              </span>

            </div>


            <div class="race-status-grid">

              {
                raceStats.map((stat, index) => (
                  <article
                    class:list={[
                      "race-status-card",
                      stat.active && "race-status-card--active",
                    ]}
                  >

                    <div class="race-status-head">

                      <div class="race-status-ident">

                        <span class="race-status-icon">

                          <span
                            class:list={[
                              "pixel-icon",
                              `pixel-icon--${stat.icon}`,
                              "pixel-icon--small",
                            ]}
                          ></span>

                        </span>

                        <span>
                          {stat.label}
                        </span>

                      </div>

                      <span>
                        {String(index + 1).padStart(2, "0")}
                      </span>

                    </div>


                    <strong class="race-status-value">
                      {stat.value}
                    </strong>


                    <div class="race-status-foot">

                      <div class="segment-bar">

                        {Array.from({ length: 8 }).map(
                          (_, segmentIndex) => (
                            <i
                              class:segment-active={
                                stat.active
                                  ? segmentIndex < 6
                                  : segmentIndex < 4 + index
                              }
                            ></i>
                          )
                        )}

                      </div>

                      <span>
                        {stat.detail}
                      </span>

                    </div>

                  </article>
                ))
              }

            </div>

          </section>



          <!-- =====================================================
               EVENT CONTROL
          ===================================================== -->

          <section class="race-section">

            <div class="section-header">

              <div class="section-heading">

                <span class="section-marker section-marker--accent"></span>

                <div>
                  <span class="section-kicker">
                    EVENT CONTROL
                  </span>

                  <h2>
                    PILIH EVENT
                  </h2>
                </div>

              </div>

              <span class="section-code">
                03 OPEN
              </span>

            </div>


            <div class="race-filter-panel">

              <div class="race-filter-main">

                <div class="race-filter-copy">

                  <span class="race-filter-icon">
                    <span class="pixel-icon pixel-icon--filter pixel-icon--small"></span>
                  </span>

                  <div>

                    <span>
                      EVENT FILTER
                    </span>

                    <strong>
                      Sesuaikan kelas sebelum masuk
                      ke race setup.
                    </strong>

                  </div>

                </div>


                <div
                  class="race-filter-list"
                  role="group"
                  aria-label="Race filters"
                >

                  {
                    raceFilters.map((filter) => (
                      <button
                        type="button"
                        class:list={[
                          "race-filter-button",
                          filter.active &&
                            "race-filter-button--active",
                        ]}
                        data-filter={filter.id}
                        aria-pressed={
                          filter.active
                            ? "true"
                            : "false"
                        }
                      >

                        <span>
                          {filter.label}
                        </span>

                        <small>
                          {String(filter.count).padStart(2, "0")}
                        </small>

                      </button>
                    ))
                  }

                </div>

              </div>


              <div class="race-filter-status">

                <span class="race-filter-count">
                  03
                </span>

                <span>
                  EVENT TERSEDIA
                </span>

              </div>

            </div>

          </section>



          <!-- =====================================================
               EVENT LIST
          ===================================================== -->

          <section class="race-section">

            <div class="section-header">

              <div class="section-heading">

                <span class="section-marker"></span>

                <div>
                  <span class="section-kicker">
                    AVAILABLE EVENTS
                  </span>

                  <h2>
                    EVENT BALAP
                  </h2>
                </div>

              </div>

              <span class="section-link">
                03 OPEN
              </span>

            </div>


            <div class="race-event-list">

              {
                officialRaces.map((race, index) => (
                  <article
                    class:list={[
                      "race-event",
                      index === 0 &&
                        "race-event--featured",
                    ]}
                    data-race-card
                    data-category={race.category}
                  >

                    <div class="race-event-visual">

                      <div class="race-event-number">
                        <span>EVENT</span>
                        <strong>
                          {String(index + 1).padStart(2, "0")}
                        </strong>
                      </div>


                      <div class="race-track">

                        <div class="race-track-surface"></div>

                        <span class="track-line track-line--1"></span>
                        <span class="track-line track-line--2"></span>
                        <span class="track-line track-line--3"></span>

                        <span class="track-finish"></span>

                        <span class="track-ruler">
                          200 M
                        </span>

                      </div>


                      <span
                        class:list={[
                          "race-event-type",
                          race.accent === "danger" &&
                            "race-event-type--danger",
                          race.accent === "lime" &&
                            "race-event-type--accent",
                        ]}
                      >
                        {race.type}
                      </span>

                    </div>


                    <div class="race-event-content">

                      <div class="race-event-top">

                        <div>

                          <div class="race-event-meta">

                            <span>
                              {race.class}
                            </span>

                            <i></i>

                            <span>
                              {race.distance}
                            </span>

                            <i></i>

                            <span>
                              {race.weather}
                            </span>

                          </div>

                          <h3>
                            {race.name}
                          </h3>

                        </div>


                        <span class="race-status-badge">

                          <i></i>

                          {race.status}

                        </span>

                      </div>


                      <p class="race-event-note">
                        {race.note}
                      </p>


                      <div class="race-spec-grid">

                        <div>
                          <span>TRACK</span>
                          <strong>{race.track}</strong>
                        </div>

                        <div>
                          <span>TIME WINDOW</span>
                          <strong>{race.timeWindow}</strong>
                        </div>

                        <div>
                          <span>OPPONENTS</span>
                          <strong>{race.opponents} RIDERS</strong>
                        </div>

                        <div>
                          <span>BEST</span>
                          <strong class="race-accent">
                            {race.bestTime}
                          </strong>
                        </div>

                      </div>


                      <div class="race-event-footer">

                        <div class="race-money">

                          <div>
                            <span>ENTRY</span>
                            <strong>{race.entryFee}</strong>
                          </div>

                          <div>
                            <span>PRIZE</span>
                            <strong class="race-accent">
                              {race.prize}
                            </strong>
                          </div>

                        </div>


                        <button
                          type="button"
                          class="race-select-button"
                          data-select-race={race.id}
                        >
                          <span>
                            SELECT
                          </span>

                          <strong>
                            →
                          </strong>

                        </button>

                      </div>

                    </div>

                  </article>
                ))
              }

            </div>


            <div
              class="race-empty"
              data-empty-state
              hidden
            >

              <span class="pixel-icon pixel-icon--search pixel-icon--medium"></span>

              <strong>
                EVENT TIDAK TERSEDIA
              </strong>

              <span>
                Belum ada event open untuk filter tersebut.
              </span>

            </div>

          </section>



          <!-- =====================================================
               RACE SETUP
          ===================================================== -->

          <section class="race-section">

            <div class="section-header">

              <div class="section-heading">

                <span class="section-marker section-marker--accent"></span>

                <div>
                  <span class="section-kicker">
                    RACE PREPARATION
                  </span>

                  <h2>
                    RACE SETUP
                  </h2>
                </div>

              </div>

              <span class="section-link">
                SYSTEM READY
              </span>

            </div>


            <div class="race-setup-grid">


              <!-- =================================================
                   EVENT
              ================================================== -->

              <article class="setup-panel setup-panel--event">

                <div class="setup-panel-top">

                  <div class="setup-panel-ident">

                    <span class="setup-icon">
                      <span class="pixel-icon pixel-icon--flag pixel-icon--small"></span>
                    </span>

                    <div>
                      <span>
                        SETUP / 01
                      </span>

                      <strong>
                        SELECTED EVENT
                      </strong>
                    </div>

                  </div>

                  <span class="setup-state">
                    LOCKED
                  </span>

                </div>


                <div class="setup-event-title">

                  <span>
                    {selectedRace.id}
                  </span>

                  <h3 data-selected-event>
                    {selectedRace.name}
                  </h3>

                </div>


                <div class="setup-event-class">
                  {selectedRace.class}
                </div>


                <div class="setup-data-grid">

                  <div>
                    <span>TYPE</span>
                    <strong data-selected-type>
                      {selectedRace.type}
                    </strong>
                  </div>

                  <div>
                    <span>TRACK</span>
                    <strong data-selected-track>
                      {selectedRace.track}
                    </strong>
                  </div>

                  <div>
                    <span>WEATHER</span>
                    <strong data-selected-weather>
                      {selectedRace.weather}
                    </strong>
                  </div>

                  <div>
                    <span>ENTRY</span>
                    <strong data-selected-entry>
                      {selectedRace.entryFee}
                    </strong>
                  </div>

                  <div>
                    <span>PRIZE</span>
                    <strong
                      class="race-accent"
                      data-selected-prize
                    >
                      {selectedRace.prize}
                    </strong>
                  </div>

                </div>


                <div class="setup-panel-footer">

                  <div class="setup-ready">

                    <i></i>

                    EVENT TERPILIH

                  </div>

                  <span
                    class="setup-code"
                    data-selected-code
                  >
                    {selectedRace.id}
                  </span>

                </div>

              </article>



              <!-- =================================================
                   MOTOR
              ================================================== -->

              <article class="setup-panel">

                <div class="setup-panel-top">

                  <div class="setup-panel-ident">

                    <span class="setup-icon">
                      <span class="pixel-icon pixel-icon--motorcycle pixel-icon--small"></span>
                    </span>

                    <div>
                      <span>
                        SETUP / 02
                      </span>

                      <strong>
                        MOTOR
                      </strong>
                    </div>

                  </div>

                  <span class="setup-state setup-state--accent">
                    READY
                  </span>

                </div>


                <div class="setup-heading-block">

                  <div>

                    <span>
                      GARAGE SLOT
                    </span>

                    <h3>
                      {setupMotor.name}
                    </h3>

                  </div>

                  <span class="setup-level">
                    BUILD
                  </span>

                </div>


                <div class="motor-setup-display">

                  <div class="motor-stage">

                    <span class="stage-cross"></span>
                    <span class="stage-line"></span>

                    <div
                      class="setup-bike"
                      aria-hidden="true"
                    >
                      <span class="setup-bike__wheel setup-bike__wheel--rear"></span>
                      <span class="setup-bike__wheel setup-bike__wheel--front"></span>
                      <span class="setup-bike__frame"></span>
                      <span class="setup-bike__body"></span>
                      <span class="setup-bike__tank"></span>
                      <span class="setup-bike__seat"></span>
                      <span class="setup-bike__engine"></span>
                      <span class="setup-bike__pipe"></span>
                      <span class="setup-bike__fork"></span>
                      <span class="setup-bike__handle"></span>
                    </div>

                  </div>


                  <div class="setup-meter-list">

                    <div class="setup-meter-row">
                      <span>BUILD</span>
                      <strong>{setupMotor.build}</strong>

                      <div>
                        <i style={`width:${setupMotor.build}%`}></i>
                      </div>
                    </div>

                    <div class="setup-meter-row">
                      <span>POWER</span>
                      <strong>{setupMotor.power}</strong>

                      <div>
                        <i style={`width:${setupMotor.power}%`}></i>
                      </div>
                    </div>

                    <div class="setup-meter-row">
                      <span>ACCEL</span>
                      <strong>{setupMotor.acceleration}</strong>

                      <div>
                        <i style={`width:${setupMotor.acceleration}%`}></i>
                      </div>
                    </div>

                    <div class="setup-meter-row">
                      <span>GRIP</span>
                      <strong>{setupMotor.grip}</strong>

                      <div>
                        <i style={`width:${setupMotor.grip}%`}></i>
                      </div>
                    </div>

                    <div class="setup-meter-row">
                      <span>RELIAB.</span>
                      <strong class="race-accent">
                        {setupMotor.reliability}
                      </strong>

                      <div>
                        <i
                          class="is-accent"
                          style={`width:${setupMotor.reliability}%`}
                        ></i>
                      </div>
                    </div>

                  </div>

                </div>


                <Button
                  href="/motor"
                  size="small"
                >
                  CHANGE MOTOR
                </Button>

              </article>



              <!-- =================================================
                   JOKI
              ================================================== -->

              <article class="setup-panel">

                <div class="setup-panel-top">

                  <div class="setup-panel-ident">

                    <span class="setup-icon">
                      <span class="pixel-icon pixel-icon--helmet pixel-icon--small"></span>
                    </span>

                    <div>
                      <span>
                        SETUP / 03
                      </span>

                      <strong>
                        JOKI
                      </strong>
                    </div>

                  </div>

                  <span class="setup-state setup-state--accent">
                    READY
                  </span>

                </div>


                <div class="setup-heading-block">

                  <div>

                    <span>
                      SIGNED DRIVER
                    </span>

                    <h3>
                      {setupDriver.name}
                    </h3>

                  </div>

                  <span class="setup-level">
                    LV. {setupDriver.level}
                  </span>

                </div>


                <div class="driver-setup-display">

                  <div class="driver-stage">

                    <span class="driver-shadow"></span>
                    <span class="driver-head"></span>
                    <span class="driver-helmet"></span>
                    <span class="driver-visor"></span>
                    <span class="driver-neck"></span>
                    <span class="driver-body"></span>
                    <span class="driver-arm driver-arm--left"></span>
                    <span class="driver-arm driver-arm--right"></span>

                    <span class="driver-stage-code">
                      RIDER / 03
                    </span>

                  </div>


                  <div class="driver-stat-grid">

                    <div>
                      <span>REACTION</span>
                      <strong>
                        {setupDriver.reaction}
                      </strong>
                    </div>

                    <div>
                      <span>SHIFT</span>
                      <strong>
                        {setupDriver.shift}
                      </strong>
                    </div>

                    <div>
                      <span>CONSISTENCY</span>
                      <strong class="race-accent">
                        {setupDriver.consistency}
                      </strong>
                    </div>

                    <div>
                      <span>TRAIT</span>
                      <strong>
                        {setupDriver.trait}
                      </strong>
                    </div>

                  </div>

                </div>


                <Button
                  href="/team"
                  size="small"
                >
                  CHANGE JOKI
                </Button>

              </article>

            </div>

          </section>



          <!-- =====================================================
