---
import Layout from "../components/Layout.astro";
import "../styles/global.css";
import Button from "../components/Button.astro";
import Navigation from "../components/Navigation.astro";

const marketStats = [
  {
    label: "MOTOR",
    value: "03",
    detail: "LISTINGS",
    icon: "motorcycle",
  },
  {
    label: "PART",
    value: "06",
    detail: "AVAILABLE",
    icon: "gear",
  },
  {
    label: "PROJECT",
    value: "02",
    detail: "LOW ENTRY",
    icon: "project",
  },
  {
    label: "SALVAGE",
    value: "01",
    detail: "HIGH RISK",
    icon: "wrench",
  },
];

const marketTabs = [
  {
    id: "motor",
    label: "MOTOR",
    icon: "motorcycle",
    target: "#motor-listings",
  },
  {
    id: "part",
    label: "PART",
    icon: "gear",
    target: "#part-market",
  },
  {
    id: "project",
    label: "PROJECT",
    icon: "project",
    target: "#featured-project",
  },
  {
    id: "salvage",
    label: "SALVAGE",
    icon: "wrench",
    target: "#salvage-market",
  },
];

const motors = [
  {
    id: "MTR-001",
    name: "NUSA 125",
    brand: "NUSA",
    type: "UNDERBONE",
    year: "2018",
    condition: "GOOD",
    status: "READY",
    build: "STREET BUILD",
    color: "LIGHT",
    stats: {
      power: 72,
      acceleration: 68,
      grip: 64,
      reliability: 78,
    },
    value: 18500000,
    buildScore: 68,
  },
  {
    id: "MTR-002",
    name: "JATRA 135",
    brand: "JATRA",
    type: "UNDERBONE",
    year: "2016",
    condition: "USED",
    status: "PROJECT",
    build: "PROJECT BASE",
    color: "DARK",
    stats: {
      power: 58,
      acceleration: 52,
      grip: 46,
      reliability: 55,
    },
    value: 9200000,
    buildScore: 51,
  },
  {
    id: "MTR-003",
    name: "RANA 150",
    brand: "RANA",
    type: "SPORT",
    year: "2020",
    condition: "GOOD",
    status: "READY",
    build: "STREET SPEC",
    color: "LIGHT",
    stats: {
      power: 81,
      acceleration: 74,
      grip: 69,
      reliability: 72,
    },
    value: 22700000,
    buildScore: 76,
  },
];

const parts = [
  {
    id: "PRT-001",
    name: "CARBURETOR PWK",
    category: "FUEL",
    icon: "carburetor",
    condition: "GOOD",
    price: 850000,
    rarity: "COMMON",
    compatibility: "125–150 CC",
    stock: 4,
  },
  {
    id: "PRT-002",
    name: "RACING CDI",
    category: "IGNITION",
    icon: "cdi",
    condition: "NEW",
    price: 650000,
    rarity: "COMMON",
    compatibility: "NUSA / JATRA",
    stock: 8,
  },
  {
    id: "PRT-003",
    name: "LIGHTWEIGHT RIM",
    category: "WHEEL",
    icon: "wheel",
    condition: "GOOD",
    price: 1250000,
    rarity: "RARE",
    compatibility: "UNDERBONE",
    stock: 2,
  },
  {
    id: "PRT-004",
    name: "RACING CAM",
    category: "ENGINE",
    icon: "cam",
    condition: "GOOD",
    price: 1400000,
    rarity: "RARE",
    compatibility: "135–150 CC",
    stock: 3,
  },
  {
    id: "PRT-005",
    name: "HIGH FLOW AIR FILTER",
    category: "INTAKE",
    icon: "filter",
    condition: "NEW",
    price: 275000,
    rarity: "COMMON",
    compatibility: "125 CC",
    stock: 12,
  },
  {
    id: "PRT-006",
    name: "REAR SHOCK",
    category: "SUSPENSION",
    icon: "shock",
    condition: "GOOD",
    price: 1100000,
    rarity: "COMMON",
    compatibility: "UNDERBONE",
    stock: 5,
  },
];

const featuredProject = {
  id: "PRJ-001",
  name: "JATRA 135",
  type: "UNDERBONE / PROJECT",
  condition: "WORN",
  year: "2016",
  description:
    "Unit murah dengan basis mesin yang masih layak. Condition menengah membuat harga masuk rendah, sementara ruang build masih cukup besar.",
  power: 49,
  acceleration: 43,
  grip: 37,
  reliability: 39,
  buildScore: 44,
  price: 5900000,
};

const salvage = {
  id: "SLV-001",
  name: "JATRA 110 FRAME",
  type: "SALVAGE / DRAG PROJECT",
  condition: "BROKEN",
  description:
    "Unit rusak dengan biaya perbaikan tinggi. Potensinya terletak pada rangka dan basis project yang bisa dikembangkan dari nol.",
  power: 31,
  acceleration: 28,
  grip: 24,
  reliability: 16,
  buildScore: 38,
  price: 2700000,
};

const marketNotes = [
  {
    eyebrow: "01 / BUY",
    title: "CARI BASIS BAGUS",
    icon: "search",
    description:
      "Cari unit yang punya mesin, rangka, dan harga masuk yang masih memberi ruang untuk repair dan build.",
  },
  {
    eyebrow: "02 / BUILD",
    title: "HITUNG TOTAL COST",
    icon: "calculator",
    description:
      "Harga beli bukan satu-satunya biaya. Repair dan parts bisa mengubah sebuah bargain menjadi proyek mahal.",
  },
  {
    eyebrow: "03 / SELL",
    title: "PAHAMI NILAI JUAL",
    icon: "money",
    description:
      "Motor yang bagus untuk kamu belum tentu paling mudah dijual kembali. Perhatikan build dan kondisi market.",
  },
];

const recentTransactions = [
  {
    date: "01",
    action: "BOUGHT",
    item: "NUSA 125",
    type: "MOTOR",
    icon: "motorcycle",
    value: "- Rp 18.500.000",
  },
  {
    date: "02",
    action: "BOUGHT",
    item: "RACING CDI",
    type: "PART",
    icon: "gear",
    value: "- Rp 650.000",
  },
  {
    date: "03",
    action: "SOLD",
    item: "NUSA 110",
    type: "MOTOR",
    icon: "motorcycle",
    value: "+ Rp 9.750.000",
  },
  {
    date: "04",
    action: "BOUGHT",
    item: "HIGH FLOW AIR FILTER",
    type: "PART",
    icon: "filter",
    value: "- Rp 275.000",
  },
];
---

<Layout
  title="BENGKEL — MARKET"
  description="Cari motor, part, dan project."
>
  <div class="page market-page">
    <div class="game-layout">

      <Navigation active="market" />

      <main class="main">
        <div class="main-inner market-main">

          <!-- =====================================================
               HEADER
          ===================================================== -->

          <header class="market-header">

            <div class="market-header-bar">

              <div class="header-left">
                <span class="header-led"></span>
                <span>MARKET_01</span>
              </div>

              <span class="header-center">
                GARAGE / MARKET BOARD
              </span>

              <span class="header-right">
                OPEN
              </span>

            </div>

            <div class="market-header-content">

              <div class="market-title-area">

                <div class="market-title-meta">
                  <span class="market-title-icon" aria-hidden="true">
                    <span class="pixel-icon pixel-icon--motorcycle pixel-icon--small"></span>
                  </span>

                  <span class="market-kicker">
                    BUY / BUILD / SELL
                  </span>
                </div>

                <h1>
                  MARKET
                </h1>

                <div class="market-title-line"></div>

                <p>
                  Tempat berburu motor, part, dan project.
                  Cari harga masuk, hitung kebutuhan build,
                  lalu tentukan unit mana yang layak dibawa pulang.
                </p>

              </div>

              <div class="market-console">

                <div class="console-heading">
                  <span class="console-heading-icon" aria-hidden="true">
                    <span class="pixel-icon pixel-icon--gear pixel-icon--tiny"></span>
                  </span>
                  MARKET CONSOLE
                </div>

                <div class="console-row">
                  <span>MARKET</span>
                  <strong class="accent-text">
                    OPEN
                  </strong>
                </div>

                <div class="console-row">
                  <span>MOTOR</span>
                  <strong>03</strong>
                </div>

                <div class="console-row">
                  <span>PART</span>
                  <strong>06</strong>
                </div>

                <div class="console-row">
                  <span>PROJECT</span>
                  <strong>02</strong>
                </div>

                <div class="console-actions">

                  <Button
                    href="#motor-listings"
                    variant="primary"
                  >
                    KOLEKSI MOTOR
                  </Button>

                  <Button href="/garage">
                    GARASI
                  </Button>

                </div>

              </div>

            </div>

            <div class="market-header-footer">
              <span>MOTOR / PART / PROJECT / SALVAGE</span>
              <span>MARKET SYSTEM</span>
              <span class="header-status-dot">
                <i></i>
                SYSTEM READY
              </span>
            </div>

          </header>



          <!-- =====================================================
               MARKET STATUS
          ===================================================== -->

          <section class="market-section">

            <div class="section-header">

              <div class="section-heading">

                <span class="section-marker"></span>

                <div>
                  <span class="section-kicker">
                    MARKET SYSTEM
                  </span>

                  <h2>
                    MARKET STATUS
                  </h2>
                </div>

              </div>

              <span class="section-code">
                01 / 08
              </span>

            </div>

            <div class="status-grid">

              {
                marketStats.map((stat, index) => (
                  <article
                    class:list={[
                      "status-card",
                      index === 0 && "status-card--active",
                    ]}
                  >

                    <div class="status-card-top">

                      <div class="status-ident">
                        <span class="status-icon-shell" aria-hidden="true">
                          <span
                            class:list={[
                              "pixel-icon",
                              `pixel-icon--${stat.icon}`,
                              "pixel-icon--tiny",
                            ]}
                          ></span>
                        </span>

                        <span>
                          {stat.label}
                        </span>
                      </div>

                      <span>
                        {String(index + 1).padStart(2, "0")}
                      </span>

                    </div>

                    <strong class="status-card-number">
                      {stat.value}
                    </strong>

                    <div class="status-card-bottom">

                      <div class="status-segments" aria-hidden="true">
                        <i></i>
                        <i></i>
                        <i></i>
                        <i></i>
                        <i></i>
                        <i></i>
                        <i></i>
                        <i></i>
                      </div>

                      <span>
                        {stat.detail}
                      </span>

                    </div>

                  </article>
                ))
              }

            </div>

          </section>



          <!-- =====================================================
               CATEGORY
          ===================================================== -->

          <section
            class="market-section market-section--tabs"
            data-market-controller
          >

            <div class="section-header">

              <div class="section-heading">

                <span class="section-marker"></span>

                <div>
                  <span class="section-kicker">
                    MARKET BOARD
                  </span>

                  <h2>
                    CATEGORY
                  </h2>
                </div>

              </div>

              <span class="section-code">
                SELECT / MARKET
              </span>

            </div>

            <div
              class="market-tabs"
              role="tablist"
              aria-label="Market categories"
            >

              {
                marketTabs.map((tab, index) => (
                  <button
                    type="button"
                    role="tab"
                    aria-selected={index === 0 ? "true" : "false"}
                    aria-controls={`tab-panel-${tab.id}`}
                    class:list={[
                      "market-tab",
                      index === 0 && "market-tab--active",
                    ]}
                    data-market-tab={tab.id}
                    data-market-target={tab.target}
                  >

                    <span class="tab-icon" aria-hidden="true">
                      <span
                        class:list={[
                          "pixel-icon",
                          `pixel-icon--${tab.icon}`,
                          "pixel-icon--small",
                        ]}
                      ></span>
                    </span>

                    <span class="tab-copy">
                      <span class="tab-number">
                        {String(index + 1).padStart(2, "0")}
                      </span>

                      <span class="tab-label">
                        {tab.label}
                      </span>
                    </span>

                    <span class="tab-arrow">
                      →
                    </span>

                  </button>
                ))
              }

            </div>

            <div class="market-tab-info">

              <div
                id="tab-panel-motor"
                data-tab-panel="motor"
              >
                <span>01 / MOTOR</span>
                <strong>UNIT SIAP DIBELI</strong>
                <p>
                  Motor bekas dan stock unit yang tersedia
                  untuk langsung masuk ke garasi.
                </p>
              </div>

              <div
                id="tab-panel-part"
                data-tab-panel="part"
                hidden
              >
                <span>02 / PART</span>
                <strong>COMPONENT MARKET</strong>
                <p>
                  Komponen untuk repair, tuning, dan
                  build motor.
                </p>
              </div>

              <div
                id="tab-panel-project"
                data-tab-panel="project"
                hidden
              >
                <span>03 / PROJECT</span>
                <strong>BASIS UNTUK DIBANGUN</strong>
                <p>
                  Unit dengan harga masuk rendah dan
                  ruang upgrade lebih besar.
                </p>
              </div>

              <div
                id="tab-panel-salvage"
                data-tab-panel="salvage"
                hidden
              >
                <span>04 / SALVAGE</span>
                <strong>UNIT RUSAK</strong>
                <p>
                  Risiko tinggi, biaya repair tinggi,
                  tetapi bisa menjadi project unik.
                </p>
              </div>

            </div>

          </section>



          <!-- =====================================================
               FEATURED PROJECT
          ===================================================== -->

          <section
            class="market-section"
            id="featured-project"
          >

            <div class="section-header">

              <div class="section-heading">

                <span class="section-marker section-marker--accent"></span>

                <div>
                  <span class="section-kicker">
                    PROJECT HUNT
                  </span>

                  <h2>
                    TEMUAN PILIHAN
                  </h2>
                </div>

              </div>

              <span class="section-code">
                FIND / {featuredProject.id}
              </span>

            </div>

            <article class="featured-project">

              <div class="featured-visual">

                <div class="visual-corner visual-corner--tl"></div>
                <div class="visual-corner visual-corner--tr"></div>
                <div class="visual-corner visual-corner--bl"></div>
                <div class="visual-corner visual-corner--br"></div>

                <span class="featured-code">
                  PROJECT_001
                </span>

                <div class="featured-grid-mark" aria-hidden="true">
                  <span></span>
                  <span></span>
                  <span></span>
                  <span></span>
                </div>

                <div
                  class="pixel-motor featured-motor"
                  aria-hidden="true"
                >
                  <span class="pixel-motor__body"></span>
                  <span class="pixel-motor__tank"></span>
                  <span class="pixel-motor__seat"></span>
                  <span class="pixel-motor__frame"></span>
                  <span class="pixel-motor__engine"></span>
                  <span class="pixel-motor__wheel pixel-motor__wheel--rear"></span>
                  <span class="pixel-motor__wheel pixel-motor__wheel--front"></span>
                  <span class="pixel-motor__handle"></span>
                </div>

                <div class="featured-mini-spec">
                  <span>BASE</span>
                  <strong>135CC</strong>
                </div>

                <span class="featured-tag">
                  PROJECT
                </span>

                <span class="featured-bottom">
                  LOW ENTRY / BUILD SPACE
                </span>

              </div>

              <div class="featured-content">

                <div class="featured-heading">

                  <div>

                    <div class="item-label-row">
                      <span class="mini-label-icon">
                        <span class="pixel-icon pixel-icon--project pixel-icon--tiny"></span>
                      </span>

                      <span class="section-kicker">
                        PROJECT MOTOR
                      </span>
                    </div>

                    <h2>
                      {featuredProject.name}
                    </h2>

                    <span class="featured-type">
                      {featuredProject.type}
                    </span>

                  </div>

                  <span class="condition-tag">
                    {featuredProject.condition}
                  </span>

                </div>

                <p class="featured-description">
                  {featuredProject.description}
                </p>

                <div class="featured-stat-grid">

                  <div>
                    <span class="stat-icon-title">
                      <i class="stat-symbol stat-symbol--power"></i>
                      POWER
                    </span>
                    <strong>{featuredProject.power}</strong>
                  </div>

                  <div>
                    <span class="stat-icon-title">
                      <i class="stat-symbol stat-symbol--accel"></i>
                      ACCEL
                    </span>
                    <strong>{featuredProject.acceleration}</strong>
                  </div>

                  <div>
                    <span class="stat-icon-title">
                      <i class="stat-symbol stat-symbol--grip"></i>
                      GRIP
                    </span>
                    <strong>{featuredProject.grip}</strong>
                  </div>

                  <div>
                    <span class="stat-icon-title">
                      <i class="stat-symbol stat-symbol--reliability"></i>
                      RELIABILITY
                    </span>
                    <strong class="danger-text">
                      {featuredProject.reliability}
                    </strong>
                  </div>

                </div>

                <div class="featured-finance">

                  <div>
                    <span>ASKING PRICE</span>

                    <strong>
                      Rp {featuredProject.price.toLocaleString("id-ID")}
                    </strong>
                  </div>

                  <div class="build-score-box">
                    <span>BUILD SCORE</span>

                    <strong class="accent-text">
                      {featuredProject.buildScore}
                    </strong>
                  </div>

                </div>

                <div class="featured-actions">

                  <Button
                    href="/market"
                    variant="primary"
                  >
                    BELI PROJECT
                  </Button>

                  <Button href="/motor">
                    LIHAT DETAIL
                  </Button>

                </div>

              </div>

            </article>

          </section>



          <!-- =====================================================
               MOTOR LISTINGS
          ===================================================== -->

          <section
            class="market-section"
            id="motor-listings"
          >

            <div class="section-header">

              <div class="section-heading">

                <span class="section-marker"></span>

                <div>
                  <span class="section-kicker">
                    MOTOR LISTINGS
                  </span>

                  <h2>
                    MOTOR DIJUAL
                  </h2>
                </div>

              </div>

              <span class="section-code">
                03 UNITS
              </span>

            </div>

            <div class="motor-market-grid">

              {
                motors.map((motor, index) => (
                  <article class="motor-market-card">

                    <div class="motor-card-top">

                      <div class="motor-card-id">
                        <span class="motor-number">
                          {String(index + 1).padStart(2, "0")}
                        </span>

                        <span>
                          {motor.id}
                        </span>
                      </div>

                      <span class="motor-status">
                        {motor.status}
                      </span>

                    </div>

                    <div class="motor-card-art">

                      <div class="motor-art-label">
                        <span>UNIT / {motor.brand}</span>
                        <span>{motor.year}</span>
                      </div>

                      <div
                        class:list={[
                          "pixel-motor",
                          "listing-motor",
                          motor.color === "DARK" && "listing-motor--dark",
                        ]}
                        aria-hidden="true"
                      >
                        <span class="pixel-motor__body"></span>
                        <span class="pixel-motor__tank"></span>
                        <span class="pixel-motor__seat"></span>
                        <span class="pixel-motor__frame"></span>
                        <span class="pixel-motor__engine"></span>
                        <span class="pixel-motor__wheel pixel-motor__wheel--rear"></span>
                        <span class="pixel-motor__wheel pixel-motor__wheel--front"></span>
                        <span class="pixel-motor__handle"></span>
                      </div>

                      <div class="motor-art-floor"></div>

                      <span class="motor-art-type">
                        {motor.type}
                      </span>

                    </div>

                    <div class="motor-card-body">

                      <div class="motor-card-heading">

                        <div>

                          <span class="section-kicker">
                            {motor.brand}
                          </span>

                          <h3>
                            {motor.name}
                          </h3>

                          <span class="motor-build">
                            {motor.build}
                          </span>

                        </div>

                        <span class="motor-condition">
                          {motor.condition}
                        </span>

                      </div>

                      <div class="motor-spec-grid">

                        <div>
                          <span>POWER</span>
                          <strong>{motor.stats.power}</strong>
                        </div>

                        <div>
                          <span>ACCEL</span>
                          <strong>{motor.stats.acceleration}</strong>
                        </div>

                        <div>
                          <span>GRIP</span>
                          <strong>{motor.stats.grip}</strong>
                        </div>

                        <div>
                          <span>RELIAB.</span>
                          <strong>{motor.stats.reliability}</strong>
                        </div>

                      </div>

                      <div class="motor-card-finance">

                        <div>

                          <span>MARKET VALUE</span>

                          <strong>
                            Rp {motor.value.toLocaleString("id-ID")}
                          </strong>

                        </div>

                        <div class="motor-score">

                          <span>BUILD</span>

                          <strong class="accent-text">
                            {motor.buildScore}
                          </strong>

                        </div>

                      </div>

                    </div>

                    <a
                      href="/market"
                      class="motor-buy-button"
                    >
                      <span class="button-icon" aria-hidden="true">
                        <span class="pixel-icon pixel-icon--money pixel-icon--tiny"></span>
                      </span>

                      <span>BELI MOTOR</span>

                      <span class="button-arrow">→</span>
                    </a>

                  </article>
                ))
              }

            </div>

          </section>



          <!-- =====================================================
               PART MARKET
          ===================================================== -->

          <section
            class="market-section"
            id="part-market"
          >

            <div class="section-header">

              <div class="section-heading">

                <span class="section-marker"></span>

                <div>
                  <span class="section-kicker">
                    PARTS MARKET
                  </span>

                  <h2>
                    PART TERSEDIA
                  </h2>
                </div>

              </div>

              <span class="section-code">
                06 ITEMS
              </span>

            </div>

            <div class="parts-grid">

              {
                parts.map((part, index) => (
                  <article class="part-card">

                    <div class="part-card-top">

                      <div class="part-id">

                        <span class="part-icon-index">
                          {String(index + 1).padStart(2, "0")}
                        </span>

                        <span>
                          {part.id}
                        </span>

                      </div>

                      <span
                        class:list={[
                          "part-rarity",
                          part.rarity === "RARE" &&
                            "part-rarity--rare",
                        ]}
                      >
                        {part.rarity}
                      </span>

                    </div>

                    <div class="part-art">

                      <div class="part-art-header">
                        <span>COMPONENT</span>
                        <span>{part.category}</span>
                      </div>

                      <div
                        class:list={[
                          "part-pixel-object",
                          `part-pixel-object--${part.icon}`,
                        ]}
                        aria-hidden="true"
                      >
                        <span class="part-pixel-shadow"></span>
                        <span class="part-pixel-main"></span>
                        <span class="part-pixel-detail part-pixel-detail--1"></span>
                        <span class="part-pixel-detail part-pixel-detail--2"></span>
                        <span class="part-pixel-detail part-pixel-detail--3"></span>
                      </div>

                      <span class="part-art-code">
                        {part.id}
                      </span>

                    </div>

                    <div class="part-info">

