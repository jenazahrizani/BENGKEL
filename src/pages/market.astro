<script>
  const marketController = document.querySelector(
    "[data-market-controller]"
  );

  if (marketController) {
    const tabs = Array.from(
      marketController.querySelectorAll("[data-market-tab]")
    );

    const panels = Array.from(
      marketController.querySelectorAll("[data-tab-panel]")
    );

    const activateTab = (id) => {
      tabs.forEach((tab) => {
        const active =
          tab.getAttribute("data-market-tab") === id;

        tab.classList.toggle(
          "market-tab--active",
          active
        );

        tab.setAttribute(
          "aria-selected",
          active ? "true" : "false"
        );
      });

      panels.forEach((panel) => {
        panel.toggleAttribute(
          "hidden",
          panel.getAttribute("data-tab-panel") !== id
        );
      });
    };

    tabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        const id = tab.getAttribute("data-market-tab");
        const target = tab.getAttribute("data-market-target");

        if (id) {
          activateTab(id);
        }

        if (target) {
          const section = document.querySelector(target);

          if (section) {
            const top =
              section.getBoundingClientRect().top +
              window.scrollY -
              28;

            window.scrollTo({
              top,
              behavior: "smooth",
            });
          }
        }
      });
    });
  }
</script>


