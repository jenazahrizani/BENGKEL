.status-segments i:nth-child(-n+6) {
  background: var(--market-accent);
}


/* =========================================================
   TABS
   ========================================================= */

.market-tabs {
  display: grid;

  grid-template-columns: repeat(4,1fr);

  border-top: 2px solid var(--market-line);
  border-left: 2px solid var(--market-line);
}

.market-tab {
  min-height: 67px;

  display: grid;

  grid-template-columns: 31px minmax(0,1fr) 20px;

  align-items: center;

  gap: 9px;

  padding: 0 11px;

  border: 0;

  border-right: 2px solid var(--market-line);
  border-bottom: 2px solid var(--market-line);

  background: var(--market-panel);

  color: var(--market-muted);

  font-family: var(--font-display);
  font-size: .58rem;
  font-weight: 900;

  text-align: left;
  text-transform: uppercase;

  cursor: pointer;

  transition:
    background 80ms steps(1),
    color 80ms steps(1),
    transform 80ms steps(1);
}

.market-tab:hover {
  background: var(--market-panel-2);
  color: var(--market-white);
}

.market-tab:active {
  transform: translate(2px,2px);
}

.market-tab:focus-visible {
  outline: 2px solid var(--market-accent);
  outline-offset: 3px;
}

.market-tab--active {
  background: var(--market-accent);
  color: var(--market-black);

  box-shadow:
    4px 4px 0 var(--market-black);
}

.market-tab--active:hover {
  background: var(--market-accent);
  color: var(--market-black);
}

.tab-icon {
  width: 28px;
  height: 28px;

  display: grid;
  place-items: center;

  border: 1px solid currentColor;
}

.tab-copy {
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.tab-number {
  opacity: .55;

  font-size: .4rem;
}

.tab-label {
  font-size: .58rem;
}

.tab-arrow {
  text-align: right;
  font-size: 1rem;
}

.market-tab-info {
  min-height: 82px;

  display: flex;
  align-items: center;

  padding: 13px;

  border: 2px solid var(--market-line);
  border-top: 0;

  background: var(--market-black-2);
}

.market-tab-info [data-tab-panel] {
  width: 100%;

  display: grid;

  grid-template-columns:
    100px
    180px
    minmax(0,1fr);

  align-items: center;

  gap: 16px;
}

.market-tab-info span,
.market-tab-info strong {
  font-family: var(--font-display);
  font-size: .5rem;
  font-weight: 900;

  text-transform: uppercase;
}

.market-tab-info span {
  color: var(--market-dim);
}

.market-tab-info strong {
  color: var(--market-white);
}

.market-tab-info p {
  margin: 0;

  color: var(--market-muted);

  font-size: .68rem;
  line-height: 1.45;
}


/* =========================================================
   FEATURED PROJECT
   ========================================================= */

.featured-project {
  display: grid;

  grid-template-columns:
    minmax(300px,.82fr)
    minmax(0,1.18fr);

  overflow: hidden;

  background: var(--market-panel);

  border: 3px solid var(--market-black);

  box-shadow:
    7px 7px 0 var(--market-black);
}

.featured-visual {
  min-height: 390px;

  position: relative;

  display: grid;
  place-items: center;

  overflow: hidden;

  border-right: 2px solid var(--market-line);

  background:
    linear-gradient(
      90deg,
      #171717 0,
      #171717 49.5%,
      #202020 49.5%,
      #202020 50.5%,
      #171717 50.5%
    );
}

.featured-visual::before {
  content: "";

  position: absolute;
  inset: 0;

  background:
    linear-gradient(
      transparent 49%,
      rgba(255,255,255,.04) 50%,
      transparent 51%
    ),
    linear-gradient(
      90deg,
      transparent 49%,
      rgba(255,255,255,.04) 50%,
      transparent 51%
    );

  background-size: 18px 18px;

  opacity: .4;
}

.featured-code {
  position: absolute;

  top: 12px;
  left: 12px;

  color: rgba(241,241,235,.36);

  font-family: var(--font-display);
  font-size: .45rem;
  font-weight: 900;
}

.featured-grid-mark {
  position: absolute;

  width: 180px;
  height: 180px;

  border: 1px dashed rgba(241,241,235,.14);
}

.featured-grid-mark span {
  position: absolute;

  width: 6px;
  height: 6px;

  background: rgba(241,241,235,.15);
}

.featured-grid-mark span:nth-child(1) {
  left: -3px;
  top: -3px;
}

.featured-grid-mark span:nth-child(2) {
  right: -3px;
  top: -3px;
}

.featured-grid-mark span:nth-child(3) {
  left: -3px;
  bottom: -3px;
}

.featured-grid-mark span:nth-child(4) {
  right: -3px;
  bottom: -3px;
}

.featured-motor {
  position: relative;
  z-index: 2;

  transform: scale(1.55);

  image-rendering: pixelated;

  filter:
    drop-shadow(6px 6px 0 var(--market-black));
}

.featured-mini-spec {
  position: absolute;

  left: 15px;
  bottom: 43px;

  display: flex;
  flex-direction: column;
  gap: 2px;

  z-index: 3;

  font-family: var(--font-display);
  text-transform: uppercase;
}

.featured-mini-spec span {
  color: var(--market-dim);
  font-size: .4rem;
  font-weight: 900;
}

.featured-mini-spec strong {
  color: var(--market-white);
  font-size: .64rem;
  font-weight: 900;
}

.featured-tag {
  position: absolute;

  top: 42px;
  right: 24px;

  padding: 5px 7px;

  border: 2px solid var(--market-black);

  background: var(--market-accent);

  color: var(--market-black);

  font-family: var(--font-display);
  font-size: .46rem;
  font-weight: 900;

  transform: rotate(3deg);

  z-index: 4;
}

.featured-bottom {
  position: absolute;

  bottom: 14px;
  left: 0;
  right: 0;

  color: rgba(241,241,235,.4);

  font-family: var(--font-display);
  font-size: .45rem;
  font-weight: 900;

  letter-spacing: .08em;

  text-align: center;
}

.visual-corner {
  width: 17px;
  height: 17px;

  position: absolute;

  z-index: 5;
}

.visual-corner--tl {
  top: 9px;
  left: 9px;

  border-top: 2px solid var(--market-accent);
  border-left: 2px solid var(--market-accent);
}

.visual-corner--tr {
  top: 9px;
  right: 9px;

  border-top: 2px solid var(--market-accent);
  border-right: 2px solid var(--market-accent);
}

.visual-corner--bl {
  bottom: 9px;
  left: 9px;

  border-bottom: 2px solid var(--market-accent);
  border-left: 2px solid var(--market-accent);
}

.visual-corner--br {
  right: 9px;
  bottom: 9px;

  border-bottom: 2px solid var(--market-accent);
  border-right: 2px solid var(--market-accent);
}

.featured-content {
  min-width: 0;
  padding: 24px;
}

.featured-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;

  gap: 14px;

  padding-bottom: 15px;

  border-bottom: 1px solid var(--market-line);
}

.item-label-row {
  display: flex;
  align-items: center;
  gap: 7px;
}

.mini-label-icon {
  width: 21px;
  height: 21px;

  display: grid;
  place-items: center;

  color: var(--market-accent);

  border: 1px solid var(--market-accent-dark);

  background: var(--market-black-2);
}

.featured-heading h2 {
  margin-top: 6px;

  color: var(--market-white);

  font-family: var(--font-display);
  font-size: clamp(1.8rem,4vw,3rem);
  font-weight: 900;

  line-height: .9;

  letter-spacing: -.05em;

  text-transform: uppercase;
}

.featured-type {
  display: block;

  margin-top: 6px;

  color: var(--market-muted);

  font-family: var(--font-display);
  font-size: .48rem;
  font-weight: 900;

  text-transform: uppercase;
}

.condition-tag {
  padding: 5px 7px;

  border: 1px solid var(--market-line-light);

  color: var(--market-muted);

  font-family: var(--font-display);
  font-size: .45rem;
  font-weight: 900;
}

.featured-description {
  margin-top: 15px;

  color: var(--market-muted);

  font-size: var(--text-sm);

  line-height: 1.6;
}

.featured-stat-grid {
  display: grid;

  grid-template-columns: repeat(4,1fr);

  gap: 7px;

  margin-top: 18px;
}

.featured-stat-grid > div {
  min-width: 0;

  padding: 10px;

  border: 1px solid var(--market-line);

  background: var(--market-black-2);
}

.stat-icon-title {
  display: flex;
  align-items: center;
  gap: 5px;

  color: var(--market-dim);

  font-family: var(--font-display);
  font-size: .42rem;
  font-weight: 900;

  text-transform: uppercase;
}

.stat-symbol {
  width: 4px;
  height: 4px;

  display: inline-block;

  background: var(--market-soft);

  box-shadow:
    3px 0 0 var(--market-soft),
    0 3px 0 var(--market-soft);
}

.stat-symbol--accel {
  transform: skewX(-25deg);
}

.stat-symbol--grip {
  box-shadow:
    3px 0 0 var(--market-soft),
    6px 0 0 var(--market-soft);
}

.stat-symbol--reliability {
  border: 1px solid var(--market-soft);
  background: transparent;
  box-shadow: none;
}

.featured-stat-grid strong {
  display: block;

  margin-top: 6px;

  color: var(--market-white);

  font-family: var(--font-display);
  font-size: 1rem;
  font-weight: 900;
}

.featured-finance {
  display: flex;

  align-items: flex-end;
  justify-content: space-between;

  gap: 15px;

  margin-top: 18px;
  padding-top: 14px;

  border-top: 1px solid var(--market-line);
}

.featured-finance > div {
  display: flex;
  flex-direction: column;
  gap: 5px;
}

.featured-finance span {
  color: var(--market-dim);

  font-family: var(--font-display);
  font-size: .42rem;
  font-weight: 900;

  text-transform: uppercase;
}

.featured-finance > div > strong {
  color: var(--market-white);

  font-family: var(--font-display);
  font-size: 1.3rem;
  font-weight: 900;
}

.featured-finance > div:last-child > strong {
  color: var(--market-accent);
}

.featured-actions {
  display: flex;
  gap: 8px;
  margin-top: 18px;
}

.featured-actions .btn {
  flex: 1;
}

.build-score-box {
  text-align: right;
}


/* =========================================================
   MOTOR LISTINGS — INDIVIDUAL CARDS
   ========================================================= */

.motor-market-grid {
  display: grid;

  grid-template-columns:
    repeat(3,minmax(0,1fr));

  gap: 12px;
}

.motor-market-card {
  min-width: 0;

  display: flex;
  flex-direction: column;

  overflow: hidden;

  background: var(--market-panel);

  border: 2px solid var(--market-line);

  box-shadow:
    5px 5px 0 var(--market-black);

  transition:
    transform 80ms steps(1),
    border-color 80ms steps(1),
    background 80ms steps(1);
}

.motor-market-card:hover {
  transform: translate(-2px,-2px);

  border-color: var(--market-line-light);

  background: var(--market-panel-2);

  box-shadow:
    7px 7px 0 var(--market-black);
}

.motor-card-top {
  min-height: 31px;

  display: flex;
  align-items: center;
  justify-content: space-between;

  padding: 0 9px;

  border-bottom: 2px solid var(--market-line);

  background: var(--market-black-2);

  font-family: var(--font-display);
  font-size: .43rem;
  font-weight: 900;

  text-transform: uppercase;
}

.motor-card-id {
  display: flex;
  align-items: center;
  gap: 7px;

  color: var(--market-dim);
}

.motor-number {
  color: var(--market-accent);
}

.motor-status {
  color: var(--market-soft);
}

.motor-card-art {
  min-height: 205px;

  position: relative;

  display: grid;
  place-items: center;

  overflow: hidden;

  border-bottom: 1px solid var(--market-line);

  background:
    linear-gradient(
      135deg,
      #1a1a1a 25%,
      #171717 25%,
      #171717 50%,
      #1a1a1a 50%,
      #1a1a1a 75%,
      #171717 75%
    );

  background-size: 20px 20px;
}

.motor-card-art::before {
  content: "";

  position: absolute;
  inset: 0;

  background:
    linear-gradient(
      90deg,
      transparent 49%,
      rgba(255,255,255,.035) 50%,
      transparent 51%
    ),
    linear-gradient(
      transparent 49%,
      rgba(255,255,255,.035) 50%,
      transparent 51%
    );

  background-size: 22px 22px;
}

.motor-art-label {
  position: absolute;

  top: 10px;
  left: 10px;
  right: 10px;

  display: flex;
  justify-content: space-between;

  z-index: 3;

  color: var(--market-dim);

  font-family: var(--font-display);
  font-size: .4rem;
  font-weight: 900;
}

.listing-motor {
  position: relative;
  z-index: 2;

  transform:
    translateY(10px)
    scale(.95);

  image-rendering: pixelated;

  filter:
    drop-shadow(5px 5px 0 var(--market-black));
}

.listing-motor--dark {
  filter:
    grayscale(.2)
    brightness(.77)
    drop-shadow(5px 5px 0 var(--market-black));
}

.motor-art-floor {
  position: absolute;

  width: 75%;
  height: 6px;

  bottom: 24px;

  background: var(--market-line-light);

  box-shadow:
    0 5px 0 var(--market-black);
}

.motor-art-type {
  position: absolute;

  right: 10px;
  bottom: 9px;

  color: rgba(241,241,235,.38);

  font-family: var(--font-display);
  font-size: .39rem;
  font-weight: 900;

  z-index: 3;
}

.motor-card-body {
  padding: 14px;
}

.motor-card-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;

  gap: 12px;
}

.motor-card-heading h3 {
  margin-top: 5px;

  color: var(--market-white);

  font-family: var(--font-display);
  font-size: 1.2rem;
  font-weight: 900;

  line-height: .9;

  text-transform: uppercase;
}

.motor-build {
  display: block;

  margin-top: 6px;

  color: var(--market-dim);

  font-family: var(--font-display);
  font-size: .43rem;
  font-weight: 900;

  text-transform: uppercase;
}

.motor-condition {
  padding: 5px 6px;

  border: 1px solid var(--market-line-light);

  color: var(--market-muted);

  font-family: var(--font-display);
  font-size: .42rem;
  font-weight: 900;
}

.motor-spec-grid {
  display: grid;

  grid-template-columns: repeat(4,1fr);

  gap: 5px;

  margin-top: 15px;
}

.motor-spec-grid > div {
  padding: 8px;

  border: 1px solid var(--market-line);

  background: var(--market-black-2);
}

.motor-spec-grid span {
  display: block;

  color: var(--market-dim);

  font-family: var(--font-display);
  font-size: .37rem;
  font-weight: 900;
}

.motor-spec-grid strong {
  display: block;

  margin-top: 5px;

  color: var(--market-white);

  font-family: var(--font-display);
  font-size: .82rem;
  font-weight: 900;
}

.motor-card-finance {
  display: flex;

  align-items: flex-end;
  justify-content: space-between;

  gap: 12px;

  margin-top: 15px;
  padding-top: 12px;

  border-top: 1px solid var(--market-line);
}

.motor-card-finance > div {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.motor-card-finance span {
  color: var(--market-dim);

  font-family: var(--font-display);
  font-size: .41rem;
  font-weight: 900;
}

.motor-card-finance strong {
  color: var(--market-white);

  font-family: var(--font-display);
  font-size: .86rem;
  font-weight: 900;
}

.motor-score {
  min-width: 54px;
  text-align: right;
}

.motor-score strong {
  font-size: 1.05rem;
}

.motor-buy-button {
  min-height: 39px;

  display: grid;

  grid-template-columns: 22px 1fr 18px;

  align-items: center;

  gap: 7px;

  margin: 0 10px 10px;

  padding: 0 10px;

  border: 2px solid var(--market-line-light);

  color: var(--market-white);

  background: var(--market-panel-2);

  font-family: var(--font-display);
  font-size: .45rem;
  font-weight: 900;

  text-decoration: none;
  text-transform: uppercase;
}

.motor-buy-button:hover {
  border-color: var(--market-accent-dark);
  color: var(--market-accent);
  background: var(--market-panel-3);
}

.button-icon {
  display: grid;
  place-items: center;

  color: var(--market-accent);
}

.button-arrow {
  text-align: right;
}


/* =========================================================
   PARTS
   ========================================================= */

.parts-grid {
  display: grid;

  grid-template-columns:
    repeat(3,minmax(0,1fr));

  gap: 10px;
}

.part-card {
  min-width: 0;

  display: flex;
  flex-direction: column;

  overflow: hidden;

  background: var(--market-panel);

  border: 2px solid var(--market-line);

  box-shadow:
    4px 4px 0 var(--market-black);

  transition:
    transform 80ms steps(1),
    border-color 80ms steps(1);
}

.part-card:hover {
  transform: translate(-2px,-2px);
  border-color: var(--market-line-light);
}

.part-card-top {
  min-height: 31px;

  display: flex;
  align-items: center;
  justify-content: space-between;

  padding: 0 9px;

  border-bottom: 2px solid var(--market-line);

  background: var(--market-black-2);

  font-family: var(--font-display);
  font-size: .42rem;
  font-weight: 900;
}

.part-id {
  display: flex;
  align-items: center;
  gap: 7px;

  color: var(--market-dim);
}

.part-icon-index {
  color: var(--market-accent);
}

.part-rarity {
  color: var(--market-muted);
}

.part-rarity--rare {
  color: var(--market-accent);
}

.part-art {
  min-height: 157px;

  position: relative;

  display: grid;
  place-items: center;

  overflow: hidden;

  background:
    linear-gradient(
      135deg,
      #191919 25%,
      #161616 25%,
      #161616 50%,
      #191919 50%,
      #191919 75%,
      #161616 75%
    );

  background-size: 18px 18px;

  border-bottom: 1px solid var(--market-line);
}

.part-art-header {
  position: absolute;

  top: 9px;
  left: 10px;
  right: 10px;

  display: flex;
  justify-content: space-between;

  color: var(--market-dim);

  font-family: var(--font-display);
  font-size: .39rem;
  font-weight: 900;
}

.part-art-code {
  position: absolute;

  bottom: 8px;
  right: 9px;

  color: rgba(241,241,235,.3);

  font-family: var(--font-display);
  font-size: .37rem;
  font-weight: 900;
}

.part-pixel-object {
  width: 88px;
  height: 72px;

  position: relative;

  image-rendering: pixelated;
}

.part-pixel-main,
.part-pixel-shadow,
.part-pixel-detail {
  position: absolute;
  display: block;
}

.part-pixel-shadow {
  left: 16px;
  bottom: 7px;

  width: 56px;
  height: 7px;

  background: var(--market-black);
  opacity: .65;
}


/* CARBURETOR */

.part-pixel-object--carburetor .part-pixel-main {
  left: 28px;
  top: 14px;

  width: 30px;
  height: 38px;

  border: 4px solid var(--market-soft);
  background: #242424;
}

.part-pixel-object--carburetor .part-pixel-detail--1 {
  left: 13px;
  top: 24px;

  width: 17px;
  height: 10px;

  background: var(--market-soft);
}

.part-pixel-object--carburetor .part-pixel-detail--2 {
  right: 12px;
  top: 31px;

  width: 14px;
  height: 4px;

  background: var(--market-soft);
}

.part-pixel-object--carburetor .part-pixel-detail--3 {
  left: 35px;
  bottom: 8px;

  width: 15px;
  height: 9px;

  background: var(--market-accent);
}


/* CDI */

.part-pixel-object--cdi .part-pixel-main {
  left: 23px;
  top: 16px;

  width: 42px;
  height: 29px;

  border: 4px solid var(--market-soft);
  background: #202020;
}

.part-pixel-object--cdi .part-pixel-detail--1 {
  left: 31px;
  top: 23px;

  width: 5px;
  height: 5px;

  background: var(--market-accent);
}

.part-pixel-object--cdi .part-pixel-detail--2 {
  left: 41px;
  top: 23px;

  width: 14px;
  height: 3px;

  background: var(--market-soft);
}

.part-pixel-object--cdi .part-pixel-detail--3 {
  left: 29px;
  bottom: 13px;

  width: 32px;
  height: 4px;

  background: var(--market-line-light);
}


/* WHEEL */

.part-pixel-object--wheel .part-pixel-main {
  left: 25px;
  top: 9px;

  width: 39px;
  height: 39px;

  border: 6px solid var(--market-soft);
  border-radius: 50%;
}

.part-pixel-object--wheel .part-pixel-detail--1 {
  left: 34px;
  top: 18px;

  width: 21px;
  height: 21px;

  border: 3px solid var(--market-line-light);
  border-radius: 50%;
}

.part-pixel-object--wheel .part-pixel-detail--2 {
  left: 44px;
  top: 29px;

  width: 3px;
  height: 17px;

  background: var(--market-accent);

  transform: rotate(45deg);
}

.part-pixel-object--wheel .part-pixel-detail--3 {
  left: 22px;
  bottom: 8px;

  width: 46px;
  height: 3px;

  background: var(--market-black);
}


/* CAM */

.part-pixel-object--cam .part-pixel-main {
  left: 19px;
  top: 25px;

  width: 51px;
  height: 14px;

  background: var(--market-soft);
}

.part-pixel-object--cam .part-pixel-detail--1 {
  left: 26px;
  top: 12px;

  width: 9px;
  height: 13px;

  background: var(--market-soft);

  transform: rotate(45deg);
}

.part-pixel-object--cam .part-pixel-detail--2 {
  left: 43px;
  top: 12px;

  width: 9px;
  height: 13px;

  background: var(--market-soft);

  transform: rotate(45deg);
}

.part-pixel-object--cam .part-pixel-detail--3 {
  left: 35px;
  top: 29px;

  width: 9px;
  height: 7px;

  background: var(--market-accent);
}


/* FILTER */

.part-pixel-object--filter .part-pixel-main {
  left: 21px;
  top: 18px;

  width: 47px;
  height: 31px;

  border: 4px solid var(--market-soft);

  clip-path: polygon(
    0 0,
    100% 0,
    82% 100%,
    18% 100%
  );

  background: #272727;
}

.part-pixel-object--filter .part-pixel-detail--1 {
  left: 29px;
  top: 25px;

  width: 6px;
  height: 15px;

  background: var(--market-line-light);
}

.part-pixel-object--filter .part-pixel-detail--2 {
  left: 40px;
  top: 25px;

  width: 6px;
  height: 15px;

  background: var(--market-line-light);
}

.part-pixel-object--filter .part-pixel-detail--3 {
  left: 51px;
  top: 25px;

  width: 6px;
  height: 15px;

  background: var(--market-accent);
}


/* SHOCK */

.part-pixel-object--shock .part-pixel-main {
  left: 29px;
  top: 12px;

  width: 10px;
  height: 50px;

  border: 3px solid var(--market-soft);
  background: var(--market-accent);
}

.part-pixel-object--shock .part-pixel-detail--1 {
  left: 45px;
  top: 11px;

  width: 17px;
  height: 17px;

  border: 3px solid var(--market-soft);
  border-radius: 50%;
}

.part-pixel-object--shock .part-pixel-detail--2 {
  left: 45px;
  top: 33px;

  width: 17px;
  height: 17px;

  border: 3px solid var(--market-line-light);
  border-radius: 50%;
}

.part-pixel-object--shock .part-pixel-detail--3 {
  left: 19px;
  bottom: 7px;

  width: 43px;
  height: 5px;

  background: var(--market-black);
}

.part-info {
  padding: 13px;
}

.part-info-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;

  gap: 9px;
}

.part-category {
  color: var(--market-dim);

  font-family: var(--font-display);
  font-size: .44rem;
  font-weight: 900;

  text-transform: uppercase;
}

.part-info h3 {
  margin-top: 5px;

  color: var(--market-white);

  font-family: var(--font-display);
  font-size: .88rem;
  font-weight: 900;

  line-height: 1;
}

.part-condition {
  padding: 4px 5px;

  color: var(--market-muted);

  border: 1px solid var(--market-line);

  font-family: var(--font-display);
  font-size: .39rem;
  font-weight: 900;
}

.part-info p {
  margin-top: 7px;

  color: var(--market-muted);

  font-size: .61rem;
}

.part-bottom {
  margin-top: auto;

  display: flex;
  align-items: flex-end;
  justify-content: space-between;

  gap: 10px;

  padding: 10px 13px;

  border-top: 1px solid var(--market-line);
}

.part-price,
.part-stock-box {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.part-bottom span {
  color: var(--market-dim);

  font-family: var(--font-display);
  font-size: .4rem;
  font-weight: 900;
}

.part-bottom strong {
  color: var(--market-white);

  font-family: var(--font-display);
  font-size: .84rem;
  font-weight: 900;
}

.part-stock-box {
  text-align: right;
}

.part-stock-box strong {
  color: var(--market-accent);
}

.part-button {
  min-height: 35px;

  display: grid;

  grid-template-columns: 20px 1fr 15px;

  align-items: center;

  gap: 7px;

  margin: 0 10px 10px;

  padding: 0 9px;

  border: 2px solid var(--market-line-light);

  color: var(--market-white);

  background: var(--market-panel-2);

  font-family: var(--font-display);
  font-size: .43rem;
  font-weight: 900;

  text-decoration: none;
  text-transform: uppercase;
}

.part-button:hover {
  color: var(--market-accent);
  border-color: var(--market-accent-dark);
}


/* =========================================================
   SALVAGE
   ========================================================= */

.salvage {
  display: grid;

  grid-template-columns:
    300px
    minmax(0,1fr);

  overflow: hidden;

  background: var(--market-panel);

  border: 3px solid var(--market-black);

  box-shadow:
    7px 7px 0 var(--market-black);
}

.salvage-visual {
  min-height: 365px;

  position: relative;

  display: grid;
  place-items: center;

  overflow: hidden;

  border-right: 2px solid var(--market-line);

  background:
    repeating-linear-gradient(
      135deg,
      #222222 0 9px,
      #191919 9px 18px
    );
}

.salvage-visual-grid {
  position: absolute;
  inset: 0;

  opacity: .18;

  background:
    linear-gradient(
      transparent 95%,
      #fff 95%
    ),
    linear-gradient(
      90deg,
      transparent 95%,
      #fff 95%
    );

  background-size: 20px 20px;
}

.salvage-code {
  position: absolute;

  top: 12px;
  left: 12px;

  color: rgba(241,241,235,.35);

  font-family: var(--font-display);
  font-size: .44rem;
  font-weight: 900;
}

.salvage-motor {
  position: relative;
  z-index: 2;

  opacity: .38;

  transform:
    rotate(-4deg)
    scale(1.28);

  image-rendering: pixelated;

  filter:
    grayscale(1)
    drop-shadow(4px 4px 0 var(--market-black));
}

.salvage-stamp {
  position: absolute;

  top: 43px;
  right: 20px;

  padding: 5px 7px;

  color: var(--market-white);

  background: var(--market-danger);

  border: 2px solid var(--market-black);

  font-family: var(--font-display);
  font-size: .45rem;
  font-weight: 900;

  transform: rotate(-4deg);

  z-index: 4;
}

.salvage-icon-label {
  position: absolute;

  left: 13px;
  bottom: 39px;

  display: flex;
  align-items: center;
  gap: 7px;

  z-index: 4;

  color: rgba(241,241,235,.48);

  font-family: var(--font-display);
  font-size: .4rem;
  font-weight: 900;

  text-transform: uppercase;
}

.salvage-bottom {
  position: absolute;

  bottom: 12px;
  left: 12px;

  color: rgba(241,241,235,.32);

  font-family: var(--font-display);
  font-size: .44rem;
  font-weight: 900;
}

.salvage-content {
  min-width: 0;
  padding: 22px;
}

.salvage-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;

  gap: 15px;

  padding-bottom: 15px;

  border-bottom: 1px solid var(--market-line);
}

.mini-label-icon--danger {
  color: var(--market-danger);
  border-color: rgba(198,90,81,.45);
}

.salvage-heading h2 {
  margin-top: 6px;

  color: var(--market-white);

  font-family: var(--font-display);
  font-size: var(--text-2xl);
  font-weight: 900;

  line-height: .95;

  text-transform: uppercase;
}

.salvage-type {
  display: block;

  margin-top: 5px;

  color: var(--market-dim);

  font-size: .53rem;

  text-transform: uppercase;
}

.salvage-condition {
  padding: 5px 7px;

  color: var(--market-danger);

  border: 1px solid rgba(198,90,81,.42);

  font-family: var(--font-display);
  font-size: .44rem;
  font-weight: 900;

  white-space: nowrap;
}

.salvage-description {
  margin-top: 15px;

  color: var(--market-muted);

  font-size: var(--text-sm);

  line-height: 1.6;
}

.salvage-warning {
  margin-top: 15px;

  display: grid;

  grid-template-columns: 38px minmax(0,1fr);

  align-items: center;

  gap: 10px;

  padding: 11px;

  background: #151010;

  border-left: 4px solid var(--market-danger);
}

.warning-icon {
  width: 28px;
  height: 28px;

  display: grid;
  place-items: center;

  border: 2px solid var(--market-danger);

  color: var(--market-danger);

  font-family: var(--font-display);
  font-size: 1rem;
  font-weight: 900;
}

.salvage-warning strong {
  display: block;

  color: var(--market-danger);

  font-family: var(--font-display);
  font-size: .54rem;
  font-weight: 900;

  text-transform: uppercase;
}

.salvage-warning span {
  display: block;

  margin-top: 4px;

  color: var(--market-muted);

  font-size: .7rem;

  line-height: 1.5;
}

.salvage-specs {
  display: grid;

  grid-template-columns:
    repeat(5,minmax(0,1fr));

  gap: 6px;

  margin-top: 15px;
}

.salvage-specs > div {
  padding: 9px;

  background: var(--market-black-2);

  border: 1px solid var(--market-line);
}

.salvage-specs span {
  color: var(--market-dim);

  font-family: var(--font-display);
  font-size: .42rem;
  font-weight: 900;
}

.salvage-specs strong {
  display: block;

  margin-top: 4px;

  color: var(--market-white);

  font-family: var(--font-display);
  font-size: .8rem;
  font-weight: 900;
}

.salvage-footer {
  display: flex;

  align-items: flex-end;
  justify-content: space-between;

  gap: 15px;

  margin-top: 17px;
  padding-top: 14px;

  border-top: 1px solid var(--market-line);
}

.salvage-price {
  display: flex;
  flex-direction: column;
  gap: 5px;
}

.salvage-price span {
  color: var(--market-dim);

  font-family: var(--font-display);
  font-size: .44rem;
  font-weight: 900;
}

.salvage-price strong {
  color: var(--market-white);

  font-family: var(--font-display);
  font-size: 1.2rem;
  font-weight: 900;
}


/* =========================================================
   MARKET NOTES
   ========================================================= */

.market-notes {
  border-top: 2px solid var(--market-line);
}

.market-note {
  min-height: 102px;

  display: grid;

  grid-template-columns:
    42px
    80px
    minmax(0,1fr)
    25px;

  align-items: center;

  gap: 13px;

  padding: 12px 14px;

  border-bottom: 2px solid var(--market-line);

  background: var(--market-panel);
}

.market-note:nth-child(2) {
  background: var(--market-panel-2);
}

.market-note:hover {
  background: var(--market-panel-3);
}

.note-icon-shell {
  width: 35px;
  height: 35px;

  display: grid;
  place-items: center;

  border: 1px solid var(--market-line-light);

  color: var(--market-accent);

  background: var(--market-black-2);
}

.note-label {
  color: var(--market-dim);

  font-family: var(--font-display);
  font-size: .46rem;
  font-weight: 900;
}

.note-content {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.note-content h3 {
  color: var(--market-white);

  font-family: var(--font-display);
  font-size: .9rem;
  font-weight: 900;

  line-height: 1;

  text-transform: uppercase;
}

.note-content p {
  max-width: 720px;

  color: var(--market-muted);

  font-size: .69rem;

  line-height: 1.5;
}

.note-arrow {
  color: var(--market-accent);

  font-family: var(--font-display);
  font-size: 1rem;
  font-weight: 900;

  text-align: right;
}


/* =========================================================
   TRANSACTIONS
   ========================================================= */

.transactions {
  overflow: hidden;

  border-top: 2px solid var(--market-line);
  border-left: 2px solid var(--market-line);

  background: var(--market-panel);
}

.transaction-header,
.transaction-row {
  display: grid;

  grid-template-columns:
    60px
    minmax(0,1fr)
    110px
    180px;

  align-items: center;

  gap: 12px;

  padding: 0 13px;
}

.transaction-header {
  min-height: 34px;

  color: var(--market-dim);

  font-family: var(--font-display);
  font-size: .42rem;
  font-weight: 900;

  border-bottom: 2px solid var(--market-line);

  background: var(--market-black-2);
}

.transaction-row {
  min-height: 66px;

  border-bottom: 1px solid var(--market-line);
}

.transaction-row:last-child {
  border-bottom: 0;
}

.transaction-row:hover {
  background: var(--market-panel-2);
}

.transaction-number {
  color: var(--market-dim);

  font-family: var(--font-display);
  font-size: .5rem;
  font-weight: 900;
}

.transaction-action {
  min-width: 0;

  display: flex;
  align-items: center;
  gap: 10px;
}

.transaction-icon-shell {
  width: 28px;
  height: 28px;

  flex: 0 0 auto;

  display: grid;
  place-items: center;

  border: 1px solid var(--market-line-light);

  color: var(--market-soft);
}

.transaction-action-copy {
  min-width: 0;

  display: flex;
  flex-direction: column;
  gap: 3px;
}

.transaction-action strong {
  color: var(--market-white);

  font-family: var(--font-display);
  font-size: .63rem;
  font-weight: 900;
}

.transaction-action span {
  color: var(--market-muted);

  font-size: .52rem;
}

.transaction-type {
  color: var(--market-muted);

  font-family: var(--font-display);
  font-size: .48rem;
  font-weight: 900;

  text-transform: uppercase;
}

.transaction-value {
  color: var(--market-white);

  font-family: var(--font-display);
  font-size: .5rem;
  font-weight: 900;

  text-transform: uppercase;

  text-align: right;
}

.transaction-value--positive {
  color: var(--market-accent);
}


/* =========================================================
   MARKET RULE
   ========================================================= */

.market-rule {
  display: grid;

  grid-template-columns:
    70px
    minmax(0,1fr);

  gap: 20px;

  padding: 21px;

  background: #171717;

  border: 2px solid var(--market-line);

  box-shadow:
    6px 6px 0 var(--market-black);
}

.market-rule-symbol {
  width: 62px;
  height: 62px;

  display: grid;
  place-items: center;

  background: var(--market-accent);

  border: 3px solid var(--market-black);

  box-shadow:
    4px 4px 0 var(--market-black);

  color: var(--market-black);
}

.market-rule-content h2 {
  max-width: 760px;

  margin-top: 5px;

  color: var(--market-white);

  font-family: var(--font-display);
  font-size: var(--text-2xl);
  font-weight: 900;

  line-height: .95;

  text-transform: uppercase;
}

.market-rule-content p {
  max-width: 800px;

  margin-top: 9px;

  color: var(--market-muted);

  font-size: var(--text-sm);

  line-height: 1.6;
}


/* =========================================================
   PIXEL MOTOR
   ========================================================= */

.pixel-motor {
  width: 190px;
  height: 108px;

  position: relative;

  color: var(--market-white);
}

.pixel-motor span {
  position: absolute;
  display: block;
}

.pixel-motor__wheel {
  width: 42px;
  height: 42px;

  bottom: 6px;

  border: 6px solid var(--market-black);

  background: transparent;

  box-shadow:
    inset 0 0 0 4px var(--market-soft);
}

.pixel-motor__wheel::after {
  content: "";

  position: absolute;

  left: 12px;
  top: 12px;

  width: 6px;
  height: 6px;

  background: var(--market-black);
}

.pixel-motor__wheel--rear {
  left: 17px;
}

.pixel-motor__wheel--front {
  right: 17px;
}

.pixel-motor__body {
  left: 41px;
  top: 43px;

  width: 93px;
  height: 19px;

  background: var(--market-accent);

  clip-path: polygon(
    0 30%,
    18% 30%,
    28% 0,
    55% 0,
    67% 30%,
    100% 30%,
    100% 100%,
    0 100%
  );
}

.pixel-motor__tank {
  left: 73px;
  top: 27px;

  width: 38px;
  height: 18px;

  background: var(--market-white);

  clip-path: polygon(
    0 0,
    76% 0,
    100% 36%,
    82% 100%,
    18% 100%
  );
}

.pixel-motor__seat {
  left: 52px;
  top: 24px;

  width: 28px;
  height: 9px;

  background: var(--market-black);
}

.pixel-motor__frame {
  left: 66px;
  top: 44px;

  width: 44px;
  height: 33px;

  border-left: 5px solid var(--market-black);
  border-bottom: 5px solid var(--market-black);

  transform: skew(-17deg);
}

.pixel-motor__engine {
  left: 76px;
  top: 49px;

  width: 28px;
  height: 22px;

  background: var(--market-line-light);

  border: 3px solid var(--market-black);
}

.pixel-motor__engine::after {
  content: "";

  position: absolute;

  left: 6px;
  top: 6px;

  width: 10px;
  height: 4px;

  background: var(--market-soft);

  box-shadow:
    0 6px 0 var(--market-soft);
}

.pixel-motor__handle {
  right: 23px;
  top: 27px;

  width: 26px;
  height: 5px;

  background: var(--market-black);

  transform: rotate(-20deg);
}

.pixel-motor__handle::after {
  content: "";

  position: absolute;

  right: 2px;
  top: -6px;

  width: 5px;
  height: 14px;

  background: var(--market-black);
}


/* =========================================================
   FOOTER
   ========================================================= */

.market-footer {
  padding: 10px 0 8px;

  color: var(--cream-muted);

  font-size: var(--text-xs);

  text-transform: uppercase;
}

.market-footer .divider {
  margin-bottom: 12px;
}


/* =========================================================
   TABLET
   ========================================================= */

@media (max-width: 1100px) {

  .market-header-content {
    grid-template-columns:
      minmax(0,1fr)
      200px;
  }

  .status-grid {
    grid-template-columns:
      repeat(2,1fr);
  }

  .market-tab-info [data-tab-panel] {
    grid-template-columns:
      90px
      160px
      minmax(0,1fr);
  }

  .featured-project {
    grid-template-columns: 1fr;
  }

  .featured-visual {
    min-height: 300px;

    border-right: 0;
    border-bottom: 2px solid var(--market-line);
  }

  .motor-market-grid {
    grid-template-columns:
      repeat(2,minmax(0,1fr));
  }

  .parts-grid {
    grid-template-columns:
      repeat(2,minmax(0,1fr));
  }

  .salvage {
    grid-template-columns:
      220px
      minmax(0,1fr);
  }

  .salvage-specs {
    grid-template-columns:
      repeat(3,minmax(0,1fr));
  }

  .transaction-header,
  .transaction-row {
    grid-template-columns:
      50px
      minmax(0,1fr)
      85px
      140px;
  }

}


/* =========================================================
   MOBILE
   ========================================================= */

@media (max-width: 760px) {

  .market-section {
    margin-top: 32px;
  }

  .market-header-bar {
    grid-template-columns:
      1fr
      auto;
  }

  .header-center {
    display: none;
  }

  .market-header-content {
    grid-template-columns: 1fr;

    min-height: 0;

    padding: 23px 16px;
  }

  .market-title-area h1 {
    font-size:
      clamp(3.7rem,17vw,6rem);
  }

  .market-title-area p {
    font-size: .76rem;
  }

  .market-header-footer {
    grid-template-columns:
      1fr
      auto;
  }

  .market-header-footer span:nth-child(2) {
    display: none;
  }

  .status-grid {
    grid-template-columns:
      repeat(2,1fr);
  }

  .market-tabs {
    grid-template-columns:
      repeat(2,1fr);
  }

  .market-tab-info {
    min-height: 110px;
  }

  .market-tab-info [data-tab-panel] {
    grid-template-columns: 1fr;
    gap: 4px;
  }

  .market-tab-info p {
    font-size: .65rem;
  }

  .featured-content {
    padding: 17px;
  }

  .featured-heading {
    flex-direction: column;
  }

  .featured-stat-grid {
    grid-template-columns:
      repeat(2,1fr);
  }

  .featured-finance {
    align-items: flex-start;

    flex-direction: column;
  }

  .build-score-box {
    text-align: left;
  }

  .featured-actions {
    flex-direction: column;
  }

  .motor-market-grid {
    grid-template-columns: 1fr;
  }

  .motor-card-art {
    min-height: 225px;
  }

  .parts-grid {
    grid-template-columns: 1fr;
  }

  .salvage {
    grid-template-columns: 1fr;
  }

  .salvage-visual {
    min-height: 260px;

    border-right: 0;
    border-bottom: 2px solid var(--market-line);
