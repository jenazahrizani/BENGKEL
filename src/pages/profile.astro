---
import Layout from "../components/Layout.astro";
import "../styles/global.css";
import Button from "../components/Button.astro";
import Navigation from "../components/Navigation.astro";

const profile = {
  garageName: "NUSA GARAGE",
  ownerName: "BIMO",
  reputation: 24,
  reputationTier: "LOCAL NAME",
  garageLevel: 1,
  founded: "DAY 18",
};

const careerStats = [
  {
    label: "MOTOR",
    value: "12",
    detail: "TOTAL HANDLED",
    icon: "motorcycle",
  },
  {
    label: "BUILD",
    value: "08",
    detail: "PROJECT COMPLETE",
    icon: "wrench",
  },
  {
    label: "RACE",
    value: "07",
    detail: "TOTAL START",
    icon: "flag",
  },
  {
    label: "WIN",
    value: "02",
    detail: "CAREER WIN",
    icon: "trophy",
  },
];

const reputationMilestones = [
  {
    tier: "UNKNOWN",
    required: 0,
    reached: true,
  },
  {
    tier: "LOCAL NAME",
    required: 10,
    reached: true,
  },
  {
    tier: "ESTABLISHED",
    required: 35,
    reached: false,
  },
  {
    tier: "KNOWN GARAGE",
    required: 60,
    reached: false,
  },
  {
    tier: "CITY NAME",
    required: 100,
    reached: false,
  },
  {
    tier: "REGIONAL",
    required: 150,
    reached: false,
  },
  {
    tier: "LEGENDARY",
    required: 250,
    reached: false,
  },
];

const mastery = [
  {
    level: "STYLE / 01",
    title: "BUILDER",
    description:
      "Fokus pada meracik motor, upgrade komponen, tuning, dan membangun unit dengan karakter yang kuat.",
    value: 68,
    icon: "wrench",
  },
  {
    level: "STYLE / 02",
    title: "TRADER",
    description:
      "Mencari unit murah, membaca peluang market, membeli project, lalu menjual dengan margin yang sehat.",
    value: 54,
    icon: "search",
  },
  {
    level: "STYLE / 03",
    title: "WORKSHOP",
    description:
      "Mengembangkan reputasi melalui order pelanggan, service, repair, dan pekerjaan rutin bengkel.",
    value: 76,
    icon: "toolbox",
  },
  {
    level: "STYLE / 04",
    title: "RACER",
    description:
      "Mengejar catatan waktu, memilih event, mengatur risk, dan membangun kombinasi motor-joki yang cocok.",
    value: 42,
    icon: "flag",
  },
];

const records = [
  {
    label: "BEST TIME",
    value: "08.31",
    suffix: "UNDER 125",
    icon: "timer",
  },
  {
    label: "HIGHEST SALE",
    value: "24.5M",
    suffix: "MOTOR VALUE",
    icon: "coin",
  },
  {
    label: "BEST BUILD",
    value: "82",
    suffix: "BUILD SCORE",
    icon: "wrench",
  },
  {
    label: "LONGEST STREAK",
    value: "05",
    suffix: "JOB STREAK",
    icon: "bolt",
  },
  {
    label: "MOST EXPENSIVE",
    value: "31M",
    suffix: "UNIT HANDLED",
    icon: "motorcycle",
  },
  {
    label: "RACE WINS",
    value: "02",
    suffix: "CAREER WIN",
    icon: "trophy",
  },
];

const hallOfFame = [
  {
    title: "NUSA 125 / STREET BUILD",
    category: "MOTOR",
    detail: "BEST BUILD",
    value: "82 SCORE",
  },
  {
    title: "ABIANSEMAL NIGHT RUN",
    category: "RACE",
    detail: "BEST TIME",
    value: "08.31",
  },
  {
    title: "FIRST 10M SALE",
    category: "MARKET",
    detail: "FIRST MAJOR SALE",
    value: "10.2M",
  },
  {
    title: "FIVE JOB STREAK",
    category: "WORKSHOP",
    detail: "ORDER CHAIN",
    value: "05 JOB",
  },
];

const history = [
  {
    period: "DAY 18",
    title: "MENYELESAIKAN ABIANSEMAL NIGHT RUN",
    detail: "Bimo membawa NUSA 125 finis pertama di kelas UNDER 125.",
    value: "+350K",
  },
  {
    period: "DAY 17",
    title: "STREET BUILD SELESAI",
    detail: "Build score NUSA 125 naik ke angka 82 setelah tuning terakhir.",
    value: "+82 BUILD",
  },
  {
    period: "DAY 15",
    title: "ORDER CUSTOMER KE-08",
    detail: "Service rutin dan brake setup selesai tanpa komplain.",
    value: "+450K",
  },
  {
    period: "DAY 13",
    title: "UNIT PERTAMA TERJUAL",
    detail: "Project lama berhasil dilepas setelah market refresh.",
    value: "+10.2M",
  },
  {
    period: "DAY 01",
    title: "BENGKEL DIBUKA",
    detail: "Garage kecil dengan satu bench dan dua slot motor dimulai.",
    value: "LEVEL 01",
  },
];

const identityTags = [
  {
    label: "BUILDER",
    icon: "wrench",
    accent: true,
  },
  {
    label: "TRADER",
    icon: "search",
  },
  {
    label: "WORKSHOP",
    icon: "toolbox",
  },
  {
    label: "RACER",
    icon: "flag",
  },
];

const saveStatus = {
  version: "0.1",
  state: "LOCAL SAVE",
  slot: "SAVE_01",
  lastSave: "JUST NOW",
};
---

<Layout
  title="BENGKEL — PROFILE"
  description="Catatan perjalanan garage: reputasi, mastery, records, milestone, dan sejarah."
>
  <div class="page profile-page">
    <div class="game-layout">

      <Navigation active="profile" />

      <main class="main">

        <div class="main-inner profile-main">

          <!-- =====================================================
               HEADER
          ===================================================== -->

          <header class="profile-header">

            <div class="profile-header-top">

              <div class="profile-head-left">
                <span class="header-led"></span>
                <span>PROFILE_01</span>
              </div>

              <span class="profile-head-center">
                GARAGE / IDENTITY / RECORDS
              </span>

              <div class="profile-head-right">
                <span class="pixel-icon pixel-icon--person pixel-icon--tiny"></span>
                OWNER ONLINE
              </div>

            </div>


            <div class="profile-header-body">

              <div class="profile-header-copy">

                <div class="profile-kicker-row">

                  <span class="profile-title-icon">
                    <span class="pixel-icon pixel-icon--person pixel-icon--small"></span>
                  </span>

                  <span class="header-kicker">
                    GARAGE OWNER PROFILE
                  </span>

                </div>

                <h1>
                  PROFILE
                </h1>

                <div class="header-rule"></div>

                <p>
                  Catatan perjalanan garage:
                  reputasi, mastery, personal records,
                  milestone, dan sejarah yang kamu bangun
                  dari motor pertama sampai lintasan.
                </p>

              </div>


              <div class="profile-header-panel">

                <div class="owner-box">

                  <div class="owner-mark">
                    BM
                  </div>

                  <div class="owner-copy">

                    <span>
                      GARAGE OWNER
                    </span>

                    <strong>
                      {profile.ownerName}
                    </strong>

                    <small>
                      {profile.garageName}
                    </small>

                  </div>

                  <div class="owner-level">

                    <span>
                      LVL
                    </span>

                    <strong>
                      {String(profile.garageLevel).padStart(2, "0")}
                    </strong>

                  </div>

                </div>


                <div class="header-capacity">

                  <div>
                    <span>REP</span>
                    <strong>{profile.reputation}</strong>
                  </div>

                  <div>
                    <span>RACE</span>
                    <strong>07</strong>
                  </div>

                  <div>
                    <span>WIN</span>
                    <strong>02</strong>
                  </div>

                </div>


                <div class="header-actions">

                  <Button
                    href="/garage"
                    variant="primary"
                  >
                    OPEN GARAGE
                  </Button>

                  <Button href="/race">
                    RACE CONTROL
                  </Button>

                </div>

              </div>

            </div>


            <div class="profile-header-bottom">

              <span>
                PROFILE / MASTERY / LEGACY
              </span>

              <span>
                {profile.reputationTier} / {profile.reputation} REP
              </span>

              <span class="header-system">
                <i></i>
                PROFILE SYSTEM READY
              </span>

            </div>

          </header>



          <!-- =====================================================
               IDENTITY
          ===================================================== -->

          <section class="profile-section">

            <div class="section-header">

              <div class="section-heading">

                <span class="section-marker section-marker--accent"></span>

                <div>
                  <span class="section-kicker">
                    GARAGE IDENTITY
                  </span>

                  <h2>
                    SIAPA KAMU
                  </h2>
                </div>

              </div>

              <span class="section-code">
                OWNER / 01
              </span>

            </div>


            <article class="identity-card">

              <div class="identity-emblem">

                <div class="identity-emblem-inner">

                  <span>
                    BM
                  </span>

                  <strong>
                    01
                  </strong>

                </div>

              </div>


              <div class="identity-main">

                <div class="identity-kicker">
                  GARAGE OWNER
                </div>

                <h3>
                  {profile.garageName}
                </h3>

                <strong class="identity-owner">
                  {profile.ownerName}
                </strong>

                <p>
                  Dealer ketika mencari peluang.
                  Builder ketika melihat potensi.
                  Workshop ketika pelanggan datang.
                  Racer ketika waktunya turun lintasan.
                </p>


                <div class="identity-tags">

                  {
                    identityTags.map((tag) => (
                      <span
                        class:list={[
                          "identity-tag",
                          tag.accent &&
                            "identity-tag--accent",
                        ]}
                      >

                        <span class="identity-tag-icon">

                          <span
                            class:list={[
                              "pixel-icon",
                              `pixel-icon--${tag.icon}`,
                              "pixel-icon--tiny",
                            ]}
                          ></span>

                        </span>

                        {tag.label}

                      </span>
                    ))
                  }

                </div>

              </div>


              <div class="identity-reputation">

                <span>
                  REPUTATION
                </span>

                <strong>
                  {profile.reputation}
                </strong>

                <small>
                  {profile.reputationTier}
                </small>

                <div class="identity-rep-line">

                  {
                    Array.from({ length: 8 }).map(
                      (_, index) => (
                        <i
                          class:active={
                            index <
                            Math.ceil(
                              profile.reputation /
                                35 *
                                8
                            )
                          }
                        ></i>
                      )
                    )
                  }

                </div>

              </div>

            </article>

          </section>



          <!-- =====================================================
               CAREER STATUS
          ===================================================== -->

          <section class="profile-section">

            <div class="section-header">

              <div class="section-heading">

                <span class="section-marker"></span>

                <div>
                  <span class="section-kicker">
                    CAREER OVERVIEW
                  </span>

                  <h2>
                    CATATAN GARASI
                  </h2>
                </div>

              </div>

              <span class="section-code">
                LIVE / 04
              </span>

            </div>


            <div class="career-grid">

              {
                careerStats.map((stat, index) => (
                  <article
                    class:list={[
                      "career-card",
                      index === 0 &&
                        "career-card--active",
                    ]}
                  >

                    <div class="career-card-head">

                      <div class="career-ident">

                        <span class="career-icon">

                          <span
                            class:list={[
                              "pixel-icon",
                              `pixel-icon--${stat.icon}`,
                              "pixel-icon--small",
                            ]}
                          ></span>

                        </span>

                        <span>
                          {stat.label}
                        </span>

                      </div>

                      <span>
                        0{index + 1}
                      </span>

                    </div>


                    <strong class="career-value">
                      {stat.value}
                    </strong>


                    <div class="career-footer">

                      <div class="segment-bar">

                        {
                          Array.from({
                            length: 8,
                          }).map(
                            (_, segmentIndex) => (
                              <i
                                class:segment-active={
                                  segmentIndex <
                                  index + 4
                                }
                              ></i>
                            )
                          )
                        }

                      </div>

                      <span>
                        {stat.detail}
                      </span>

                    </div>

                  </article>
                ))
              }

            </div>

          </section>



          <!-- =====================================================
               REPUTATION
          ===================================================== -->

          <section class="profile-section">

            <div class="section-header">

              <div class="section-heading">

                <span class="section-marker section-marker--accent"></span>

                <div>
                  <span class="section-kicker">
                    REPUTATION SYSTEM
                  </span>

                  <h2>
                    NAMA DI DUNIA GARASI
                  </h2>
                </div>

              </div>

              <span class="section-link">
                {profile.reputation} REP
              </span>

            </div>


            <article class="reputation-panel">

              <div class="reputation-main">

                <div class="reputation-current">

                  <span class="section-kicker">
                    CURRENT TIER
                  </span>

                  <strong>
                    {profile.reputationTier}
                  </strong>

                  <p>
                    Reputasi tumbuh dari pekerjaan pelanggan,
                    build motor, transaksi market, kemenangan,
                    dan konsistensi garage.
                  </p>

                </div>


                <div class="reputation-next">

                  <span>
                    NEXT TIER
                  </span>

                  <strong>
                    ESTABLISHED
                  </strong>

                  <small>
                    35 REP REQUIRED
                  </small>

                </div>

              </div>


              <div class="reputation-progress">

                <div class="progress-head">

                  <span>
                    PROGRESS TO NEXT TIER
                  </span>

                  <strong>
                    24 / 35 REP
                  </strong>

                </div>

                <div class="progress-track">

                  <i
                    style={`width:${(profile.reputation / 35) * 100}%`}
                  ></i>

                </div>

              </div>


              <div class="milestone-grid">

                {
                  reputationMilestones.map(
                    (milestone, index) => (
                      <div
                        class:list={[
                          "milestone",
                          milestone.reached &&
                            "milestone--reached",
                        ]}
                      >

                        <div class="milestone-top">

                          <span>
                            {String(index + 1).padStart(
                              2,
                              "0"
                            )}
                          </span>

                          <span>
                            {milestone.required}
                          </span>

                        </div>


                        <div class="milestone-mark">

                          {
                            milestone.reached
                              ? "✓"
                              : "—"
                          }

                        </div>


                        <strong>
                          {milestone.tier}
                        </strong>

                        <small>
                          {milestone.required} REP
                        </small>

                      </div>
                    )
                  )
                }

              </div>

            </article>

          </section>



          <!-- =====================================================
               MASTERY
          ===================================================== -->

          <section class="profile-section">

            <div class="section-header">

              <div class="section-heading">

                <span class="section-marker"></span>

                <div>
                  <span class="section-kicker">
                    GARAGE MASTERY
                  </span>

                  <h2>
                    GAYA BERMAIN
                  </h2>
                </div>

              </div>

              <span class="section-code">
                FOUR PATHS
              </span>

            </div>


            <div class="mastery-grid">

              {
                mastery.map((item, index) => (
                  <article class="mastery-card">

                    <div class="mastery-top">

                      <div class="mastery-index">
                        {item.level}
                      </div>

                      <span class="mastery-icon">

                        <span
                          class:list={[
                            "pixel-icon",
                            `pixel-icon--${item.icon}`,
                            "pixel-icon--small",
                          ]}
                        ></span>

                      </span>

                    </div>


                    <h3>
                      {item.title}
                    </h3>


                    <p>
                      {item.description}
                    </p>


                    <div class="mastery-progress">

                      <div class="mastery-progress-head">

                        <span>
                          MASTERY
                        </span>

                        <strong>
                          {item.value}%
                        </strong>

                      </div>

                      <div class="progress-track">

                        <i
                          style={`width:${item.value}%`}
                        ></i>

                      </div>

                    </div>


                    <div class="mastery-footer">

                      <span>
                        HISTORY / IDENTITY
                      </span>

                      <strong>
                        →
                      </strong>

                    </div>

                  </article>
                ))
              }

            </div>

          </section>



          <!-- =====================================================
               PERSONAL RECORDS
          ===================================================== -->

          <section class="profile-section">

            <div class="section-header">

              <div class="section-heading">

                <span class="section-marker section-marker--accent"></span>

                <div>
                  <span class="section-kicker">
                    PERSONAL RECORDS
                  </span>

                  <h2>
                    BEST OF GARAGE
                  </h2>
                </div>

              </div>

              <span class="section-code">
                RECORDS / 06
              </span>

            </div>


            <div class="records-grid">

              {
                records.map((record, index) => (
                  <article class="record-card">

                    <span class="record-number">
                      {String(index + 1).padStart(
                        2,
                        "0"
                      )}
                    </span>


                    <span class="record-icon">

                      <span
                        class:list={[
                          "pixel-icon",
                          `pixel-icon--${record.icon}`,
                          "pixel-icon--small",
                        ]}
                      ></span>

                    </span>


                    <span class="record-label">
                      {record.label}
                    </span>


                    <strong>
                      {record.value}
                    </strong>


                    <span class="record-suffix">
                      {record.suffix}
                    </span>

                  </article>
                ))
              }

            </div>

          </section>



          <!-- =====================================================
               HALL OF FAME
          ===================================================== -->

          <section class="profile-section">

            <div class="section-header">

              <div class="section-heading">

                <span class="section-marker"></span>

                <div>
                  <span class="section-kicker">
                    GARAGE LEGACY
                  </span>

                  <h2>
                    HALL OF FAME
                  </h2>
                </div>

              </div>

              <span class="section-code">
                {hallOfFame.length} ENTRIES
              </span>

            </div>


            <article class="legacy-panel">

              <div class="legacy-head">

                <div>
                  <span>
                    HISTORIC ENTRIES
                  </span>

                  <strong>
                    MOTOR & MOMENT
                  </strong>
                </div>

                <span>
                  LEGACY / 01
                </span>

              </div>


              <div class="legacy-list">

                {
                  hallOfFame.map((entry, index) => (
                    <div class="legacy-row">

                      <div class="legacy-index">
                        #{String(index + 1).padStart(
                          2,
                          "0"
                        )}
                      </div>


                      <div class="legacy-main">

                        <strong>
                          {entry.title}
                        </strong>

                        <span>
                          {entry.category}
                          {" / "}
                          {entry.detail}
                        </span>

                      </div>


                      <div class="legacy-value">
                        {entry.value}
                      </div>

                    </div>
                  ))
                }

              </div>


              <div class="legacy-footer">

                <div>

                  <span>
                    LEGACY PRINCIPLE
                  </span>

                  <strong>
                    MOTOR & JOKI BISA MENINGGALKAN SEJARAH
                  </strong>

                </div>

                <span class="legacy-arrow">
                  →
                </span>

              </div>

            </article>

          </section>



          <!-- =====================================================
               TIMELINE
          ===================================================== -->

          <section class="profile-section">

            <div class="section-header">

              <div class="section-heading">

                <span class="section-marker section-marker--accent"></span>

                <div>
                  <span class="section-kicker">
                    CAREER HISTORY
                  </span>

                  <h2>
                    GARAGE TIMELINE
                  </h2>
                </div>

              </div>

              <span class="section-code">
                LOG / {history.length}
              </span>

            </div>


            <article class="timeline-panel">

              <div class="timeline-head">

                <span>
                  RECENT EVENTS
                </span>

                <span class="timeline-live">
                  <i></i>
                  LIVE LOG
                </span>

              </div>


              <div class="timeline-list">

                {
                  history.map((item, index) => (
                    <div class="timeline-row">

                      <div class="timeline-period">
                        {item.period}
                      </div>


                      <div class="timeline-marker">

                        <i></i>

                      </div>


                      <div class="timeline-main">

                        <strong>
                          {item.title}
                        </strong>

                        <span>
                          {item.detail}
                        </span>

                      </div>


                      <div class="timeline-value">
                        {item.value}
                      </div>

                    </div>
                  ))
                }

              </div>

            </article>

          </section>



          <!-- =====================================================
               SAVE / SYSTEM
          ===================================================== -->

          <section class="profile-section">

            <div class="section-header">

              <div class="section-heading">

                <span class="section-marker"></span>

                <div>
                  <span class="section-kicker">
                    PROFILE SYSTEM
                  </span>

                  <h2>
                    SAVE & STATUS
                  </h2>
                </div>

              </div>

              <span class="section-code">
                SYSTEM / ONLINE
              </span>

            </div>


            <div class="system-grid">

              <article class="system-card system-card--save">

                <div class="system-card-head">

                  <div class="system-card-icon">
                    <span class="pixel-icon pixel-icon--save pixel-icon--small"></span>
                  </div>

                  <div>

                    <span>
                      SAVE SLOT
                    </span>

                    <strong>
                      {saveStatus.slot}
                    </strong>

                  </div>

                  <span class="system-live">
                    <i></i>
                    {saveStatus.state}
                  </span>

                </div>


                <div class="system-card-data">

                  <div>
                    <span>VERSION</span>
                    <strong>{saveStatus.version}</strong>
                  </div>

                  <div>
                    <span>LAST SAVE</span>
                    <strong>{saveStatus.lastSave}</strong>
                  </div>

                  <div>
                    <span>GARAGE</span>
                    <strong>{profile.garageName}</strong>
                  </div>

                </div>


                <Button
                  size="small"
                  variant="primary"
                >
                  SAVE STATUS
                </Button>

              </article>


              <article class="system-card">

                <div class="system-card-head">

                  <div class="system-card-icon">
                    <span class="pixel-icon pixel-icon--chart pixel-icon--small"></span>
                  </div>

                  <div>

                    <span>
                      PROFILE DATA
                    </span>

                    <strong>
                      LOCAL RECORD
                    </strong>

                  </div>

                </div>


                <p>
                  Semua record, reputation,
                  mastery, history, dan identitas
                  garage menggunakan sistem data
                  lokal pada versi awal game.
                </p>


                <a
                  href="/garage"
                  class="retro-button"
                >
                  BACK TO GARAGE →
                </a>

              </article>


              <article class="system-card">

                <div class="system-card-head">

                  <div class="system-card-icon">
                    <span class="pixel-icon pixel-icon--bolt pixel-icon--small"></span>
                  </div>

                  <div>

                    <span>
                      GAME BUILD
                    </span>

                    <strong>
                      CURRENT VERSION
                    </strong>

                  </div>

                </div>


                <div class="version-display">
                  v{saveStatus.version}
                </div>


                <div class="version-detail">
